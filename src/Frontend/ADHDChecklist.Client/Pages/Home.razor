@page "/home"
@using ADHDChecklist.Client.Features.Dashboard.Services
@using ADHDChecklist.Client.Features.Dashboard.Components
@using ADHDChecklist.Client.Shared.Models
@using ADHDChecklist.Client.Features.Auth.Services
@using ADHDChecklist.Client.Features.Auth.Components
@using ADHDChecklist.Client.Features.Focus.Components
@using ADHDChecklist.Client.Shared.Components
@using ADHDChecklist.Client.Features.Habits.Components
@inject ITaskService TaskService
@inject ICategoryService CategoryService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject DragDropState _dragState
@attribute [Authorize]

<PageTitle>Dashboard - ADHD Checklist</PageTitle>

<div class="min-h-screen bg-gray-50">
    <!-- Top Nav -->
    <nav class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700 transition-all duration-300 @(_focusedTaskId.HasValue ? "blur-sm grayscale opacity-30 pointer-events-none" : "")">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-4">
                    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">📝 ADHD Checklist</h1>
                    @if (_currentUser?.IsPremium == true)
                    {
                        <span class="px-3 py-1 bg-gradient-to-r from-purple-500 to-primary-600 text-white text-xs rounded-full font-bold shadow-sm flex items-center gap-1">
                             <span>👑</span> PREMIUM
                        </span>
                    }
                    else
                    {
                        <button @onclick="ShowUpgradeModal" class="px-3 py-1 bg-gray-100 hover:bg-gray-200 text-gray-600 text-xs rounded-full font-bold transition-colors">
                            FREE
                        </button>
                    }
                </div>
                
                <div class="flex items-center gap-4">
                    <button @onclick="ShowProfileModal" class="text-sm text-gray-600 hover:text-primary-600 transition-colors flex items-center gap-2 group">
                        <span>Xin chào, <strong class="group-hover:text-primary-700">@_userName</strong></span>
                        <div class="w-6 h-6 rounded-full bg-primary-100 flex items-center justify-center text-xs font-bold text-primary-600 border border-primary-200">
                            @(!string.IsNullOrEmpty(_userName) ? _userName[0].ToString().ToUpper() : "U")
                        </div>
                    </button>
                    <button @onclick="HandleLogout" 
                            class="text-sm text-red-500 hover:text-red-700 font-bold uppercase text-[10px] border border-transparent hover:border-red-100 rounded px-2 py-1 transition-all">
                        Đăng xuất
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-full mx-auto px-3 py-4 h-screen flex flex-col overflow-hidden">
        <!-- Date Selector & Header -->
        <div class="mb-4 flex flex-col sm:flex-row items-center justify-between gap-4 flex-shrink-0 transition-all duration-300 @(_focusedTaskId.HasValue ? "blur-sm grayscale opacity-30 pointer-events-none" : "")">
            <div class="flex items-center gap-4">
                <button @onclick="PreviousDay" class="p-1.5 hover:bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg></button>
                <div class="text-center">
                    <h2 class="text-xl font-bold text-gray-900 dark:text-white leading-none">@_selectedDate.ToString("dd/MM/yyyy")</h2>
                    <p class="text-xs text-gray-500 font-medium">@GetVietnameseDayOfWeek(_selectedDate.DayOfWeek) @if(_selectedDate == DateOnly.FromDateTime(DateTime.Now)){<span class="text-primary-600 font-bold ml-1">(Hôm nay)</span>}</p>
                </div>
                <button @onclick="NextDay" class="p-1.5 hover:bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></button>
                <button @onclick="GoToToday" class="px-3 py-1.5 bg-primary-50 text-primary-700 rounded-lg text-xs font-bold hover:bg-primary-100 transition-colors">📅 Hôm nay</button>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="flex-1 flex justify-center items-center">
                <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-primary-600"></div>
            </div>
        }
        else
        {
            <!-- Main Content Area - 40/60 Split -->
            <div class="flex-col flex-1 flex gap-4 min-h-0">
                <!-- Overdue Banner -->
                @if (_overdueCount > 0 && _selectedDate == DateOnly.FromDateTime(DateTime.Now))
                {
                     <div class="bg-gradient-to-r from-orange-50 to-amber-50 p-3 rounded-xl border border-orange-100 flex items-center justify-between shadow-sm animate-fade-in mb-2 flex-shrink-0">
                        <div class="flex items-center gap-3">
                            <span class="bg-orange-100 p-2 rounded-lg text-orange-600">🕰️</span>
                            <div>
                                <p class="text-xs font-bold text-orange-800 uppercase tracking-wide">Clean up</p>
                                <p class="text-sm font-medium text-gray-700">Bạn có <span class="font-bold text-orange-600">@_overdueCount</span> công việc quá hạn.</p>
                            </div>
                        </div>
                        <button @onclick="HandleAutoAdjust" 
                                class="px-4 py-2 bg-white dark:bg-gray-800 text-orange-600 font-bold text-xs rounded-lg border border-orange-200 shadow-sm hover:shadow-md hover:scale-105 transition-all flex items-center gap-2">
                            <span>✨</span> Dời sang hôm nay
                            @if (_currentUser?.IsPremium != true) { <span class="opacity-50 text-[9px]">PREMIUM</span> }
                        </button>
                    </div>
                }

                <div class="flex-1 flex gap-4 min-h-0">
                
                <!-- Left Section: TIMELINE (30%) -->
                <div class="w-[30%] flex flex-col min-w-[300px] gap-4 min-h-0">
                    
                    <!-- Date Navigation (Floating) -->
                    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-2 flex items-center justify-between flex-shrink-0 @(_focusedTaskId.HasValue ? "blur-sm grayscale opacity-30 pointer-events-none" : "")">
                        <button class="p-2 hover:bg-gray-50 rounded-lg text-gray-500 transition-colors" @onclick="() => _selectedDate = _selectedDate.AddDays(-1)">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                        </button>
                        <div class="flex flex-col items-center">
                            <span class="text-lg font-black text-gray-800 leading-none">@_selectedDate.ToString("dd/MM/2026")</span>
                            <span class="text-[10px] font-bold text-primary-500 uppercase tracking-widest mt-0.5">
                                @if (_selectedDate == DateOnly.FromDateTime(DateTime.Now)) { <span class="bg-primary-50 px-2 rounded">Hôm nay</span> } 
                                else { <span>@_selectedDate.ToString("dddd")</span> }
                            </span>
                        </div>
                        <button class="p-2 hover:bg-gray-50 rounded-lg text-gray-500 transition-colors" @onclick="() => _selectedDate = _selectedDate.AddDays(1)">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </button>
                    </div>

                    <!-- Timeline Grid area -->
                    <div class="flex-1 min-h-0 bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden relative flex flex-col">
                        <div class="bg-gradient-to-r from-primary-600 to-primary-700 text-white p-3 flex justify-between items-center shadow-md z-10">
                            <div class="flex items-center gap-2">
                                <span class="text-lg">⏱️</span>
                                <h3 class="font-bold text-sm uppercase tracking-wider">Lịch trình</h3>
                            </div>
                            <span class="bg-white dark:bg-gray-800/20 px-2 py-0.5 rounded text-[11px] font-bold">@_scheduledTasks.Count Tasks</span>
                        </div>
                        <div class="flex-1 min-h-0">
                             <TimeBlocksGrid Tasks="@_scheduledTasks"
                                            _selectedDate="@_selectedDate"
                                            OnToggleComplete="ToggleTaskComplete"
                                            OnEdit="EditTask"
                                            OnDelete="DeleteTask"
                                            OnTaskDropped="HandleTaskTimeBlockDrop"
                                            OnTaskResized="HandleTaskResized"
                                            OnTaskClick="ShowTaskQuickView" 
                                            FocusedTaskId="@_focusedTaskId"
                                            IsPremium="@(_currentUser?.IsPremium == true)" />
                        </div>
                    </div>
                </div>

                <!-- Right Section: WORKSPACE (70%) -->
                <div class="w-[70%] flex flex-col gap-4 min-h-0 @(_focusedTaskId.HasValue ? "opacity-30 blur-sm grayscale pointer-events-none transition-all duration-500" : "transition-all duration-300")">
                    
                    <!-- Stats Header -->
                    <div class="flex items-center justify-between bg-white dark:bg-gray-800 rounded-xl p-2 px-4 shadow-sm border border-gray-200 dark:border-gray-700 flex-shrink-0">
                        <div class="flex items-center gap-6">
                            <div class="flex items-center gap-3">
                                <div class="relative w-10 h-10">
                                    <svg class="w-full h-full transform -rotate-90">
                                        <circle cx="20" cy="20" r="16" stroke="#f3f4f6" stroke-width="4" fill="none" />
                                        <circle cx="20" cy="20" r="16" stroke="#6366f1" stroke-width="4" fill="none" stroke-dasharray="100" stroke-dashoffset="@(100 - _completionRate)" />
                                    </svg>
                                    <span class="absolute inset-0 flex items-center justify-center text-[10px] font-bold text-primary-600">@_completionRate%</span>
                                </div>
                                <div>
                                    <p class="text-[10px] text-gray-400 font-bold uppercase">Tiến độ ngày</p>
                                    <p class="text-sm font-black text-gray-800">@_completedCount <span class="text-gray-400 font-normal">/ @_allTasks.Count xong</span></p>
                                </div>
                            </div>
                        </div>
                        <button @onclick="ShowCreateTaskModal" class="btn-premium flex items-center gap-2 shadow-primary-200 shadow-lg">
                            <span>➕</span> <span class="hidden sm:inline">VIỆC MỚI</span>
                        </button>
                    </div>

                    <!-- Habit Tracker -->
                    <div class="flex-shrink-0">
                        <HabitTracker IsPremium="@(_currentUser?.IsPremium == true)" 
                                      OnUpgradeClicked="ShowUpgradeModal" />
                    </div>

                    <!-- Workspace Grid (Inbox & Brain Dump/Categories) -->
                    <div class="flex-1 grid grid-cols-[30%_1fr] gap-4 min-h-0">
                        
                        <!-- Col 1: INBOX (Full Height) -->
                        <div class="flex flex-col bg-gray-50 rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden">
                            <div class="p-3 border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 flex justify-between items-center">
                                <h4 class="font-black text-xs text-gray-700 uppercase tracking-widest flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-orange-500"></span> Inbox
                                </h4>
                                <span class="text-[10px] bg-gray-100 px-2 py-0.5 rounded-full font-bold text-gray-600">@_inboxTasks.Count</span>
                            </div>
                            <div class="flex-1 overflow-y-auto custom-scrollbar p-2 space-y-2 transition-colors @(_dragState.DraggedTask != null ? "bg-primary-50/30" : "")"
                                 ondragover="event.preventDefault();"
                                 @ondrop="HandleInboxDropWrapper">
                                @if (_inboxTasks.Any()) {
                                    @foreach (var task in _inboxTasks) {
                                        <div class="bg-white dark:bg-gray-800 p-3 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-all cursor-grab active:cursor-grabbing group"
                                             draggable="true" @ondragstart="() => HandleDragStart(task)">
                                            <div class="flex justify-between items-start gap-2">
                                                <h5 class="text-sm font-bold text-gray-800 line-clamp-2">@task.Title</h5>
                                                @if(task.Priority > 1) { <span class="text-xs text-red-500 font-black">@string.Concat(Enumerable.Repeat("!", task.Priority-1))</span> }
                                            </div>
                                            <div class="flex items-center justify-between mt-2">
                                                <div class="flex items-center gap-2">
                                                    @if(!string.IsNullOrEmpty(task.CategoryName)) { <span class="text-[10px] px-1.5 py-0.5 bg-gray-100 rounded text-gray-600 font-medium">@task.CategoryName</span> }
                                                    <span class="text-[10px] text-gray-400 font-bold">@task.Duration m</span>
                                                </div>
                                                <div class="opacity-0 group-hover:opacity-100 flex gap-1 transition-opacity">
                                                    <button @onclick="() => EditTask(task.Id)" class="p-1 hover:bg-primary-50 text-primary-600 rounded"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg></button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                } else {
                                    <div class="h-full flex flex-col items-center justify-center text-gray-400 opacity-60">
                                        <span class="text-2xl mb-2">📥</span>
                                        <span class="text-xs font-medium">Trống</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Col 2: BRAIN DUMP & CATEGORIES -->
                        <div class="flex flex-col gap-4 min-h-0">
                            
                            <!-- Top: Free Tier Analytics -->
                            <div class="flex-1 bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden flex flex-col">
                                <div class="p-3 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                                    <h4 class="font-black text-xs text-gray-700 uppercase tracking-widest flex items-center gap-2">
                                        <span class="text-base">📊</span> Thống kê (Hôm nay)
                                    </h4>
                                    <span class="text-[9px] bg-primary-50 text-primary-600 px-2 py-0.5 rounded font-bold uppercase">Free Tier</span>
                                </div>
                                <div class="flex-1 p-4 flex flex-col gap-4 overflow-y-auto">
                                    <!-- Summary Row -->
                                    <div class="grid grid-cols-2 gap-3">
                                        <div class="bg-gray-50 rounded-lg p-3 text-center border border-gray-100">
                                            <span class="block text-2xl font-black text-gray-800">@_allTasks.Count</span>
                                            <span class="text-[10px] text-gray-500 font-bold uppercase">Tổng task</span>
                                        </div>
                                         <div class="bg-green-50 rounded-lg p-3 text-center border border-green-100">
                                            <span class="block text-2xl font-black text-green-600">@_completedCount</span>
                                            <span class="text-[10px] text-green-600/70 font-bold uppercase">Hoàn thành</span>
                                        </div>
                                    </div>

                                    <!-- Category Breakdown (Mini Chart) -->
                                    <div>
                                        <h5 class="text-[10px] font-bold text-gray-400 uppercase mb-2">Phân bổ danh mục</h5>
                                        <div class="space-y-2">
                                            @foreach(var cat in _categories.Take(3)) 
                                            {
                                                var count = _allTasks.Count(t => t.CategoryId == cat.Id);
                                                var percent = _allTasks.Count > 0 ? (double)count / _allTasks.Count * 100 : 0;
                                                if (count > 0) {
                                                    <div class="flex items-center gap-2 text-xs">
                                                        <span class="flex-1 truncate font-medium text-gray-600">@cat.Name</span>
                                                        <div class="w-24 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                                                            <div class="h-full rounded-full" style="width: @percent%; background-color: @cat.ColorHex"></div>
                                                        </div>
                                                        <span class="text-[10px] text-gray-400 w-4 text-right">@count</span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                    
                                    <!-- Upgrade Teaser -->
                                   <div class="mt-auto pt-4 text-center">
                                       <button class="text-[10px] font-bold text-primary-500 hover:text-primary-700 underline">Xem báo cáo chi tiết &rarr;</button>
                                   </div>
                                </div>
                            </div>

                            <!-- Bottom: Categories (Smaller) -->
                            <div class="h-[40%] bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden flex flex-col">
                                <div class="p-2 px-3 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                                     <h4 class="font-bold text-xs text-gray-500 uppercase">Danh mục</h4>
                                     <button @onclick="ShowCreateCategoryModal" class="text-[10px] bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 px-2 py-0.5 rounded hover:bg-gray-50 text-primary-600 font-bold">+</button>
                                </div>
                                <div class="flex-1 overflow-y-auto custom-scrollbar p-2">
                                    <div class="flex flex-wrap gap-2">
                                        @foreach(var cat in _categories) {
                                            <div class="flex items-center gap-2 p-1.5 pr-3 bg-white dark:bg-gray-800 border border-gray-100 rounded-lg shadow-sm hover:border-primary-100 transition-colors w-full sm:w-auto">
                                                <div class="w-6 h-6 rounded-md flex items-center justify-center text-xs text-white shadow-sm" style="background-color: @cat.ColorHex">@cat.Icon</div>
                                                <span class="text-xs font-bold text-gray-700">@cat.Name</span>
                                            </div>
                                        }
                                        @if(!_categories.Any()) { <span class="text-xs text-gray-400 italic p-2">Chưa có danh mục</span>}
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            </div>
            
            <style>
                .btn-premium {
                    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
                    color: white;
                    padding: 0.5rem 1rem;
                    border-radius: 0.75rem;
                    font-size: 0.75rem;
                    font-weight: 900;
                    letter-spacing: 0.05em;
                    border: none;
                    transition: all 0.2s;
                }
                .btn-premium:hover { transform: translateY(-1px); }
            </style>
        }
    </div>
</div>

<!-- Create Task Modal -->
@if (_showCreateModal)
{
    <CreateTaskModal OnClose="CloseCreateTaskModal" 
                     OnTaskCreated="HandleTaskCreated"
                     Categories="@_categories"
                     SelectedDate="@_selectedDate" />
}

<!-- Edit Task Modal -->
@if (_showEditModal && _editingTaskId.HasValue)
{
    <EditTaskModal TaskId="@_editingTaskId.Value"
                   OnClose="CloseEditTaskModal"
                   OnTaskUpdated="HandleTaskUpdated"
                   Categories="@_categories" />
}

<!-- Task Quick View Popover -->
@if (_selectedTaskForQuickView != null)
{
    <TaskDetailPopover Task="@_selectedTaskForQuickView"
                       X="@_quickViewX"
                       Y="@_quickViewY"
                       OnClose="CloseTaskQuickView"
                       OnEdit="EditTask"
                       OnDelete="DeleteTask"
                       OnToggleComplete="ToggleTaskComplete"
                       OnFocus="HandleFocusTask"
                       IsPremium="@(_currentUser?.IsPremium == true)"
                       OnUpgradeClicked="ShowUpgradeModal" />
}

<!-- Focus Mode Overlay / Controls -->
@if (_focusedTaskId.HasValue)
{
    var focusedTask = _allTasks.FirstOrDefault(t => t.Id == _focusedTaskId);
    if (focusedTask != null)
    {
        if (_currentUser?.IsPremium == true)
        {
            <!-- PREMIUM: Fullscreen Deep Work Mode -->
            <div class="fixed inset-0 z-[60] bg-primary-900/95 backdrop-blur-md flex flex-col items-center justify-center animate-fade-in text-white p-4">
                <!-- Header -->
                <div class="absolute top-6 left-6 flex items-center gap-4">
                    <div class="flex flex-col">
                        <span class="text-xs font-bold text-primary-300 uppercase tracking-widest">ĐANG TẬP TRUNG (PREMIUM)</span>
                        <h2 class="text-2xl font-black max-w-2xl line-clamp-1">@focusedTask.Title</h2>
                    </div>
                </div>

                <button @onclick="ExitFocusMode" class="absolute top-6 right-6 p-2 rounded-full bg-white dark:bg-gray-800/10 hover:bg-white dark:bg-gray-800/20 transition-colors text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <!-- Main Focus Area -->
                <div class="flex flex-col items-center animate-scale-up w-full max-w-4xl">
                    <FocusTimer OnTimerComplete="@(() => { /* Play sound */ })" />
                    <div class="mt-12">
                         <WhiteNoisePlayer IsPremium="true" OnUpgradeClicked="ShowUpgradeModal" />
                    </div>
                    <button @onclick="() => HandleCompleteFocusTask(focusedTask.Id)" 
                            class="mt-16 group relative px-8 py-4 bg-white dark:bg-gray-800 text-primary-900 rounded-full font-black text-lg shadow-[0_0_40px_-10px_rgba(255,255,255,0.3)] hover:shadow-[0_0_60px_-10px_rgba(255,255,255,0.5)] transition-all hover:scale-105 active:scale-95">
                        <span class="relative z-10 flex items-center gap-2">
                            HOÀN THÀNH
                            <svg class="w-5 h-5 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </span>
                        <div class="absolute inset-0 rounded-full bg-primary-50 opacity-0 group-hover:opacity-20 transition-opacity"></div>
                    </button>
                </div>
            </div>
        }
        else
        {
             <!-- FREE: Soft Focus (Floating Controls only, no Fullscreen) -->
             <!-- The blurring effect is handled by TimeBlocksGrid logic on focusedTaskId -->
             <div class="fixed bottom-6 right-6 z-[60] flex flex-col gap-3 animate-fade-in-up">
                 
                 <!-- Upgrade Nudge -->
                 <div class="bg-white dark:bg-gray-800/90 backdrop-blur text-xs p-2 rounded-lg shadow-lg border border-primary-100 max-w-[200px] text-center">
                     <p class="mb-1 text-gray-500">Muốn tập trung sâu hơn?</p>
                     <button @onclick="ShowUpgradeModal" class="text-primary-600 font-bold hover:underline">Nâng cấp Fullscreen Focus &rarr;</button>
                 </div>

                 <!-- Controls -->
                 <div class="flex items-center gap-2 bg-primary-900 text-white p-2 rounded-full shadow-2xl pl-4 pr-2">
                     <span class="text-xs font-bold uppercase tracking-wider animate-pulse">Soft Focus</span>
                     <div class="h-4 w-px bg-white/20 mx-1"></div>
                     <button @onclick="() => HandleCompleteFocusTask(focusedTask.Id)" class="p-2 hover:bg-white/10 rounded-full text-green-400 font-bold transition-colors" title="Hoàn thành">
                         <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                     </button>
                     <button @onclick="ExitFocusMode" class="p-2 hover:bg-white/10 rounded-full text-white/70 hover:text-white transition-colors" title="Thoát">
                         <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                     </button>
                 </div>
             </div>
        }
    }
}

<Confetti @ref="_confetti" />


@if (_showProfileModal && _currentUser != null)
{
    <ProfileModal 
        OnClose="() => _showProfileModal = false" 
        InitialUser="@_currentUser"
        OnProfileUpdated="HandleProfileUpdated"
        OnUpgradeClicked="ShowUpgradeModal" />
}

@if (_showUpgradeModal)
{
    <UpgradeModal
        OnClose="() => _showUpgradeModal = false"
        OnUpgradeSuccess="HandleUpgradeSuccess" />
}

@code {
