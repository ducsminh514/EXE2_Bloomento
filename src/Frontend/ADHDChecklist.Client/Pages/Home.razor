    private async Task HandleInboxDropWrapper()
    {
        if (_dragState.DraggedTask != null)
        {
            await HandleMoveToInbox(_dragState.DraggedTask.Id);
            _dragState.DraggedTask = null;
        }
        else if (_dragState.DraggedBrainDumpItem != null)
        {
            await ConvertBrainDumpToTask(_dragState.DraggedBrainDumpItem);
            _dragState.DraggedBrainDumpItem = null;
        }
    }

    private async Task ConvertBrainDumpToTask(BrainDumpItemResponse item)
    {
        try
        {
            // 1. Create Task in Inbox (no time block)
            var request = new CreateTaskRequest(
                item.Content,
                "", // No description
                null, // No category
                _selectedDate,
                null, // No start
                null, // No end
                30, // Default duration
                1, // Normal priority
                false, // IsRecurring
                null // RecurrencePattern
            );

            await TaskService.CreateTaskAsync(request);

            // 2. Delete Brain Dump Item
            await BrainDumpService.DeleteItemAsync(item.Id);

            // 3. Refresh
            await LoadData();
            
            if (_confetti != null) await _confetti.Shoot();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error converting brain dump to task: {ex.Message}");
        }
    }

    private async Task HandleMoveToInbox(Guid taskId)
    {
        // If already in inbox (no time block), ignore
        var task = _allTasks.FirstOrDefault(t => t.Id == taskId);
        if (task == null || !task.TimeBlockStart.HasValue)
            return;

        try
        {
            var updateRequest = new UpdateTaskRequest(
                task.Title,
                task.Description,
                task.CategoryId,
                _selectedDate,
                null, 
                null,
                task.Duration, // Preserve duration or set to null? Usually preserve or reset.
                task.Priority,
                task.IsCompleted
            );

            await TaskService.UpdateTaskAsync(task.Id, updateRequest);
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error moving task to inbox: {ex.Message}");
        }
    }

