<!-- Focus Mode Overlay / Controls -->
@if (_focusedTaskId.HasValue)
{
    var focusedTask = _allTasks.FirstOrDefault(t => t.Id == _focusedTaskId);
    if (focusedTask != null)
    {
        if (_currentUser?.IsPremium == true)
        {
            <!-- PREMIUM: Fullscreen Deep Work Mode -->
            <div class="fixed inset-0 z-[60] bg-primary-900/95 backdrop-blur-md flex flex-col items-center justify-center animate-fade-in text-white p-4">
                <!-- Header -->
                <div class="absolute top-6 left-6 flex items-center gap-4">
                    <div class="flex flex-col">
                        <span class="text-xs font-bold text-primary-300 uppercase tracking-widest">ĐANG TẬP TRUNG (PREMIUM)</span>
                        <h2 class="text-2xl font-black max-w-2xl line-clamp-1">@focusedTask.Title</h2>
                    </div>
                </div>

                <button @onclick="ExitFocusMode" class="absolute top-6 right-6 p-2 rounded-full bg-white dark:bg-gray-800/10 hover:bg-white dark:bg-gray-800/20 transition-colors text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <!-- Main Focus Area -->
                <div class="flex flex-col items-center animate-scale-up w-full max-w-4xl">
                    <FocusTimer OnTimerComplete="@(() => { /* Play sound */ })" />
                    <div class="mt-12">
                         <WhiteNoisePlayer IsPremium="true" OnUpgradeClicked="ShowUpgradeModal" />
                    </div>
                    <button @onclick="() => HandleCompleteFocusTask(focusedTask.Id)" 
                            class="mt-16 group relative px-8 py-4 bg-white dark:bg-gray-800 text-primary-900 rounded-full font-black text-lg shadow-[0_0_40px_-10px_rgba(255,255,255,0.3)] hover:shadow-[0_0_60px_-10px_rgba(255,255,255,0.5)] transition-all hover:scale-105 active:scale-95">
                        <span class="relative z-10 flex items-center gap-2">
                            HOÀN THÀNH
                            <svg class="w-5 h-5 transition-transform group-hover:rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </span>
                        <div class="absolute inset-0 rounded-full bg-primary-50 opacity-0 group-hover:opacity-20 transition-opacity"></div>
                    </button>
                </div>
            </div>
        }
        else
        {
             <!-- FREE: Soft Focus (Floating Controls only, no Fullscreen) -->
             <!-- The blurring effect is handled by TimeBlocksGrid logic on focusedTaskId -->
             <div class="fixed bottom-6 right-6 z-[60] flex flex-col gap-3 animate-fade-in-up">
                 
                 <!-- Upgrade Nudge -->
                 <div class="bg-white dark:bg-gray-800/90 backdrop-blur text-xs p-2 rounded-lg shadow-lg border border-primary-100 max-w-[200px] text-center">
                     <p class="mb-1 text-gray-500">Muốn tập trung sâu hơn?</p>
                     <button @onclick="ShowUpgradeModal" class="text-primary-600 font-bold hover:underline">Nâng cấp Fullscreen Focus &rarr;</button>
                 </div>

                 <!-- Controls -->
                 <div class="flex items-center gap-2 bg-primary-900 text-white p-2 rounded-full shadow-2xl pl-4 pr-2">
                     <span class="text-xs font-bold uppercase tracking-wider animate-pulse">Soft Focus</span>
                     <div class="h-4 w-px bg-white/20 mx-1"></div>
                     <button @onclick="() => HandleCompleteFocusTask(focusedTask.Id)" class="p-2 hover:bg-white/10 rounded-full text-green-400 font-bold transition-colors" title="Hoàn thành">
                         <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                     </button>
                     <button @onclick="ExitFocusMode" class="p-2 hover:bg-white/10 rounded-full text-white/70 hover:text-white transition-colors" title="Thoát">
                         <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                     </button>
                 </div>
             </div>
        }
    }
}

<Confetti @ref="_confetti" />


@if (_showProfileModal && _currentUser != null)
{
    <ProfileModal 
        OnClose="() => _showProfileModal = false" 
        InitialUser="@_currentUser"
        OnProfileUpdated="HandleProfileUpdated"
        OnUpgradeClicked="ShowUpgradeModal" />
}

@if (_showUpgradeModal)
{
    <UpgradeModal
        OnClose="() => _showUpgradeModal = false"
        OnUpgradeSuccess="HandleUpgradeSuccess" />
}

@if (_currentUser?.IsPremium == true)
{
    <BrainDumpWidget OnDragStarted="HandleBrainDumpDragStart" />
}

@code {
    // View State
    private AppView _currentView = AppView.Dashboard;

    private void SetView(AppView view)
    {
        _currentView = view;
        StateHasChanged();
    }

    private string _userName = "User";
    private string? _currentUserRole; // Store user role in family
    private CurrentUser? _currentUser; // Add current user storage

    private bool IsFamilyPlan => _currentUser?.SubscriptionTier == "Family";
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Now);
    private bool _isLoading = true;
    private bool _showCreateModal = false;
    private bool _showEditModal = false;
    private bool _showProfileModal = false; 
    private bool _showUpgradeModal = false;
    private Guid? _editingTaskId;
    private Confetti? _confetti; // Confetti ref
    
    // ... Existing methods ...

    private void ShowProfileModal()
    {
        _showProfileModal = true;
    }

    private void HandleProfileUpdated(string newName)
    {
        _userName = newName;
        if (_currentUser != null)
        {
            _currentUser.FullName = newName;
        }
        StateHasChanged();
    }
    
    private void ShowUpgradeModal()
    {
        _showProfileModal = false;
        _showUpgradeModal = true;
    }

    private async Task HandleUpgradeSuccess()
    {
        _showUpgradeModal = false;
        _currentUser = await AuthService.GetCurrentUserAsync();
        StateHasChanged();
    }
    
    // Quick View State
    private TaskResponse? _selectedTaskForQuickView;
    private double _quickViewX;
    private double _quickViewY;

    // Focus Mode State
    private Guid? _focusedTaskId;

    private void ShowTaskQuickView((TaskResponse task, double x, double y) data)
    {
        _selectedTaskForQuickView = data.task;
        _quickViewX = data.x;
        _quickViewY = data.y;
    }

    private void ShowTaskQuickViewFromClick(TaskResponse task, MouseEventArgs e)
    {
        _selectedTaskForQuickView = task;
        _quickViewX = e.ClientX;
        _quickViewY = e.ClientY;
    }

    private void CloseTaskQuickView()
    {
        _selectedTaskForQuickView = null;
    }

    private void HandleFocusTask(Guid taskId)
    {
        _focusedTaskId = taskId;
        _selectedTaskForQuickView = null; // Close popover to focus
    }

    private void ExitFocusMode()
    {
        _focusedTaskId = null;
    }

    private async Task HandleCompleteFocusTask(Guid taskId)
    {
        _focusedTaskId = null; // Exit focus
        await ToggleTaskComplete(taskId); // Mark done
        
        // Shoot confetti
        if (_confetti != null)
        {
            await _confetti.Shoot();
        }
    }

    private HashSet<Guid> _filteredMemberIds = new(); // Members to HIDE

    private void ToggleMemberFilter(Guid memberUserId)
    {
        if (_filteredMemberIds.Contains(memberUserId))
        {
            _filteredMemberIds.Remove(memberUserId);
        }
        else
        {
            _filteredMemberIds.Add(memberUserId);
        }
        FilterTasks(); // Re-apply filter
        StateHasChanged();
    }

    private List<TaskResponse> _allTasks = new();
    private List<TaskResponse> _scheduledTasks = new();
    private List<TaskResponse> _inboxTasks = new(); // Legacy, maybe unused or combined?
    private List<TaskResponse> _personalInboxTasks = new();
    private List<TaskResponse> _familyInboxTasks = new();
    private List<CategoryResponse> _categories = new();
    private List<FamilyMemberResponse> _familyMembers = new();
    private Guid? _familyId;
    private bool _showFamilyTasks = false; // Toggle state
    private int _overdueCount = 0;

    private int _completedCount => _allTasks.Count(t => t.IsCompleted);
    private int _completionRate => _allTasks.Count > 0 
        ? (int)Math.Round((double)_completedCount / _allTasks.Count * 100) 
        : 0;
    private int _points = 0;
    
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPoints();

        if (authState.User.IsInRole("Admin"))
        {
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }

        // Fetch detailed profile for modal
        _currentUser = await AuthService.GetCurrentUserAsync();
        if (_currentUser != null)
        {
            _userName = _currentUser.FullName;
        }
        else
        {
             var user = authState.User;
             _userName = user.FindFirst(c => c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name")?.Value 
                        ?? user.FindFirst(c => c.Type == "name")?.Value 
                        ?? "User";
        }
        
        // Fetch Family Data
        if (IsFamilyPlan)
        {
            var family = await FamilyService.GetFamilyAsync();
            if (family != null)
            {
                _familyMembers = family.Members;
                _familyId = family.Id;
                
                // Determine current user role
                if (_currentUser != null)
                {
                    var myMember = _familyMembers.FirstOrDefault(m => string.Equals(m.UserId.ToString(), _currentUser.UserId, StringComparison.OrdinalIgnoreCase));
                    _currentUserRole = myMember?.Role;
                }
            }
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var tasksTask = TaskService.GetTasksByDateAsync(_selectedDate);
            var categoriesTask = CategoryService.GetCategoriesAsync();
            var overdueTask = TaskService.GetOverdueCountAsync();

            await Task.WhenAll(tasksTask, categoriesTask, overdueTask);

            _allTasks = tasksTask.Result ?? new List<TaskResponse>();
            _categories = categoriesTask.Result ?? new List<CategoryResponse>();
            _overdueCount = overdueTask.Result;

            FilterTasks(); // Apply filtering logic
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PreviousDay()
    {
        _selectedDate = _selectedDate.AddDays(-1);
        await LoadData();
    }

    private async Task NextDay()
    {
        _selectedDate = _selectedDate.AddDays(1);
        await LoadData();
    }

    private async Task GoToToday()
    {
        _selectedDate = DateOnly.FromDateTime(DateTime.Now);
        await LoadData();
    }

    private void FilterTasks()
    {
        var tasksToShow = _allTasks;

        // Hide rejected tasks for Assignee
        if (_currentUser != null)
        {
             tasksToShow = tasksToShow.Where(t => 
                t.AssignmentStatus != "Rejected" || 
                string.Equals(t.AssignedUserId?.ToString(), _currentUser.UserId, StringComparison.OrdinalIgnoreCase) == false
             ).ToList();
        }
        
        if (!_showFamilyTasks)
        {
             if (_currentUser != null)
             {
                 var myId = Guid.Parse(_currentUser.UserId);
                 tasksToShow = tasksToShow.Where(t => 
                     t.AssignedUserId == null || 
                     t.AssignedUserId == myId).ToList();
             }
        }
        else
        {
            // Shared View: Filter out hidden members
            if (_filteredMemberIds.Any())
            {
                tasksToShow = tasksToShow.Where(t => 
                    t.AssignedUserId == null || // Always show Owner tasks? Or if owner is filtered? 
                    // Let's assume t.AssignedUserId covers it. If null, it's usually "Self" (Creator).
                    // If creator is filtered? API logic: tasks contain mixed creators.
                    // Better: If AssignedUser is known, check against filter.
                    // If AssignedUserId is NULL, it means "Unassigned" or "Self".
                    // For now, let's filter only if AssignedUserId matches a hidden ID.
                    !t.AssignedUserId.HasValue || !_filteredMemberIds.Contains(t.AssignedUserId.Value)
                ).ToList();
            }
        }

        _scheduledTasks = tasksToShow.Where(t => t.TimeBlockStart.HasValue && t.ScheduledDate == _selectedDate)
                                   .OrderBy(t => t.TimeBlockStart)
                                   .ToList();

        // INBOX LOGIC: Unscheduled tasks (ScheduledDate == null) (and not completed?)
        // Filter out completed tasks from Inbox to avoid clutter? Usually yes.
        // GetTasksByDate query already filters !IsCompleted for Unscheduled.
        
        // INBOX LOGIC: 
        // 1. Completely Unscheduled (No Date)
        // 2. Scheduled for Today but NO Time Block (To-do list for today)
        var allUnscheduled = tasksToShow.Where(t => 
            t.ScheduledDate == null || 
            (t.ScheduledDate == _selectedDate && t.TimeBlockStart == null)
        ).ToList();

        if (_currentUser != null) 
        {
            var myId = Guid.Parse(_currentUser.UserId);
            
            // Personal: Created by Me AND Not Shared AND (Assigned to Me OR Unassigned)
            // If I assign to someone else, it goes to Family box.
            _personalInboxTasks = allUnscheduled.Where(t => 
                t.CreatorId == myId && !t.IsShared && (!t.AssignedUserId.HasValue || t.AssignedUserId == myId)
            ).OrderBy(t => t.OrderIndex).ToList();
            
            // Family: Everything else relevant to family context
            // - Shared Tasks
            // - Created by Others (e.g. Parent assigned to me)
            // - Created by Me but Assigned to Others
            _familyInboxTasks = allUnscheduled.Where(t => 
                t.FamilyId != null && (t.IsShared || t.CreatorId != myId || (t.AssignedUserId.HasValue && t.AssignedUserId != myId))
            ).OrderBy(t => t.OrderIndex).ToList();
        }
        else 
        {
            _personalInboxTasks = allUnscheduled;
            _familyInboxTasks = new();
        }
        
        // Combine for Drag logic if needed? _inboxTasks used mainly for count?
        _inboxTasks = allUnscheduled;
    }
    
    private void ToggleFamilyFilter()
    {
        _showFamilyTasks = !_showFamilyTasks;
        FilterTasks();
    }

    private void ShowCreateTaskModal()
    {
        _showCreateModal = true;
    }

    private void CloseCreateTaskModal()
    {
        _showCreateModal = false;
    }

    private async Task HandleTaskCreated()
    {
        _showCreateModal = false;
        await LoadData();
    }

    private async Task ToggleTaskComplete(Guid taskId)
    {
        try
        {
            await TaskService.ToggleTaskCompletionAsync(taskId);
            await LoadData();
            await LoadPoints();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling task: {ex.Message}");
        }
    }

    private void EditTask(Guid taskId)
    {
        _selectedTaskForQuickView = null; // Close Quick View to prevent overlap
        _editingTaskId = taskId;
        _showEditModal = true;
    }

    private void CloseEditTaskModal()
    {
        _showEditModal = false;
        _editingTaskId = null;
    }

    private async Task HandleTaskUpdated()
    {
        _showEditModal = false;
        _editingTaskId = null;
        await LoadData();
    }

    private async Task DeleteTask(Guid taskId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc muốn xóa công việc này?");
        if (confirmed)
        {
            try
            {
                await TaskService.DeleteTaskAsync(taskId);
                await LoadData();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting task: {ex.Message}");
            }
        }
    }

    private async Task HandleLogout()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc muốn đăng xuất?");
        if (confirmed)
        {
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private async Task HandleMagicBreakdown(Guid taskId)
    {
        var task = _allTasks.FirstOrDefault(t => t.Id == taskId);
        if (task == null) return;

        // Optimistic UI / Toast? For now just log
        // Ideally show a toast "Generating steps..."
        // Since we don't have a toast service ready, checking JS confirm to notify user or just wait?
        // Let's use JS to show "Processing..."
        // await JS.InvokeVoidAsync("alert", "Đang phân tích và chia nhỏ công việc...");
        
        _isLoading = true; // Block UI slightly
        StateHasChanged();

        try
        {
            var steps = await TaskService.BreakdownTaskAsync(task.Title);
            
            if (steps.Length > 0)
            {
                var stepList = string.Join("\n", steps.Select(s => $"- [ ] {s}"));
                var newDescription = (task.Description ?? "") + $"\n\n**✨ Magic Breakdown:**\n{stepList}";
                
                var updateRequest = new UpdateTaskRequest(
                    task.Title,
                    newDescription,
                    task.CategoryId,
                    task.ScheduledDate,
                    task.TimeBlockStart,
                    task.TimeBlockEnd,
                    task.Duration,
                    task.Priority,
                    task.IsCompleted
                );

                await TaskService.UpdateTaskAsync(task.Id, updateRequest);
                await LoadData(); // Refresh UI
                
                // Show result in Edit Modal to verify? Or just let user see it.
                // Re-open/Refresh the Popover? Popover binds to _selectedTaskForQuickView which is updated by LoadData?
                // LoadData refreshes _allTasks, but _selectedTaskForQuickView is a separate object copy passed by value?
                // We need to re-find it.
                _selectedTaskForQuickView = _allTasks.FirstOrDefault(t => t.Id == taskId);
                
                await JS.InvokeVoidAsync("alert", "✨ Đã chia nhỏ công việc thành công! Hãy xem phần Mô tả.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "⚠️ AI không trả về kết quả nào. Hãy thử lại (Kiểm tra API Key).");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error magic breakdown: {ex.Message}");
            await JS.InvokeVoidAsync("alert", $"❌ Lỗi: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }



    private async Task HandleTaskTimeBlockDrop((TaskResponse task, TimeOnly startTime) dropData)
    {
        var task = dropData.task;
        var startTime = dropData.startTime;

        // If dropping into same slot, ignore
        if (task.TimeBlockStart.HasValue && task.TimeBlockStart.Value == startTime)
            return;

        try
        {
            var durationMinutes = task.Duration ?? 30; // 30 mins default
            var endTime = startTime.AddMinutes(durationMinutes);

            // 1. Check for Overlaps
            var overlappingTasks = _scheduledTasks
                .Where(t => t.Id != task.Id) // Exclude self
                .Where(t => 
                    t.TimeBlockStart.HasValue && 
                    t.TimeBlockEnd.HasValue &&
                    t.TimeBlockStart.Value < endTime && 
                    t.TimeBlockEnd.Value > startTime)
                .ToList();

            if (overlappingTasks.Any())
            {
                var conflictNames = string.Join(", ", overlappingTasks.Select(t => $"'{t.Title}'"));
                var confirmed = await JS.InvokeAsync<bool>("confirm", 
                    $"⚠️ Trùng lịch!\n\nKhung giờ {startTime:HH:mm} - {endTime:HH:mm} đang bị trùng với:\n{conflictNames}\n\nBạn có muốn VẪN TIẾP TỤC chèn vào không?\n(Nhấn Cancel để mở hộp thoại chỉnh sửa)");

                if (!confirmed)
                {
                    // Open Edit Modal so user can adjust time manually
                    EditTask(task.Id); 
                    return;
                }
            }

            // 2. Proceed if Valid or Confirmed
            // Check if current user is the assignee (if task is assigned)
            if (_currentUser != null)
            {
                if (task.AssignedUserId.HasValue && !string.Equals(task.AssignedUserId.Value.ToString(), _currentUser.UserId, StringComparison.OrdinalIgnoreCase))
                {
                    await JS.InvokeVoidAsync("alert", "⚠️ Chỉ người được giao việc mới có quyền sắp xếp lịch trình cho công việc này.");
                    return;
                }
            }

            var myId = _currentUser != null ? Guid.Parse(_currentUser.UserId) : (Guid?)null;
            var assignedUserId = task.AssignedUserId ?? myId;

            var updateRequest = new UpdateTaskRequest(
                task.Title,
                task.Description,
                task.CategoryId,
                _selectedDate,
                startTime,
                endTime,
                durationMinutes,
                task.Priority,
                task.IsCompleted,
                task.DopamineType,
                assignedUserId, // Auto-assign if unassigned
                task.IsShared,
                task.IsMandatory
            );

            await TaskService.UpdateTaskAsync(task.Id, updateRequest);
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating task time block: {ex.Message}");
            await LoadData(); // Reload to revert UI state on error
        }
    }

    private async Task HandleTaskResized((TaskResponse task, int newDuration) resizeData)
    {
        var task = resizeData.task;
        var newDuration = resizeData.newDuration;

        if (!task.TimeBlockStart.HasValue) return;

        try
        {
            var startTime = task.TimeBlockStart.Value;
            var endTime = startTime.AddMinutes(newDuration);

            // Check overlap
             var overlappingTasks = _scheduledTasks
                .Where(t => t.Id != task.Id)
                .Where(t => 
                    t.TimeBlockStart.HasValue && 
                    t.TimeBlockEnd.HasValue &&
                    t.TimeBlockStart.Value < endTime && 
                    t.TimeBlockEnd.Value > startTime)
                .ToList();

             if (overlappingTasks.Any())
             {
                 // Optional: Ask for confirmation on resize too, or just block it?
                 // For now, let's allow overlapping but maybe show a toast?
                 // Simple confirmation like Drop
                 var conflictNames = string.Join(", ", overlappingTasks.Select(t => $"'{t.Title}'"));
                 var confirmed = await JS.InvokeAsync<bool>("confirm", 
                    $"⚠️ Trùng lịch khi kéo dài!\n\nKhung giờ mới trùng với:\n{conflictNames}\n\nBạn có muốn giữ nguyên không?");
                 
                 if (!confirmed) return;
             }

            // Check if current user is the assignee
            if (_currentUser != null)
            {
                if (task.AssignedUserId.HasValue && !string.Equals(task.AssignedUserId.Value.ToString(), _currentUser.UserId, StringComparison.OrdinalIgnoreCase))
                {
                    await JS.InvokeVoidAsync("alert", "⚠️ Chỉ người được giao việc mới có quyền thay đổi thời lượng của công việc này.");
                    return;
                }
            }

            var updateRequest = new UpdateTaskRequest(
                task.Title,
                task.Description,
                task.CategoryId,
                _selectedDate,
                startTime,
                endTime,
                newDuration,
                task.Priority,
                task.IsCompleted
            );

            await TaskService.UpdateTaskAsync(task.Id, updateRequest);
            await LoadData();
        }
        catch (Exception ex)
        {
             Console.WriteLine($"Error resizing task: {ex.Message}");
        }
    }

