@page "/home"
@using ADHDChecklist.Client.Features.Dashboard.Services
@using ADHDChecklist.Client.Features.Dashboard.Components
@using ADHDChecklist.Client.Shared.Models
@using ADHDChecklist.Client.Features.Auth.Services
@inject ITaskService TaskService
@inject ICategoryService CategoryService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject DragDropState _dragState
@attribute [Authorize]

<PageTitle>Dashboard - ADHD Checklist</PageTitle>

<div class="min-h-screen bg-gray-50">
    <!-- Top Nav -->
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-4">
                    <h1 class="text-2xl font-bold text-gray-900">📝 ADHD Checklist</h1>
                    <span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm rounded-full font-medium">FREE</span>
                </div>
                
                <div class="flex items-center gap-4">
                    <span class="text-sm text-gray-600">Xin chào, <strong>@_userName</strong></span>
                    <button @onclick="HandleLogout" 
                            class="text-sm text-red-600 hover:text-red-700 font-medium">
                        Đăng xuất
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-full mx-auto px-3 py-4 h-screen flex flex-col overflow-hidden">
        <!-- Date Selector & Header -->
        <div class="mb-4 flex flex-col sm:flex-row items-center justify-between gap-4 flex-shrink-0">
            <div class="flex items-center gap-4">
                <button @onclick="PreviousDay" class="p-1.5 hover:bg-white rounded-lg border border-gray-200 text-gray-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg></button>
                <div class="text-center">
                    <h2 class="text-xl font-bold text-gray-900 leading-none">@_selectedDate.ToString("dd/MM/yyyy")</h2>
                    <p class="text-xs text-gray-500 font-medium">@GetVietnameseDayOfWeek(_selectedDate.DayOfWeek) @if(_selectedDate == DateOnly.FromDateTime(DateTime.Now)){<span class="text-indigo-600 font-bold ml-1">(Hôm nay)</span>}</p>
                </div>
                <button @onclick="NextDay" class="p-1.5 hover:bg-white rounded-lg border border-gray-200 text-gray-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></button>
                <button @onclick="GoToToday" class="px-3 py-1.5 bg-indigo-50 text-indigo-700 rounded-lg text-xs font-bold hover:bg-indigo-100 transition-colors">📅 Hôm nay</button>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="flex-1 flex justify-center items-center">
                <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-600"></div>
            </div>
        }
        else
        {
            <!-- Main Content Area - 40/60 Split -->
            <div class="flex-1 flex gap-4 min-h-0">
                
                <!-- Left Section: TIMELINE (40%) -->
                <div class="w-[40%] flex flex-col bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="bg-gradient-to-r from-indigo-600 to-indigo-700 text-white p-3 flex justify-between items-center shadow-md z-10">
                        <div class="flex items-center gap-2">
                            <span class="text-lg">⏱️</span>
                            <h3 class="font-bold text-sm uppercase tracking-wider">Lịch trình</h3>
                        </div>
                        <span class="bg-white/20 px-2 py-0.5 rounded text-[11px] font-bold">@_scheduledTasks.Count Tasks</span>
                    </div>
                    <div class="flex-1 min-h-0">
                        <TimeBlocksGrid Tasks="@_scheduledTasks"
                                        _selectedDate="@_selectedDate"
                                        OnToggleComplete="ToggleTaskComplete"
                                        OnEdit="EditTask"
                                        OnDelete="DeleteTask"
                                        OnTaskDropped="HandleTaskTimeBlockDrop" />
                    </div>
                </div>

                <!-- Right Section: WORKSPACE (60%) -->
                <div class="w-[60%] flex flex-col gap-4 min-h-0">
                    
                    <!-- Stats Header -->
                    <div class="flex items-center justify-between bg-white rounded-xl p-2 px-4 shadow-sm border border-gray-200 flex-shrink-0">
                        <div class="flex items-center gap-6">
                            <div class="flex items-center gap-3">
                                <div class="relative w-10 h-10">
                                    <svg class="w-full h-full transform -rotate-90">
                                        <circle cx="20" cy="20" r="16" stroke="#f3f4f6" stroke-width="4" fill="none" />
                                        <circle cx="20" cy="20" r="16" stroke="#6366f1" stroke-width="4" fill="none" stroke-dasharray="100" stroke-dashoffset="@(100 - _completionRate)" />
                                    </svg>
                                    <span class="absolute inset-0 flex items-center justify-center text-[10px] font-bold text-indigo-600">@_completionRate%</span>
                                </div>
                                <div>
                                    <p class="text-[10px] text-gray-400 font-bold uppercase">Tiến độ ngày</p>
                                    <p class="text-sm font-black text-gray-800">@_completedCount <span class="text-gray-400 font-normal">/ @_allTasks.Count xong</span></p>
                                </div>
                            </div>
                        </div>
                        <button @onclick="ShowCreateTaskModal" class="btn-premium flex items-center gap-2 shadow-indigo-200 shadow-lg">
                            <span>➕</span> <span class="hidden sm:inline">VIỆC MỚI</span>
                        </button>
                    </div>

                    <!-- Workspace Grid (Inbox & Brain Dump/Categories) -->
                    <div class="flex-1 grid grid-cols-2 gap-4 min-h-0">
                        
                        <!-- Col 1: INBOX (Full Height) -->
                        <div class="flex flex-col bg-gray-50 rounded-2xl border border-gray-200 overflow-hidden">
                            <div class="p-3 border-b border-gray-200 bg-white flex justify-between items-center">
                                <h4 class="font-black text-xs text-gray-700 uppercase tracking-widest flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-orange-500"></span> Inbox
                                </h4>
                                <span class="text-[10px] bg-gray-100 px-2 py-0.5 rounded-full font-bold text-gray-600">@_inboxTasks.Count</span>
                            </div>
                            <div class="flex-1 overflow-y-auto custom-scrollbar p-2 space-y-2 transition-colors @(_dragState.DraggedTask != null ? "bg-indigo-50/30" : "")"
                                 ondragover="event.preventDefault();"
                                 @ondrop="HandleInboxDropWrapper">
                                @if (_inboxTasks.Any()) {
                                    @foreach (var task in _inboxTasks) {
                                        <div class="bg-white p-3 rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-all cursor-grab active:cursor-grabbing group"
                                             draggable="true" @ondragstart="() => HandleDragStart(task)">
                                            <div class="flex justify-between items-start gap-2">
                                                <h5 class="text-sm font-bold text-gray-800 line-clamp-2">@task.Title</h5>
                                                @if(task.Priority > 1) { <span class="text-xs text-red-500 font-black">@string.Concat(Enumerable.Repeat("!", task.Priority-1))</span> }
                                            </div>
                                            <div class="flex items-center justify-between mt-2">
                                                <div class="flex items-center gap-2">
                                                    @if(!string.IsNullOrEmpty(task.CategoryName)) { <span class="text-[10px] px-1.5 py-0.5 bg-gray-100 rounded text-gray-600 font-medium">@task.CategoryName</span> }
                                                    <span class="text-[10px] text-gray-400 font-bold">@task.Duration m</span>
                                                </div>
                                                <div class="opacity-0 group-hover:opacity-100 flex gap-1 transition-opacity">
                                                    <button @onclick="() => EditTask(task.Id)" class="p-1 hover:bg-indigo-50 text-indigo-600 rounded"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg></button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                } else {
                                    <div class="h-full flex flex-col items-center justify-center text-gray-400 opacity-60">
                                        <span class="text-2xl mb-2">📥</span>
                                        <span class="text-xs font-medium">Trống</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Col 2: BRAIN DUMP & CATEGORIES -->
                        <div class="flex flex-col gap-4 min-h-0">
                            
                            <!-- Top: Brain Dump (Larger) -->
                            <div class="flex-1 bg-indigo-50/50 rounded-2xl border border-indigo-100 overflow-hidden flex flex-col">
                                <div class="p-3 border-b border-indigo-100/50 bg-white/50 flex justify-between items-center">
                                    <h4 class="font-black text-xs text-indigo-600 uppercase tracking-widest flex items-center gap-2">
                                        <span class="text-base">🧠</span> Brain Dump
                                    </h4>
                                </div>
                                <div class="flex-1 p-4 flex flex-col items-center justify-center text-center opacity-60 hover:opacity-100 transition-opacity cursor-dashed border-2 border-transparent hover:border-indigo-200 m-2 rounded-xl">
                                    <p class="text-sm font-bold text-indigo-400">Khu vực đang phát triển</p>
                                    <p class="text-[10px] text-indigo-300">Nơi xả ý tưởng nhanh</p>
                                </div>
                            </div>

                            <!-- Bottom: Categories (Smaller) -->
                            <div class="h-[40%] bg-white rounded-2xl border border-gray-200 overflow-hidden flex flex-col">
                                <div class="p-2 px-3 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                                     <h4 class="font-bold text-xs text-gray-500 uppercase">Danh mục</h4>
                                     <button @onclick="ShowCreateCategoryModal" class="text-[10px] bg-white border border-gray-200 px-2 py-0.5 rounded hover:bg-gray-50 text-indigo-600 font-bold">+</button>
                                </div>
                                <div class="flex-1 overflow-y-auto custom-scrollbar p-2">
                                    <div class="flex flex-wrap gap-2">
                                        @foreach(var cat in _categories) {
                                            <div class="flex items-center gap-2 p-1.5 pr-3 bg-white border border-gray-100 rounded-lg shadow-sm hover:border-indigo-100 transition-colors w-full sm:w-auto">
                                                <div class="w-6 h-6 rounded-md flex items-center justify-center text-xs text-white shadow-sm" style="background-color: @cat.ColorHex">@cat.Icon</div>
                                                <span class="text-xs font-bold text-gray-700">@cat.Name</span>
                                            </div>
                                        }
                                        @if(!_categories.Any()) { <span class="text-xs text-gray-400 italic p-2">Chưa có danh mục</span>}
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            
            <style>
                .btn-premium {
                    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
                    color: white;
                    padding: 0.5rem 1rem;
                    border-radius: 0.75rem;
                    font-size: 0.75rem;
                    font-weight: 900;
                    letter-spacing: 0.05em;
                    border: none;
                    transition: all 0.2s;
                }
                .btn-premium:hover { transform: translateY(-1px); }
            </style>
        }
    </div>
</div>

<!-- Create Task Modal -->
@if (_showCreateModal)
{
    <CreateTaskModal OnClose="CloseCreateTaskModal" 
                     OnTaskCreated="HandleTaskCreated"
                     Categories="@_categories"
                     SelectedDate="@_selectedDate" />
}

<!-- Edit Task Modal -->
@if (_showEditModal && _editingTaskId.HasValue)
{
    <EditTaskModal TaskId="@_editingTaskId.Value"
                   OnClose="CloseEditTaskModal"
                   OnTaskUpdated="HandleTaskUpdated"
                   Categories="@_categories" />
}

@code {
    private string _userName = "User";
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Now);
    private bool _isLoading = true;
    private bool _showCreateModal = false;
    private bool _showEditModal = false;
    private Guid? _editingTaskId;

    private List<TaskResponse> _allTasks = new();
    private List<TaskResponse> _scheduledTasks = new();
    private List<TaskResponse> _inboxTasks = new();
    private List<CategoryResponse> _categories = new();

    private int _completedCount => _allTasks.Count(t => t.IsCompleted);
    private int _completionRate => _allTasks.Count > 0 
        ? (int)Math.Round((double)_completedCount / _allTasks.Count * 100) 
        : 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _userName = user.FindFirst(c => c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name")?.Value 
                    ?? user.FindFirst(c => c.Type == "name")?.Value 
                    ?? "User";

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var tasksTask = TaskService.GetTasksByDateAsync(_selectedDate);
            var categoriesTask = CategoryService.GetCategoriesAsync();

            await Task.WhenAll(tasksTask, categoriesTask);

            _allTasks = tasksTask.Result ?? new List<TaskResponse>();
            _categories = categoriesTask.Result ?? new List<CategoryResponse>();

            _scheduledTasks = _allTasks.Where(t => t.TimeBlockStart.HasValue)
                                       .OrderBy(t => t.TimeBlockStart)
                                       .ToList();
            _inboxTasks = _allTasks.Where(t => !t.TimeBlockStart.HasValue)
                                   .OrderBy(t => t.OrderIndex)
                                   .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PreviousDay()
    {
        _selectedDate = _selectedDate.AddDays(-1);
        await LoadData();
    }

    private async Task NextDay()
    {
        _selectedDate = _selectedDate.AddDays(1);
        await LoadData();
    }

    private async Task GoToToday()
    {
        _selectedDate = DateOnly.FromDateTime(DateTime.Now);
        await LoadData();
    }

    private void ShowCreateTaskModal()
    {
        _showCreateModal = true;
    }

    private void CloseCreateTaskModal()
    {
        _showCreateModal = false;
    }

    private async Task HandleTaskCreated()
    {
        _showCreateModal = false;
        await LoadData();
    }

    private async Task ToggleTaskComplete(Guid taskId)
    {
        try
        {
            await TaskService.ToggleTaskCompletionAsync(taskId);
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling task: {ex.Message}");
        }
    }

    private void EditTask(Guid taskId)
    {
        _editingTaskId = taskId;
        _showEditModal = true;
    }

    private void CloseEditTaskModal()
    {
        _showEditModal = false;
        _editingTaskId = null;
    }

    private async Task HandleTaskUpdated()
    {
        _showEditModal = false;
        _editingTaskId = null;
        await LoadData();
    }

    private async Task DeleteTask(Guid taskId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc muốn xóa công việc này?");
        if (confirmed)
        {
            try
            {
                await TaskService.DeleteTaskAsync(taskId);
                await LoadData();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting task: {ex.Message}");
            }
        }
    }

    private async Task HandleLogout()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc muốn đăng xuất?");
        if (confirmed)
        {
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private async Task HandleTaskTimeBlockDrop((TaskResponse task, TimeOnly startTime) dropData)
    {
        var task = dropData.task;
        var startTime = dropData.startTime;

        // If dropping into same slot, ignore
        if (task.TimeBlockStart.HasValue && task.TimeBlockStart.Value == startTime)
            return;

        try
        {
            var durationMinutes = task.Duration ?? 30; // 30 mins default
            var endTime = startTime.AddMinutes(durationMinutes);

            // 1. Check for Overlaps
            var overlappingTasks = _scheduledTasks
                .Where(t => t.Id != task.Id) // Exclude self
                .Where(t => 
                    t.TimeBlockStart.HasValue && 
                    t.TimeBlockEnd.HasValue &&
                    t.TimeBlockStart.Value < endTime && 
                    t.TimeBlockEnd.Value > startTime)
                .ToList();

            if (overlappingTasks.Any())
            {
                var conflictNames = string.Join(", ", overlappingTasks.Select(t => $"'{t.Title}'"));
                var confirmed = await JS.InvokeAsync<bool>("confirm", 
                    $"⚠️ Trùng lịch!\n\nKhung giờ {startTime:HH:mm} - {endTime:HH:mm} đang bị trùng với:\n{conflictNames}\n\nBạn có muốn VẪN TIẾP TỤC chèn vào không?\n(Nhấn Cancel để mở hộp thoại chỉnh sửa)");

                if (!confirmed)
                {
                    // Open Edit Modal so user can adjust time manually
                    EditTask(task.Id); 
                    return;
                }
            }

            // 2. Proceed if Valid or Confirmed
            var updateRequest = new UpdateTaskRequest(
                task.Title,
                task.Description,
                task.CategoryId,
                _selectedDate,
                startTime,
                endTime,
                durationMinutes,
                task.Priority,
                task.IsCompleted
            );

            await TaskService.UpdateTaskAsync(task.Id, updateRequest);
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating task time block: {ex.Message}");
        }
    }

    private void HandleDragStart(TaskResponse task)
    {
        _dragState.DraggedTask = task;
    }

    private async Task HandleInboxDropWrapper()
    {
        if (_dragState.DraggedTask != null)
        {
            await HandleInboxDrop(_dragState.DraggedTask);
            _dragState.DraggedTask = null;
        }
    }

    private async Task HandleInboxDrop(TaskResponse task)
    {
        // If already in inbox (no time block), ignore
        if (!task.TimeBlockStart.HasValue)
            return;

        try
        {
            var updateRequest = new UpdateTaskRequest(
                task.Title,
                task.Description,
                task.CategoryId,
                _selectedDate,
                null, 
                null,
                task.Duration, // Preserve duration or set to null? Usually preserve or reset.
                task.Priority,
                task.IsCompleted
            );

            await TaskService.UpdateTaskAsync(task.Id, updateRequest);
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error moving task to inbox: {ex.Message}");
        }
    }

    private void ShowCreateCategoryModal()
    {
        // TODO: Implement category modal
        Console.WriteLine("Create category modal");
    }

    private string GetVietnameseDayOfWeek(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "Thứ Hai",
        DayOfWeek.Tuesday => "Thứ Ba",
        DayOfWeek.Wednesday => "Thứ Tư",
        DayOfWeek.Thursday => "Thứ Năm",
        DayOfWeek.Friday => "Thứ Sáu",
        DayOfWeek.Saturday => "Thứ Bảy",
        DayOfWeek.Sunday => "Chủ Nhật",
        _ => ""
    };
}