@page "/home"
@using ADHDChecklist.Client.Features.Dashboard.Services
@using ADHDChecklist.Client.Features.Dashboard.Components
@using ADHDChecklist.Client.Shared.Models
@using ADHDChecklist.Client.Features.Auth.Services
@using ADHDChecklist.Client.Features.Auth.Components
@using ADHDChecklist.Client.Features.Focus.Components
@using ADHDChecklist.Client.Shared.Components
@using ADHDChecklist.Client.Features.Habits.Components
@using ADHDChecklist.Client.Features.Family.Services
@using ADHDChecklist.Client.Features.Notifications.Components
@using ADHDChecklist.Client.Features.Family.Components
@inject ITaskService TaskService
@inject ICategoryService CategoryService
@inject IFamilyService FamilyService
@inject IRewardService RewardService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IBrainDumpService BrainDumpService
@inject DragDropState _dragState
@attribute [Authorize]

<PageTitle>Bloomento</PageTitle>

<div class="min-h-screen bg-gray-50">
    <!-- Top Nav -->
    <nav class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700 transition-all duration-300 @(_focusedTaskId.HasValue ? "blur-sm grayscale opacity-30 pointer-events-none" : "")">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2">
                        <img src="logo.png" class="h-8 w-8 object-contain" alt="Bloomento Logo" />
                        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Bloomento</h1>
                    </div>
                    @if (_currentUser?.IsPremium == true)
                    {
                        <span class="px-3 py-1 bg-gradient-to-r from-purple-500 to-primary-600 text-white text-xs rounded-full font-bold shadow-sm flex items-center gap-1">
                             <span>👑</span> PREMIUM
                        </span>
                    }
                    else
                    {
                        <button @onclick="ShowUpgradeModal" class="px-3 py-1 bg-gray-100 hover:bg-gray-200 text-gray-600 text-xs rounded-full font-bold transition-colors">
                            FREE
                        </button>
                    }
                </div>



                <!-- Navigation Links -->
                <div class="hidden md:flex items-center gap-6 ml-8">
                     <AuthorizeView Roles="Admin">
                        <a href="/admin/dashboard" class="px-3 py-1 bg-slate-800 text-white text-xs font-bold rounded-md hover:bg-slate-700 transition-colors flex items-center gap-2">
                            <span>🛡️</span> Admin Panel
                        </a>
                    </AuthorizeView>

                    <a href="/" class="text-sm font-bold text-primary-700 border-b-2 border-primary-600 pb-0.5">
                        Dashboard
                    </a>
                    <a href="/knowledge" class="text-sm font-medium text-gray-500 hover:text-primary-600 transition-colors flex items-center gap-1 group">
                        <span>📚</span> 
                        <span class="group-hover:translate-x-0.5 transition-transform">Kiến thức</span>
                    </a>
                    @if (_currentUser?.SubscriptionTier == "Family")
                    {
                        <a href="/settings/family" class="text-sm font-medium text-gray-500 hover:text-primary-600 transition-colors flex items-center gap-1 group">
                            <span>👨‍👩‍👧‍👦</span> 
                            <span class="group-hover:translate-x-0.5 transition-transform">Gia đình</span>
                        </a>
                    }
                </div>
                
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-1.5 bg-yellow-50 text-yellow-700 px-2.5 py-1 rounded-full border border-yellow-200 text-sm font-medium shadow-sm">
                        <span class="text-base">🪙</span>
                        <span>@_points.ToString("N0")</span>
                    </div>
                    <NotificationBell />
                    <button @onclick="ShowProfileModal" class="text-sm text-gray-600 hover:text-primary-600 transition-colors flex items-center gap-2 group">
                        <span>Xin chào, <strong class="group-hover:text-primary-700">@_userName</strong></span>
                        <div class="w-6 h-6 rounded-full bg-primary-100 flex items-center justify-center text-xs font-bold text-primary-600 border border-primary-200">
                            @(!string.IsNullOrEmpty(_userName) ? _userName[0].ToString().ToUpper() : "U")
                        </div>
                    </button>
                    <button @onclick="HandleLogout" 
                            class="text-sm text-red-500 hover:text-red-700 font-bold uppercase text-[10px] border border-transparent hover:border-red-100 rounded px-2 py-1 transition-all">
                        Đăng xuất
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-full mx-auto px-3 py-4 h-screen flex flex-col overflow-hidden relative">
        @if (_currentView == AppView.Dashboard)
        {
            <!-- Date Selector & Header -->
            <div class="mb-4 flex flex-col sm:flex-row items-center justify-between gap-4 flex-shrink-0 transition-all duration-300 @(_focusedTaskId.HasValue ? "blur-sm grayscale opacity-30 pointer-events-none" : "")">
                <div class="flex items-center gap-4">
                    <button @onclick="PreviousDay" class="p-1.5 hover:bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg></button>
                    <div class="text-center">
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white leading-none">@_selectedDate.ToString("dd/MM/yyyy")</h2>
                        <p class="text-xs text-gray-500 font-medium">@GetVietnameseDayOfWeek(_selectedDate.DayOfWeek) @if(_selectedDate == DateOnly.FromDateTime(DateTime.Now)){<span class="text-primary-600 font-bold ml-1">(Hôm nay)</span>}</p>
                    </div>
                    <button @onclick="NextDay" class="p-1.5 hover:bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></button>
                    <button @onclick="GoToToday" class="px-3 py-1.5 bg-primary-50 text-primary-700 rounded-lg text-xs font-bold hover:bg-primary-100 transition-colors">📅 Hôm nay</button>
                    
                    @if (IsFamilyPlan && _familyId.HasValue)
                    {
                        <div class="flex items-center gap-2 bg-white dark:bg-gray-800 p-1 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm">
                            <button @onclick="ToggleFamilyFilter" 
                                    class="px-3 py-1.5 rounded-md text-xs font-bold transition-colors flex items-center gap-1 @(_showFamilyTasks ? "bg-purple-100 text-purple-700" : "hover:bg-gray-50 text-gray-600")">
                                <span>@(_showFamilyTasks ? "👨‍👩‍👧‍👦 Gia đình" : "👤 Cá nhân")</span>
                            </button>
                            
                            @if (_showFamilyTasks && _familyMembers.Any())
                            {
                                <div class="w-px h-4 bg-gray-200 dark:bg-gray-700 mx-1"></div>
                                <div class="flex items-center gap-1">
                                    @foreach (var member in _familyMembers)
                                    {
                                        var isHidden = _filteredMemberIds.Contains(member.UserId);
                                        <button @onclick="() => ToggleMemberFilter(member.UserId)"
                                                class="relative group transition-all duration-200 @(isHidden ? "opacity-40 grayscale" : "opacity-100 hover:scale-110")"
                                                title="@(isHidden ? $"Hiện {member.Nickname}" : $"Ẩn {member.Nickname}")">
                                            @if (!string.IsNullOrEmpty(member.AvatarUrl))
                                            {
                                                <img src="@member.AvatarUrl" class="w-6 h-6 rounded-full border-2 border-white dark:border-gray-800 shadow-sm object-cover" 
                                                     style="@(isHidden ? "" : $"border-color: {member.Color}")" />
                                            }
                                            else
                                            {
                                                <div class="w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold text-white shadow-sm border-2 border-white dark:border-gray-800"
                                                     style="background-color: @(member.Color ?? "#6366f1"); @(isHidden ? "background-color: #9ca3af;" : "")">
                                                    @member.Nickname?.FirstOrDefault().ToString().ToUpper()
                                                </div>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (_isLoading)
            {
                <div class="flex-1 flex justify-center items-center">
                    <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-primary-600"></div>
                </div>
            }
            else
            {
                <!-- Main Content Area - 40/60 Split -->
                <div class="flex-col flex-1 flex gap-4 min-h-0">
                    <!-- Overdue Banner -->
                    @if (_overdueCount > 0 && _selectedDate == DateOnly.FromDateTime(DateTime.Now))
                    {
                         <div class="bg-gradient-to-r from-orange-50 to-amber-50 p-3 rounded-xl border border-orange-100 flex items-center justify-between shadow-sm animate-fade-in mb-2 flex-shrink-0">
                            <div class="flex items-center gap-3">
                                <span class="bg-orange-100 p-2 rounded-lg text-orange-600">🕰️</span>
                                <div>
                                    <p class="text-xs font-bold text-orange-800 uppercase tracking-wide">Clean up</p>
                                    <p class="text-sm font-medium text-gray-700">Bạn có <span class="font-bold text-orange-600">@_overdueCount</span> công việc quá hạn.</p>
                                </div>
                            </div>
                            <button @onclick="HandleAutoAdjust" 
                                    class="px-4 py-2 bg-white dark:bg-gray-800 text-orange-600 font-bold text-xs rounded-lg border border-orange-200 shadow-sm hover:shadow-md hover:scale-105 transition-all flex items-center gap-2">
                                <span>✨</span> Dời sang hôm nay
                                @if (_currentUser?.IsPremium != true) { <span class="opacity-50 text-[9px]">PREMIUM</span> }
                            </button>
                        </div>
                    }

                    <div class="flex-1 flex gap-4 min-h-0">
                    
                    <!-- Left Section: TIMELINE (30%) -->
                    <div class="w-[30%] flex flex-col min-w-[300px] gap-4 min-h-0">
                        
                        <!-- Date Navigation (Floating) -->
                        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-2 flex items-center justify-between flex-shrink-0 @(_focusedTaskId.HasValue ? "blur-sm grayscale opacity-30 pointer-events-none" : "")">
                            <button class="p-2 hover:bg-gray-50 rounded-lg text-gray-500 transition-colors" @onclick="() => _selectedDate = _selectedDate.AddDays(-1)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                            </button>
                            <div class="flex flex-col items-center">
                                <span class="text-lg font-black text-gray-800 dark:text-gray-100 leading-none">@_selectedDate.ToString("dd/MM/2026")</span>
                                <span class="text-[10px] font-bold text-primary-500 uppercase tracking-widest mt-0.5">
                                    @if (_selectedDate == DateOnly.FromDateTime(DateTime.Now)) { <span class="bg-primary-50 dark:bg-primary-900/30 px-2 rounded">Hôm nay</span> } 
                                    else { <span>@_selectedDate.ToString("dddd")</span> }
                                </span>
                            </div>
                            <button class="p-2 hover:bg-gray-50 rounded-lg text-gray-500 transition-colors" @onclick="() => _selectedDate = _selectedDate.AddDays(1)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            </button>
                        </div>

                        <!-- Timeline Grid area -->
                        <div class="flex-1 min-h-0 bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden relative flex flex-col">
                            <div class="bg-gradient-to-r from-primary-600 to-primary-700 text-white p-3 flex justify-between items-center shadow-md z-10">
                                <div class="flex items-center gap-2">
                                    <span class="text-lg">⏱️</span>
                                    <h3 class="font-bold text-sm uppercase tracking-wider">Lịch trình</h3>
                                </div>
                                <span class="bg-white dark:bg-gray-800/20 px-2 py-0.5 rounded text-[11px] font-bold">@_scheduledTasks.Count Tasks</span>
                            </div>
                            <div class="flex-1 min-h-0 relative">
                                 <TimeBlocksGrid Tasks="@_scheduledTasks"
                                                _selectedDate="@_selectedDate"
                                                OnToggleComplete="ToggleTaskComplete"
                                                OnEdit="EditTask"
                                                OnDelete="DeleteTask"
                                                OnTaskDropped="HandleTaskTimeBlockDrop"
                                                OnTaskResized="HandleTaskResized"
                                                OnTaskClick="ShowTaskQuickView" 
                                                FocusedTaskId="@_focusedTaskId"
                                                IsPremium="@(_currentUser?.IsPremium == true)"
                                                CurrentUserId="@_currentUser?.UserId" 
                                                OnTaskUpdated="LoadData" />
                            </div>
                        </div>
                    </div>

                    <!-- Right Section: WORKSPACE (70%) -->
                    <div class="w-[70%] flex flex-col gap-4 min-h-0 overflow-y-auto overflow-x-hidden pr-2 custom-scrollbar @(_focusedTaskId.HasValue ? "opacity-30 blur-sm grayscale pointer-events-none transition-all duration-500" : "transition-all duration-300")">
                        


                        <!-- Stats Header -->
                        <div class="flex items-center justify-between bg-white dark:bg-gray-800 rounded-xl p-2 px-4 shadow-sm border border-gray-200 dark:border-gray-700 flex-shrink-0 transition-colors">
                            <div class="flex items-center gap-6">
                                <div class="flex items-center gap-3">
                                    <div class="relative w-10 h-10">
                                        <svg class="w-full h-full transform -rotate-90">
                                            <circle cx="20" cy="20" r="16" stroke="#f3f4f6" stroke-width="4" fill="none" />
                                            <circle cx="20" cy="20" r="16" stroke="#6366f1" stroke-width="4" fill="none" stroke-dasharray="100" stroke-dashoffset="@(100 - _completionRate)" />
                                        </svg>
                                        <span class="absolute inset-0 flex items-center justify-center text-[10px] font-bold text-primary-600">@_completionRate%</span>
                                    </div>
                                    <div>
                                        <p class="text-[10px] text-gray-400 font-bold uppercase">Tiến độ ngày</p>
                                        <p class="text-sm font-black text-gray-800 dark:text-gray-100">@_completedCount <span class="text-gray-400 font-normal">/ @_allTasks.Count xong</span></p>
                                    </div>
                                </div>
                            </div>
                            <button @onclick="ShowCreateTaskModal" class="btn-premium flex items-center gap-2 shadow-primary-200 dark:shadow-none shadow-lg transition-transform active:scale-95">
                                <span>➕</span> <span class="hidden sm:inline">VIỆC MỚI</span>
                            </button>
                        </div>

                        <!-- Habit Tracker -->
                        <div class="flex-shrink-0">
                            <HabitTracker IsPremium="@(_currentUser?.IsPremium == true)" 
                                          OnUpgradeClicked="ShowUpgradeModal"
                                          OnHabitToggled="LoadPoints" />
                        </div>

                        <!-- Workspace Grid (Inbox & Analytics/Categories) -->
                        <div class="flex-1 flex gap-4 min-h-0 items-stretch">
                            
                            <!-- MIDDLE: INBOX -->
                            <div class="flex-1 min-w-0 flex gap-3">
                                
                                @if (_familyId.HasValue)
                                {
                                    <!-- FAMILY MODE: SPLIT INBOX -->
                                    <!-- Personal Inbox -->
                                    <div class="flex-1 flex flex-col bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-colors">
                                        <div class="p-3 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 flex justify-between items-center">
                                            <h4 class="font-black text-xs text-gray-700 dark:text-gray-300 uppercase tracking-widest flex items-center gap-2">
                                                <span class="w-2 h-2 rounded-full bg-blue-500"></span> Cá nhân
                                            </h4>
                                            <span class="text-[10px] bg-gray-200 dark:bg-gray-700 px-2 py-0.5 rounded-full font-bold text-gray-600 dark:text-gray-400">@_personalInboxTasks.Count</span>
                                        </div>
                                        <div class="flex-1 overflow-y-auto custom-scrollbar p-2 space-y-2"
                                             ondragover="event.preventDefault();"
                                             @ondrop="HandleInboxDropWrapper">
                                            @if (_personalInboxTasks.Any()) {
                                                @foreach (var task in _personalInboxTasks) {
                                                    var isAssignee = !task.AssignedUserId.HasValue || string.Equals(task.AssignedUserId.Value.ToString(), _currentUser?.UserId, StringComparison.OrdinalIgnoreCase);
                                                    <div class="bg-white dark:bg-gray-800 p-3 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-all cursor-pointer active:cursor-grabbing group"
                                                         draggable="@(isAssignee ? "true" : "false")" @ondragstart="() => HandleDragStart(task)"
                                                         @onclick="(e) => ShowTaskQuickViewFromClick(task, e)">
                                                        <div class="flex justify-between items-start gap-2">
                                                            <h5 class="text-sm font-bold text-gray-800 dark:text-gray-100 line-clamp-2">@task.Title</h5>
                                                            @if(task.Priority > 1) { <span class="text-xs text-red-500 font-black">@string.Concat(Enumerable.Repeat("!", task.Priority-1))</span> }
                                                        </div>
                                                        <div class="flex items-center justify-between mt-2">
                                                             @if(!string.IsNullOrEmpty(task.CategoryName)) { <span class="text-[10px] px-1.5 py-0.5 bg-gray-100 dark:bg-gray-700 rounded text-gray-600 dark:text-gray-400 font-medium">@task.CategoryName</span> }
                                                             <span class="text-[10px] text-gray-400 font-bold">@task.Duration m</span>
                                                        </div>
                                                    </div>
                                                }
                                            } else {
                                                <div class="h-full flex flex-col items-center justify-center text-gray-300 opacity-60">
                                                    <span class="text-xl mb-1">👤</span>
                                                    <span class="text-[10px]">Trống</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @if (IsFamilyPlan)
                                    {
                                        <!-- Family Inbox -->
                                        <div class="flex-1 flex flex-col bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-colors">
                                            <div class="p-3 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 flex justify-between items-center">
                                                <h4 class="font-black text-xs text-gray-700 dark:text-gray-300 uppercase tracking-widest flex items-center gap-2">
                                                    <span class="w-2 h-2 rounded-full bg-purple-500"></span> Gia đình
                                                </h4>
                                                <span class="text-[10px] bg-gray-200 dark:bg-gray-700 px-2 py-0.5 rounded-full font-bold text-gray-600 dark:text-gray-400">@_familyInboxTasks.Count</span>
                                            </div>
                                            <div class="flex-1 overflow-y-auto custom-scrollbar p-2 space-y-2"
                                                 ondragover="event.preventDefault();"
                                                 @ondrop="HandleInboxDropWrapper">
                                                @if (_familyInboxTasks.Any()) {
                                                    @foreach (var task in _familyInboxTasks) {
                                                        var isAssignee = !task.AssignedUserId.HasValue || string.Equals(task.AssignedUserId.Value.ToString(), _currentUser?.UserId, StringComparison.OrdinalIgnoreCase);
                                                        <div class="bg-white dark:bg-gray-800 p-3 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-all cursor-pointer group"
                                                             draggable="@(isAssignee ? "true" : "false")" @ondragstart="() => HandleDragStart(task)"
                                                             @onclick="(e) => ShowTaskQuickViewFromClick(task, e)">
                                                            <div class="flex justify-between items-start gap-2">
                                                                <h5 class="text-sm font-bold text-gray-800 dark:text-gray-100 line-clamp-2">@task.Title</h5>
                                                                <!-- Avatar for Family Member -->
                                                                @if (!string.IsNullOrEmpty(task.AssignedUserAvatar)) {
                                                                    <img src="@task.AssignedUserAvatar" class="w-4 h-4 rounded-full border border-gray-100" />
                                                                } else {
                                                                     <span class="text-[10px] font-bold text-purple-600">@(task.AssignedUserName?.FirstOrDefault())</span>
                                                                }
                                                            </div>
                                                            <div class="flex items-center justify-between mt-2">
                                                                <span class="text-[10px] text-gray-400">Cho: @task.AssignedUserName</span>
                                                            </div>
                                                        </div>
                                                    }
                                                } else {
                                                     <div class="h-full flex flex-col items-center justify-center text-gray-300 opacity-60">
                                                        <span class="text-xl mb-1">👨‍👩‍👧‍👦</span>
                                                        <span class="text-[10px]">Trống</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <!-- SINGLE USER MODE: UNIFIED INBOX -->
                                    <div class="w-full flex flex-col bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden transition-colors">
                                        <div class="p-3 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 flex justify-between items-center transition-colors">
                                            <h4 class="font-black text-xs text-gray-700 dark:text-gray-300 uppercase tracking-widest flex items-center gap-2">
                                                <span class="w-2 h-2 rounded-full bg-orange-500"></span> Inbox
                                            </h4>
                                            <span class="text-[10px] bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded-full font-bold text-gray-600 dark:text-gray-400">@_personalInboxTasks.Count</span>
                                        </div>
                                        <div class="flex-1 overflow-y-auto custom-scrollbar p-2 space-y-2 transition-colors @(_dragState.DraggedTask != null ? "bg-primary-50/30 dark:bg-primary-900/10" : "")"
                                             ondragover="event.preventDefault();"
                                             @ondrop="HandleInboxDropWrapper">
                                            @if (_personalInboxTasks.Any()) {
                                                @foreach (var task in _personalInboxTasks) {
                                                    <div class="bg-white dark:bg-gray-800 p-3 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-all cursor-pointer active:cursor-grabbing group"
                                                         draggable="true" @ondragstart="() => HandleDragStart(task)"
                                                         @onclick="(e) => ShowTaskQuickViewFromClick(task, e)">
                                                        <div class="flex justify-between items-start gap-2">
                                                            <h5 class="text-sm font-bold text-gray-800 dark:text-gray-100 line-clamp-2">@task.Title</h5>
                                                            @if(task.Priority > 1) { <span class="text-xs text-red-500 font-black">@string.Concat(Enumerable.Repeat("!", task.Priority-1))</span> }
                                                        </div>
                                                        <div class="flex items-center justify-between mt-2">
                                                            <div class="flex items-center gap-2">
                                                                @if(!string.IsNullOrEmpty(task.CategoryName)) { <span class="text-[10px] px-1.5 py-0.5 bg-gray-100 dark:bg-gray-700 rounded text-gray-600 dark:text-gray-400 font-medium">@task.CategoryName</span> }
                                                                <span class="text-[10px] text-gray-400 font-bold">@task.Duration m</span>
                                                            </div>
                                                            <div class="opacity-0 group-hover:opacity-100 flex gap-1 transition-opacity">
                                                                <button @onclick="() => EditTask(task.Id)" class="p-1 hover:bg-primary-50 dark:hover:bg-primary-900/30 text-primary-600 rounded transition-colors"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg></button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            } else {
                                                <div class="h-full flex flex-col items-center justify-center text-gray-400 opacity-60">
                                                    <span class="text-2xl mb-2">📥</span>
                                                    <span class="text-xs font-medium uppercase tracking-tighter">Hộp thư đến trống</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- RIGHT: ANALYTICS & CATEGORIES (Fixed 25%) -->
