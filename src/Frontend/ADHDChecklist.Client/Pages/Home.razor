    private async Task HandleAutoAdjust()
    {
        if (_currentUser?.IsPremium != true)
        {
            ShowUpgradeModal();
            return;
        }

        _isLoading = true;
        try 
        {
            var count = await TaskService.AutoAdjustTasksAsync();
            if (count > 0) 
            {
                 await JS.InvokeVoidAsync("alert", $"Đã dời {count} công việc quá hạn sang hôm nay!");
            }
            else
            {
                 await JS.InvokeVoidAsync("alert", "Không có công việc nào quá hạn cần dời.");
            }
        }
        catch (Exception ex)
        {
             if (ex.Message.Contains("Premium")) 
             {
                 ShowUpgradeModal();
             }
             else
             {
                 Console.WriteLine($"Error auto-adjust: {ex.Message}");
                 await JS.InvokeVoidAsync("alert", "Lỗi khi dời lịch tự động: " + ex.Message);
             }
        }
        finally
        {
            _isLoading = false;
            await LoadData();
        }
    }

