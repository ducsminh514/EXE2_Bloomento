@page "/payment/success"
@page "/payment/cancel"
@inject NavigationManager Navigation
@inject ADHDChecklist.Client.Features.Auth.Services.IAuthService AuthService

<div class="min-h-screen bg-gray-50 flex flex-col items-center justify-center p-4">
    <div class="bg-white p-8 rounded-2xl shadow-xl max-w-md w-full text-center animate-scale-up">
        @if (IsSuccess)
        {
            <div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">Thanh toán thành công!</h2>
            <p class="text-gray-600 mb-6">Cảm ơn bạn đã ủng hộ Bloomento. Gói của bạn đang được kích hoạt tự động.</p>
        }
        else
        {
            <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">Thanh toán đã bị hủy</h2>
            <p class="text-gray-600 mb-6">Giao dịch của bạn không thành công hoặc đã bị hủy. Đừng lo, bạn có thể thử lại bất cứ lúc nào.</p>
        }

        <button @onclick="GoHome" class="w-full py-3 px-4 bg-primary-600 text-white font-bold rounded-xl shadow-lg hover:bg-primary-700 transition-all">
            Quay về Trang chủ
        </button>
        
        <p class="text-xs text-gray-400 mt-4 italic">Đang quay về sau @Countdown giây...</p>
    </div>
</div>

@code {
    private bool IsSuccess => Navigation.Uri.Contains("/success");
    private int Countdown = 5;

    protected override async Task OnInitializedAsync()
    {
        if (IsSuccess)
        {
             // Force refresh user info to show premium status immediately
             await AuthService.RefreshTokenAsync();
        }

        // Auto redirect after 5 seconds
        while (Countdown > 0)
        {
            await Task.Delay(1000);
            Countdown--;
            StateHasChanged();
        }
        GoHome();
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}
