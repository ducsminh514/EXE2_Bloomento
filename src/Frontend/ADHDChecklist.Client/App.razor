@using Microsoft.AspNetCore.Components.Authorization
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="min-h-screen flex items-center justify-center bg-gray-50">
                            <div class="text-center">
                                <h1 class="text-2xl font-bold text-gray-900 mb-4">Không có quyền truy cập</h1>
                                <p class="text-gray-600 mb-6">Bạn không có quyền truy cập tính năng này.</p>
                                <a href="/" class="text-indigo-600 hover:text-indigo-500">Quay về trang chủ</a>
                            </div>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="min-h-screen flex items-center justify-center bg-gray-50">
                    <div class="text-center">
                        <h1 class="text-6xl font-bold text-gray-900 mb-4">404</h1>
                        <p class="text-xl text-gray-600 mb-6">Không tìm thấy trang</p>
                        <a href="/" class="bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700">
                            Quay về trang chủ
                        </a>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    // Redirect to login component
    private class RedirectToLogin : ComponentBase
    {
        [Inject] NavigationManager Navigation { get; set; } = default!;

        protected override void OnInitialized()
        {
            Navigation.NavigateTo("/login");
        }
    }
}