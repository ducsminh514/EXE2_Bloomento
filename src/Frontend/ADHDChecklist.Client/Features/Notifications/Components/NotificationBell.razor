@using ADHDChecklist.Client.Features.Notifications.Services
@using ADHDChecklist.Client.Shared.Models
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="relative">
    <button @onclick="ToggleDropdown" class="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors relative" title="Thông báo">
        <span class="text-xl">🔔</span>
        @if (UnreadCount > 0)
        {
            <span class="absolute top-0 right-0 h-4 w-4 bg-red-500 text-white text-[10px] font-bold flex items-center justify-center rounded-full animate-pulse border-2 border-white dark:border-gray-900">
                @(UnreadCount > 9 ? "9+" : UnreadCount)
            </span>
        }
    </button>

    @if (_isOpen)
    {
        <div class="absolute right-0 mt-2 w-80 bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700 z-50 overflow-hidden animate-scale-in">
            <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-800">
                <h3 class="font-bold text-sm text-gray-800 dark:text-gray-200">Thông báo</h3>
                @if (Notifications.Any(n => !n.IsRead))
                {
                    <button class="text-xs text-primary-600 font-medium hover:underline" @onclick="MarkAllAsRead">Đánh dấu đã đọc</button>
                }
            </div>

            <div class="max-h-80 overflow-y-auto">
                @if (Notifications.Any())
                {
                    @foreach (var notif in Notifications)
                    {
                        <div class="p-3 border-b border-gray-50 dark:border-gray-700/50 hover:bg-gray-50 dark:hover:bg-gray-700/50 cursor-pointer transition-colors relative group @(notif.IsRead ? "opacity-75" : "bg-blue-50/30 dark:bg-blue-900/10")" 
                             @onclick="() => HandleClick(notif)">
                            <div class="flex gap-3">
                                <div class="mt-1 text-lg">
                                    @(notif.Type == "TaskAssignment" ? "📝" : "🔔")
                                </div>
                                <div class="flex-1">
                                    <p class="text-xs font-bold text-gray-800 dark:text-gray-200 line-clamp-1">@notif.Title</p>
                                    <p class="text-xs text-gray-600 dark:text-gray-400 mt-0.5 line-clamp-2">@notif.Message</p>
                                    <span class="text-[10px] text-gray-400 mt-1 block">@GetTimeAgo(notif.CreatedAt)</span>
                                </div>
                                @if (!notif.IsRead)
                                {
                                    <div class="self-center">
                                        <div class="h-2 w-2 rounded-full bg-primary-500"></div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-8 text-center text-gray-400">
                        <span class="text-2xl block mb-2 opacity-50">📭</span>
                        <span class="text-xs">Không có thông báo mới</span>
                    </div>
                }
            </div>
            
            <div class="p-2 border-t border-gray-100 dark:border-gray-700 bg-gray-50/50 text-center">
                <button class="text-xs text-gray-500 hover:text-gray-700 font-medium w-full py-1" @onclick="LoadNotifications">
                    Làm mới
                </button>
            </div>
        </div>
        
        <!-- Backdrop to close -->
        <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>
    }
</div>

<style>
    .animate-scale-in { animation: scaleIn 0.1s ease-out; transform-origin: top right; }
    @@keyframes scaleIn { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
</style>

@code {
    private bool _isOpen;
    private List<NotificationResponse> Notifications = new();
    private int UnreadCount => Notifications.Count(n => !n.IsRead);
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity?.IsAuthenticated ?? false)
        {
            return;
        }

        NotificationService.OnChange += StateHasChanged;
        await LoadNotifications();
        
        // Poll every 30 seconds
        _timer = new System.Threading.Timer(async _ => 
        {
            await InvokeAsync(async () => 
            {
                await LoadNotifications();
                StateHasChanged();
            });
        }, null, 30000, 30000);
    }

    private async Task LoadNotifications()
    {
        Notifications = await NotificationService.GetNotificationsAsync();
    }

    private void ToggleDropdown() => _isOpen = !_isOpen;
    private void CloseDropdown() => _isOpen = false;

    private async Task HandleClick(NotificationResponse notif)
    {
        if (!notif.IsRead)
        {
            await NotificationService.MarkAsReadAsync(notif.Id);
            notif.IsRead = true; // Optimistic update
        }
        
        // Navigate based on type
        // Currently we don't have deep links logic fully centralized but assuming Home handles filters
        // For TaskAssignment, redirection logic could be complex (e.g. open modal).
        // For now, simple redirect to Home or refresh logic.
        // Or if ReferenceId is TaskId...
        
        _isOpen = false; 
    }

    private async Task MarkAllAsRead()
    {
        // Not optimal to loop one by one but API MarkAll not implemented yet in Frontend Service.
        // Wait, did I implement MarkAll in Backend? No, only individual.
        // Plan said MarkAll but I verified MarkAsReadFeature (Individual).
        // I'll implement loop for now.
        foreach (var n in Notifications.Where(x => !x.IsRead))
        {
            await NotificationService.MarkAsReadAsync(n.Id);
            n.IsRead = true;
        }
    }

    private string GetTimeAgo(DateTime date)
    {
        var span = DateTime.UtcNow - date;
        if (span.TotalMinutes < 1) return "Vừa xong";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} phút trước";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} giờ trước";
        return date.ToString("dd/MM");
    }

    public void Dispose()
    {
        NotificationService.OnChange -= StateHasChanged;
        _timer?.Dispose();
    }
}
