@using ADHDChecklist.Client.Shared.Models
@using ADHDChecklist.Client.Features.Dashboard.Services

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }
    
    .timeline-container {
        position: relative;
        /* Start mapping: 06:00 to 24:00 = 18 hours */
        /* 1 hour = 120px (2px per minute for "larger" view) */
        height: @(18 * 60 * 2)px; 
    }

    .time-marker-label {
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum";
    }
</style>

<div class="bg-white rounded-lg shadow-sm border border-gray-100 flex flex-col h-full overflow-hidden">
    <div class="p-4 border-b border-gray-50 flex items-center justify-between flex-shrink-0 z-20 bg-white relative shadow-sm">
        <h3 class="text-sm font-bold text-gray-800 flex items-center gap-2">
            <span class="text-indigo-500">📅</span>
            <span>Lịch trình chi tiết</span>
        </h3>
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">@_selectedDate.ToString("dd/MM")</span>
    </div>

    <div class="flex-1 overflow-y-auto custom-scrollbar relative bg-white">
        <div class="timeline-container w-full">
            
            @{
                var startHour = 6;
                var endHour = 24;
                var totalMinutes = (endHour - startHour) * 60;
                var pixelsPerMinute = 2; // 120px per hour
            }

            <!-- 1. Background Grid & Drop Zones -->
            <div class="absolute inset-0 z-0 @(FocusedTaskId.HasValue ? "blur-sm grayscale opacity-40 transition-all duration-500" : "transition-all duration-300")">
                @for (int i = 0; i < (endHour - startHour) * 2; i++) // 30-min chunks
                {
                    var minutesFromStart = i * 30;
                    var time = new TimeOnly(startHour, 0).AddMinutes(minutesFromStart);
                    var top = minutesFromStart * pixelsPerMinute;
                    var height = 30 * pixelsPerMinute;
                    var isHour = i % 2 == 0;

                    <!-- Time Slot Row -->
                    <div class="absolute w-full border-b border-gray-100/80 box-border flex group"
                         style="top: @(top)px; height: @(height)px;"
                         ondragover="event.preventDefault();"
                         @ondrop="() => HandleDrop(time)">
                        
                        <!-- Left Time Label -->
                        <div class="w-14 flex-shrink-0 border-r border-gray-100/80 bg-gray-50/30 flex flex-col items-end pr-2 pt-1 select-none">
                            @if (isHour)
                            {
                                <span class="text-xs font-bold text-gray-800 time-marker-label transform -translate-y-1/2">@time.ToString("HH:mm")</span>
                            }
                            else
                            {
                                <span class="text-[10px] text-gray-400 time-marker-label opacity-0 group-hover:opacity-100 transition-opacity transform -translate-y-1/2">@time.ToString("mm")</span>
                            }
                        </div>

                        <!-- Drop Zone Visual -->
                        <div class="flex-1 relative transition-colors @(_dragState.DraggedTask != null ? "group-hover:bg-indigo-50/40" : "")">
                            <!-- Half-hour dashed line for guidance -->
                            @if (!isHour) {
                                <div class="absolute w-full border-t border-dashed border-gray-100 top-0 left-0"></div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- 2. Tasks Layer (Absolute Positioning) -->
            <div class="absolute inset-0 z-10 pointer-events-none pl-14 pr-1">
                <!-- Current Time Indicator -->
                @if (_selectedDate == DateOnly.FromDateTime(DateTime.Now))
                {
                    var now = TimeOnly.FromDateTime(DateTime.Now);
                    if (now.Hour >= startHour && now.Hour < endHour)
                    {
                        var nowMinutes = (now.Hour - startHour) * 60 + now.Minute;
                        var nowTop = nowMinutes * pixelsPerMinute;
                        <div class="absolute w-full border-t-2 border-red-500 z-50 flex items-center" style="top: @(nowTop)px;">
                            <div class="w-2 h-2 rounded-full bg-red-500 -ml-1"></div>
                        </div>
                    }
                }

                @foreach (var task in Tasks.Where(t => t.TimeBlockStart.HasValue))
                {
                     // Calculate precise position
                    var start = task.TimeBlockStart.Value;
                    if (start.Hour < startHour) continue; // Skip if before 6am (or handle gracefully)

                    var taskStartMinutes = (start.Hour - startHour) * 60 + start.Minute;
                    var taskDuration = task.Duration ?? 30;
                    
                    var top = taskStartMinutes * pixelsPerMinute;
                    var height = taskDuration * pixelsPerMinute;
                    
                    // FOCUS MODE LOGIC
                    var isFocused = FocusedTaskId.HasValue && FocusedTaskId == task.Id;
                    var isBlurred = FocusedTaskId.HasValue && FocusedTaskId != task.Id;

                    var focusClass = isFocused ? "z-50 ring-4 ring-indigo-500/50 shadow-2xl scale-105" : "";
                    var blurClass = isBlurred ? "opacity-30 blur-sm grayscale pointer-events-none" : "pointer-events-auto";
                    var baseClass = "absolute w-full px-1 transition-all duration-500 ease-in-out transform";

                    <div class="@baseClass @focusClass @blurClass"
                         style="top: @(top)px; height: @(height)px; min-height: 24px;"
                         draggable="@(FocusedTaskId == null ? "true" : "false")"
                         @ondragstart="() => HandleDragStart(task)"
                         @onclick="(e) => HandleTaskClick(task, e)">
                        
                        <div class="h-full w-full rounded-md border-l-4 shadow-sm @GetTaskBorderColor(task) @GetTaskBgColor(task) bg-opacity-90 backdrop-blur-sm border border-gray-200/60 p-2 overflow-hidden flex flex-col group/card hover:shadow-md cursor-pointer active:scale-[0.98]">
                            
                            <!-- Header: Title & Priority -->
                            <div class="flex justify-between items-start gap-1">
                                <div class="font-bold text-xs text-gray-800 leading-tight line-clamp-2">
                                    @task.Title
                                </div>
                                @if (task.Priority > 1) { 
                                    <span class="text-[10px] font-black text-red-500 shrink-0">@string.Concat(Enumerable.Repeat("!", task.Priority-1))</span> 
                                }
                            </div>

                            <!-- Meta: Time Range & Category -->
                            @if (!isBlurred) {
                                <div class="flex items-center gap-2 mt-0.5 text-[10px] opacity-80">
                                    <span class="font-medium text-indigo-700 bg-indigo-50/80 px-1 rounded">
                                        @start.ToString("HH:mm") - @start.AddMinutes(taskDuration).ToString("HH:mm")
                                    </span>
                                    @if (!string.IsNullOrEmpty(task.CategoryName))
                                    {
                                        <span class="flex items-center gap-1 truncate text-gray-600">
                                            <span class="w-1.5 h-1.5 rounded-full" style="background-color: @task.CategoryColor"></span>
                                            @task.CategoryName
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Drag Preview (Ghost) -->
                 @if (_dragState.DraggedTask != null)
                 {
                 }
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] public DragDropState _dragState { get; set; }

    [Parameter] public List<TaskResponse> Tasks { get; set; } = new();
    [Parameter] public DateOnly _selectedDate { get; set; } = DateOnly.FromDateTime(DateTime.Now);
    [Parameter] public Guid? FocusedTaskId { get; set; } // New Param
    [Parameter] public EventCallback<Guid> OnToggleComplete { get; set; }
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<(TaskResponse task, TimeOnly startTime)> OnTaskDropped { get; set; }
    [Parameter] public EventCallback<(TaskResponse task, double x, double y)> OnTaskClick { get; set; }

    private async Task HandleTaskClick(TaskResponse task, MouseEventArgs e)
    {
        if (FocusedTaskId.HasValue && FocusedTaskId != task.Id) return; // Prevent clicking others when focused
        await OnTaskClick.InvokeAsync((task, e.ClientX, e.ClientY));
    }
    private void HandleDragStart(TaskResponse task)
    {
        _dragState.DraggedTask = task;
    }

    private async Task HandleDrop(TimeOnly time)
    {
        if (_dragState.DraggedTask != null)
        {
            await OnTaskDropped.InvokeAsync((_dragState.DraggedTask, time));
            _dragState.DraggedTask = null;
        }
    }

    private string GetTaskBorderColor(TaskResponse task)
    {
        if (task.IsCompleted) return "border-green-400";
        return task.Priority switch
        {
            3 => "border-red-500",
            2 => "border-orange-400",
            _ => "border-indigo-400"
        };
    }

    private string GetTaskBgColor(TaskResponse task)
    {
        if (task.IsCompleted) return "bg-gray-50";
        return "bg-white";
    }
}