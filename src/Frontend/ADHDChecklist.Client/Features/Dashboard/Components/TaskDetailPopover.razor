@using ADHDChecklist.Client.Shared.Models
@using ADHDChecklist.Client.Features.Dashboard.Services
@inject IJSRuntime JS
@inject ITaskService TaskService

@if (Task != null)
{
    <!-- Invisible overlay to close when clicking outside -->
    <div class="fixed inset-0 z-40" @onclick="OnClose"></div>

    <div class="fixed z-50 w-[400px] bg-white rounded-xl shadow-2xl border border-gray-100 flex flex-col overflow-hidden animate-fade-in-up"
         style="top: @(AdjustedTop)px; left: @(AdjustedLeft)px;">
        
        <!-- Header -->
        <div class="bg-gray-50/50 p-3 flex justify-between items-center border-b border-gray-100">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-primary-100 text-primary-700 border border-primary-200">
                Task
            </span>
            @if (Task.IsMandatory)
            {
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-red-100 text-red-700 border border-red-200 ml-2 animate-pulse">
                    ⚠️ BẮT BUỘC
                </span>
            }
            <div class="flex items-center gap-1">
                <button @onclick="() => OnEdit.InvokeAsync(Task.Id)" class="p-1.5 hover:bg-white rounded-md text-gray-500 hover:text-primary-600 transition-colors" title="Chỉnh sửa toàn bộ">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                </button>
                <button @onclick="() => OnDelete.InvokeAsync(Task.Id)" class="p-1.5 hover:bg-white rounded-md text-gray-500 hover:text-red-600 transition-colors" title="Xóa">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
                <button @onclick="OnClose" class="p-1.5 hover:bg-white rounded-md text-gray-400 hover:text-gray-700 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>

        <!-- Body -->
        <div class="p-5 flex-1 overflow-y-auto min-h-0">
            @if (Task.AssignmentStatus == "Pending" && IsAssignedToMe)
            {
                <div class="mb-4 bg-blue-50 border border-blue-100 p-3 rounded-lg flex flex-col gap-2">
                    <div class="flex items-center gap-2 text-blue-800">
                        <span class="text-lg">👋</span>
                        <p class="text-xs font-bold leading-tight">
                            Người thân đã gán việc này cho bạn.
                        </p>
                    </div>
                    <div class="mt-2"> <!-- Container for actions -->
                        @if (_showRejectionReasonInput)
                        {
                            <div class="animate-fade-in-up">
                                <textarea @bind="_rejectionReason" 
                                          class="w-full text-xs p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none mb-2" 
                                          placeholder="Nhập lý do từ chối (Ví dụ: Đang bận...)" 
                                          rows="2"></textarea>
                                <div class="flex gap-2">
                                     <button @onclick="@(async () => await Respond("Rejected", _rejectionReason))" 
                                             class="flex-1 bg-red-600 hover:bg-red-700 text-white text-xs font-bold py-1.5 rounded-md transition-colors disabled:opacity-50"
                                             disabled="@string.IsNullOrWhiteSpace(_rejectionReason)">
                                        Gửi từ chối
                                    </button>
                                    <button @onclick="CancelRejection" class="px-3 bg-white border border-gray-300 text-gray-600 text-xs font-bold py-1.5 rounded-md hover:bg-gray-50 transition-colors">
                                        Hủy
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="flex gap-2">
                                <button @onclick="@(async () => await Respond("Accepted"))" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold py-1.5 rounded-md cursor-pointer transition-colors shadow-sm">
                                    @(Task.IsMandatory ? "Chấp nhận (Bắt buộc)" : "Chấp nhận")
                                </button>
                                @if (!Task.IsMandatory)
                                {
                                    <button @onclick="ShowRejectionInput" class="flex-1 bg-white hover:bg-red-50 text-red-600 border border-red-200 text-xs font-bold py-1.5 rounded-md cursor-pointer transition-colors">
                                        Từ chối
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Task.AssignmentStatus == "Rejected")
            {
                <div class="mb-4 bg-red-50 border border-red-100 p-3 rounded-lg flex flex-col gap-1 text-red-800">
                     <div class="flex items-center gap-2">
                         <span class="text-lg">🚫</span>
                         <p class="text-xs font-bold">Việc này đã bị từ chối.</p>
                     </div>
                     @if (!string.IsNullOrEmpty(Task.RejectionReason))
                     {
                         <p class="text-xs italic pl-7 text-red-600">"@Task.RejectionReason"</p>
                     }
                </div>
            }

            @if (Task.CompletionApprovalStatus == "ReworkRequested")
            {
                <div class="mb-4 bg-red-50 border border-red-100 p-3 rounded-lg flex flex-col gap-1 text-red-800 animate-pulse">
                     <div class="flex items-center gap-2">
                         <span class="text-lg">⚠️</span>
                         <p class="text-xs font-bold">Việc này cần làm lại!</p>
                     </div>
                     <p class="text-xs">Hãy thực hiện lại và bấm hoàn thành để gửi duyệt.</p>
                </div>
            }
            else if (Task.CompletionApprovalStatus == "Pending")
            {
                <div class="mb-4 bg-yellow-50 border border-yellow-100 p-3 rounded-lg flex items-center gap-2 text-yellow-800">
                     <span class="text-lg">⏳</span>
                     <p class="text-xs font-bold">Đang chờ phụ huynh duyệt...</p>
                </div>
            }

            <div class="flex items-start gap-3 mb-4">
            @if (CanComplete)
            {
                <div class="mt-1 flex-shrink-0">
                    <div class="w-5 h-5 rounded-full border-2 cursor-pointer flex items-center justify-center transition-colors @(Task.IsCompleted ? "border-green-500 bg-green-500" : "border-gray-300 hover:border-primary-500")"
                         @onclick="() => OnToggleComplete.InvokeAsync(Task.Id)">
                        @if (Task.IsCompleted)
                        {
                            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        }
                    </div>
                </div>
            }
            else
            {
                 <!-- Placeholder to keep alignment or just nothing? -->
                 <!-- User requested "Status only". If we remove this, title shifts left. That is probably preferred. -->
            }
                <div class="flex-1 min-w-0">
                    <h3 class="font-bold text-gray-900 text-lg leading-tight break-words @(Task.IsCompleted ? "line-through text-gray-400" : "")">@Task.Title</h3>
                    
                    @if (!string.IsNullOrEmpty(_userDescription))
                    {
                        <p class="text-sm text-gray-600 mt-2 whitespace-pre-wrap break-words">@_userDescription</p>
                    }
                    
                    @if (_magicBreakdownItems.Any())
                    {
                        <div class="mt-3 bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl border border-purple-100 p-3">
                            <h4 class="text-xs font-bold text-purple-700 flex items-center gap-1.5 mb-2">
                                <span class="text-base">✨</span> Magic Breakdown
                            </h4>
                            <ul class="space-y-2">
                                @foreach (var item in _magicBreakdownItems)
                                {
                                    <li class="flex items-start gap-2 text-sm text-gray-700">
                                        <div class="mt-1 w-1.5 h-1.5 rounded-full bg-purple-400 flex-shrink-0"></div>
                                        <span class="leading-snug">@item</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>

            <div class="space-y-3">
                <!-- Time Info -->
                <div class="flex items-center gap-3 text-sm text-gray-700 bg-gray-50 p-2.5 rounded-lg border border-gray-100">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <div class="flex-1 font-medium">
                        @if (Task.TimeBlockStart.HasValue)
                        {
                            <span>@Task.TimeBlockStart.Value.ToString("HH:mm")</span>
                            <span class="mx-1 text-gray-400">-</span>
                            <span>@Task.TimeBlockStart.Value.AddMinutes(Task.Duration ?? 30).ToString("HH:mm")</span>
                        }
                        else
                        {
                            <span class="italic text-gray-400">Chưa xếp lịch</span>
                        }
                    </div>
                    <span class="text-xs font-bold text-primary-600 bg-primary-50 px-2 py-0.5 rounded">@(Task.Duration ?? 30) phút</span>
                </div>

                <!-- Category -->
                @if (!string.IsNullOrEmpty(Task.CategoryName))
                {
                    <div class="flex items-center gap-3 text-sm text-gray-600 px-2">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full" style="background-color: @Task.CategoryColor"></span>
                            <span>@Task.CategoryName</span>
                        </div>
                    </div>
                }
            </div>

    <!-- Footer / More Actions -->
            <div class="mt-5 pt-3 border-t border-gray-50 flex justify-between gap-2">
                 <button @onclick="() => OnFocus.InvokeAsync(Task.Id)" class="flex-1 px-3 py-1.5 bg-primary-50 text-primary-700 text-xs font-bold rounded-lg hover:bg-primary-100 transition-colors flex items-center justify-center gap-1 group/btn">
                    <span class="group-hover/btn:scale-110 transition-transform">🎯</span> Tập trung
                    @if (!IsPremium) { <span class="ml-1 text-[9px] bg-white px-1 rounded border border-primary-200">SOFT</span> }
                </button>
                @if (!Task.IsCompleted)
                {
                    @if (IsPremium)
                    {
                        <button @onclick="() => OnMagicBreakdown.InvokeAsync(Task.Id)" class="px-3 py-1.5 bg-gradient-to-r from-purple-50 to-pink-50 text-purple-700 text-xs font-bold rounded-lg hover:from-purple-100 hover:to-pink-100 transition-colors flex items-center justify-center gap-1 group/magic border border-purple-100" title="AI Magic Breakdown">
                            <span class="group-hover/magic:animate-spin">✨</span> AI
                        </button>
                    }
                    else
                    {
                        <button @onclick="OnUpgradeClicked" class="px-3 py-1.5 bg-gray-50 text-gray-400 text-xs font-bold rounded-lg hover:bg-gray-100 transition-colors flex items-center justify-center gap-1 border border-gray-200" title="Nâng cấp để dùng AI">
                            <span>🔒</span> AI
                        </button>
                    }
                }
                <button @onclick="() => OnEdit.InvokeAsync(Task.Id)" class="px-3 py-1.5 bg-white border border-gray-200 text-gray-600 text-xs font-bold rounded-lg hover:bg-gray-50 transition-colors">
                    Chi tiết
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public TaskResponse? Task { get; set; }
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleComplete { get; set; }
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnFocus { get; set; }
    [Parameter] public EventCallback<Guid> OnMagicBreakdown { get; set; }
    [Parameter] public bool IsPremium { get; set; }
    [Parameter] public EventCallback OnUpgradeClicked { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public EventCallback OnRespondSuccess { get; set; }

    private bool IsAssignedToMe => !string.IsNullOrEmpty(CurrentUserId) && 
                                   Task != null && 
                                   Task.AssignedUserId.HasValue && 
                                   Task.AssignedUserId.HasValue && 
                                   string.Equals(Task.AssignedUserId.ToString(), CurrentUserId, StringComparison.OrdinalIgnoreCase);

    private bool CanComplete => Task != null && (
        Task.AssignedUserId == null || 
        (CurrentUserId != null && string.Equals(Task.AssignedUserId.ToString(), CurrentUserId, StringComparison.OrdinalIgnoreCase))
    );
    
    private string _userDescription = "";
    private List<string> _magicBreakdownItems = new();
    
    // Rejection State
    private bool _showRejectionReasonInput = false;
    private string _rejectionReason = "";

    private async Task Respond(string status, string? reason = null)
    {
        if (Task == null) return;
        var success = await TaskService.RespondAssignmentAsync(Task.Id, status, reason);
        if (success)
        {
            await OnRespondSuccess.InvokeAsync();
            await OnClose.InvokeAsync();
        }
    }
    
    private void ShowRejectionInput()
    {
        _showRejectionReasonInput = true;
    }
    
    private void CancelRejection()
    {
        _showRejectionReasonInput = false;
        _rejectionReason = "";
    }

    protected override void OnParametersSet()
    {
        // Reset state when task changes (or Popover opens)
        _showRejectionReasonInput = false;
        _rejectionReason = "";
        ParseDescription();
    }

    private void ParseDescription()
    {
        _userDescription = "";
        _magicBreakdownItems = new();

        if (Task == null || string.IsNullOrWhiteSpace(Task.Description)) return;
        
        // ... (Keep existing simple logic if possible, or simplified version for diff)
        var parts = Task.Description.Split(new[] { "**✨ Magic Breakdown:**" }, StringSplitOptions.None);
        _userDescription = parts[0].Trim();

        if (parts.Length > 1)
        {
            var breakdownText = parts[1];
             var lines = breakdownText.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
            foreach (var line in lines)
            {
                var cleaned = line.Trim();
                if (cleaned.StartsWith("- [ ]") || cleaned.StartsWith("- [x]") || cleaned.StartsWith("-"))
                {
                    cleaned = cleaned.Replace("- [ ]", "").Replace("- [x]", "").Replace("-", "").Trim();
                    if (!string.IsNullOrWhiteSpace(cleaned))
                    {
                        _magicBreakdownItems.Add(cleaned);
                    }
                }
            }
        }
    }

    // Clamp to screen
    private double AdjustedLeft => Math.Min(Math.Max(X + 20, 10), 1920 - 420); // Width approx 400 + padding
    private double AdjustedTop => Math.Min(Math.Max(Y - 100, 10), 900); // Rough clamping
}

<style>
    .animate-fade-in-up {
        animation: fadeInUp 0.2s ease-out forwards;
    }
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
</style>
