@using ADHDChecklist.Client.Shared.Models

<div class="flex items-start gap-3 p-4 bg-white dark:bg-gray-800 border-gray-100 dark:border-gray-700 rounded-lg hover:shadow-md transition-shadow @(_isCompleted ? "opacity-60" : "")">
    <!-- Checkbox -->
    <button @onclick="HandleToggleComplete"
            class="mt-1 flex-shrink-0">
        @if (_isCompleted)
        {
            <svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
        }
        else
        {
            <svg class="w-6 h-6 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
            </svg>
        }
    </button>

    <!-- Content -->
    <div class="flex-1 min-w-0">
        <div class="flex items-start justify-between gap-2">
            <div class="flex-1">
                <!-- Title -->
                <h4 class="font-medium text-gray-900 @(_isCompleted ? "line-through" : "")">
                    @Task.Title
                </h4>

                <!-- Time & Category -->
                <div class="flex items-center gap-3 mt-1 text-sm text-gray-500">
                    @if (Task.TimeBlockStart.HasValue && Task.TimeBlockEnd.HasValue)
                    {
                        <span class="flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            @Task.TimeBlockStart.Value.ToString("HH:mm") - @Task.TimeBlockEnd.Value.ToString("HH:mm")
                        </span>
                    }

                    @if (!string.IsNullOrEmpty(Task.CategoryName))
                    {
                        <span class="flex items-center gap-1">
                            <span class="w-3 h-3 rounded-full" style="background-color: @Task.CategoryColor"></span>
                            @Task.CategoryName
                        </span>
                    }

                    @if (Task.Priority > 1)
                    {
                        <span class="flex items-center gap-1 text-red-600">
                            @for (int i = 0; i < Task.Priority; i++)
                            {
                                <span>!</span>
                            }
                        </span>
                    }
                </div>

                <!-- Description -->
                @if (!string.IsNullOrEmpty(Task.Description))
                {
                    <p class="mt-2 text-sm text-gray-600">
                        @Task.Description
                    </p>
                }
            </div>

            <!-- Actions -->
            <div class="flex gap-1 flex-shrink-0">
                 <button @onclick="HandleAiBreakdown"
                        class="p-1 text-purple-400 hover:text-purple-600 rounded"
                        title="Chia nhỏ công việc bằng AI">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                </button>
                <button @onclick="HandleEdit"
                        class="p-1 text-gray-400 hover:text-primary-600 rounded">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                </button>
                <button @onclick="HandleDelete"
                        class="p-1 text-gray-400 hover:text-red-600 rounded">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public TaskResponse Task { get; set; } = null!;
    [Parameter] public EventCallback<Guid> OnToggleComplete { get; set; }
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnAiBreakdown { get; set; }

    private bool _isCompleted => Task.IsCompleted;

    private async Task HandleToggleComplete()
    {
        await OnToggleComplete.InvokeAsync(Task.Id);
    }

    private async Task HandleEdit()
    {
        await OnEdit.InvokeAsync(Task.Id);
    }

    private async Task HandleDelete()
    {
        await OnDelete.InvokeAsync(Task.Id);
    }

    private async Task HandleAiBreakdown()
    {
        await OnAiBreakdown.InvokeAsync(Task.Id);
    }
}