@using ADHDChecklist.Client.Shared.Models
@using ADHDChecklist.Client.Features.Dashboard.Services
@inject ITaskService TaskService

<!-- Modal Overlay -->
<div class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4" @onclick="Close">
    <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto" @onclick:stopPropagation>
        <!-- Header -->
        <div class="flex items-center justify-between p-6 border-b">
            <h3 class="text-xl font-semibold text-gray-900">Chỉnh sửa công việc</h3>
            <button @onclick="Close" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        @if (_isLoading)
        {
            <div class="p-8 text-center">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600 mx-auto"></div>
                <p class="mt-4 text-gray-600">Đang tải...</p>
            </div>
        }
        else
        {
            <!-- Form -->
            <EditForm Model="@_model" OnValidSubmit="HandleSubmit" class="p-6">
                <DataAnnotationsValidator />

                <div class="space-y-4">
                    <!-- Title -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Tiêu đề <span class="text-red-500">*</span>
                        </label>
                        <InputText @bind-Value="_model.Title"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                   placeholder="VD: Họp team buổi sáng" />
                        <ValidationMessage For="@(() => _model.Title)" class="text-red-500 text-sm mt-1" />
                    </div>

                    <!-- Description -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Mô tả</label>
                        <InputTextArea @bind-Value="_model.Description"
                                       rows="3"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                       placeholder="Thêm chi tiết..." />
                    </div>

                    <!-- Category -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Category</label>
                        <InputSelect @bind-Value="_model.CategoryId"
                                     class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                            <option value="">-- Không chọn --</option>
                            @foreach (var category in Categories)
                            {
                                <option value="@category.Id">@category.Icon @category.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <!-- Date -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Ngày thực hiện</label>
                        <InputText @bind-Value="_model.ScheduledDate"
                                   type="date"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                    </div>

                    <!-- Time Blocks -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Giờ bắt đầu</label>
                            <InputText @bind-Value="_model.TimeStart"
                                       type="time"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Giờ kết thúc</label>
                            <InputText @bind-Value="_model.TimeEnd"
                                       type="time"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" />
                        </div>
                    </div>

                    <!-- Priority -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Độ ưu tiên</label>
                        <div class="flex gap-2">
                            @for (int i = 1; i <= 3; i++)
                            {
                                var priority = i;
                                <button type="button"
                                        @onclick="() => _model.Priority = priority"
                                        class="flex-1 py-2 px-4 border rounded-lg transition-colors @(_model.Priority == priority ? "bg-indigo-600 text-white border-indigo-600" : "bg-white text-gray-700 border-gray-300 hover:bg-gray-50")">
                                    @GetPriorityLabel(priority)
                                </button>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
                            <p class="text-sm text-red-600">@_errorMessage</p>
                        </div>
                    }
                </div>

                <!-- Actions -->
                <div class="flex gap-3 mt-6 pt-6 border-t">
                    <button type="button"
                            @onclick="Close"
                            class="flex-1 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50">
                        Hủy
                    </button>
                    <button type="submit"
                            disabled="@_isSubmitting"
                            class="flex-1 px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 disabled:opacity-50">
                        @if (_isSubmitting)
                        {
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <span>Lưu thay đổi</span>
                        }
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public Guid TaskId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnTaskUpdated { get; set; }
    [Parameter] public List<CategoryResponse> Categories { get; set; } = new();

    private TaskFormModel _model = new();
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _errorMessage;

    private class TaskFormModel
    {
        [Required(ErrorMessage = "Tiêu đề là bắt buộc")]
        [MaxLength(200)]
        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }
        public string? CategoryId { get; set; }
        public string ScheduledDate { get; set; } = string.Empty;
        public string? TimeStart { get; set; }
        public string? TimeEnd { get; set; }
        public int Priority { get; set; } = 1;
        public bool IsCompleted { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTaskData();
    }

    private async Task LoadTaskData()
    {
        _isLoading = true;
        try
        {
            var task = await TaskService.GetTaskByIdAsync(TaskId);
            if (task != null)
            {
                _model.Title = task.Title;
                _model.Description = task.Description;
                _model.CategoryId = task.CategoryId?.ToString() ?? "";
                _model.ScheduledDate = task.ScheduledDate.ToString("yyyy-MM-dd");
                _model.TimeStart = task.TimeBlockStart?.ToString("HH:mm");
                _model.TimeEnd = task.TimeBlockEnd?.ToString("HH:mm");
                _model.Priority = task.Priority;
                _model.IsCompleted = task.IsCompleted;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Không thể tải thông tin task: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var scheduledDate = DateOnly.Parse(_model.ScheduledDate);
            TimeOnly? timeStart = string.IsNullOrEmpty(_model.TimeStart) ? null : TimeOnly.Parse(_model.TimeStart);
            TimeOnly? timeEnd = string.IsNullOrEmpty(_model.TimeEnd) ? null : TimeOnly.Parse(_model.TimeEnd);
            Guid? categoryId = string.IsNullOrEmpty(_model.CategoryId) ? null : Guid.Parse(_model.CategoryId);

            int? duration = null;
            if (timeStart.HasValue && timeEnd.HasValue)
            {
                duration = (int)(timeEnd.Value.ToTimeSpan() - timeStart.Value.ToTimeSpan()).TotalMinutes;
            }

            var request = new UpdateTaskRequest(
                _model.Title,
                _model.Description,
                categoryId,
                scheduledDate,
                timeStart,
                timeEnd,
                duration,
                _model.Priority,
                _model.IsCompleted
            );

            await TaskService.UpdateTaskAsync(TaskId, request);
            await OnTaskUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Có lỗi xảy ra khi cập nhật: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private string GetPriorityLabel(int priority) => priority switch
    {
        1 => "Thấp",
        2 => "Trung bình",
        3 => "Cao",
        _ => "Thấp"
    };
}