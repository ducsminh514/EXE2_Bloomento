@using ADHDChecklist.Client.Shared.Models
@using ADHDChecklist.Client.Features.Dashboard.Services
@inject ITaskService TaskService

<!-- Modal Overlay -->
<div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-fade-in" @onclick="Close">
    <!-- Card Content -->
    <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden flex flex-col animate-scale-up" @onclick:stopPropagation>
        
        @if (_isLoading)
        {
            <div class="p-8 flex flex-col items-center justify-center text-indigo-600">
                <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-current mb-2"></div>
                <span class="text-xs font-bold uppercase tracking-wider">Đang tải...</span>
            </div>
        }
        else
        {
            <EditForm Model="@_model" OnValidSubmit="HandleSubmit" class="flex flex-col h-full">
                <DataAnnotationsValidator />

                <!-- Header: Title Input (Document Style) -->
                <div class="px-6 pt-6 pb-2">
                    <InputText @bind-Value="_model.Title"
                               class="w-full text-xl font-bold text-gray-900 placeholder-gray-400 border-none p-0 focus:ring-0"
                               placeholder="Tên công việc là gì?" />
                    <ValidationMessage For="@(() => _model.Title)" class="text-red-500 text-xs mt-1" />
                </div>

                <!-- Body: Compact Settings -->
                <div class="px-6 pb-4 space-y-4">
                    
                    <!-- Row 1: Time & Date (Compact Grid) -->
                    <div class="flex gap-4">
                        <div class="flex-1 space-y-1">
                            <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Ngày</label>
                            <InputText @bind-Value="_model.ScheduledDate" type="date"
                                       class="w-full text-sm font-medium text-gray-700 bg-gray-50 border-gray-100 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" />
                        </div>
                        <div class="flex-[1.5] flex gap-2">
                            <div class="flex-1 space-y-1">
                                <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Bắt đầu</label>
                                <InputText @bind-Value="_model.TimeStart" type="time"
                                           class="w-full text-sm font-medium text-gray-700 bg-gray-50 border-gray-100 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" />
                            </div>
                            <div class="flex-1 space-y-1">
                                <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Kết thúc</label>
                                <InputText @bind-Value="_model.TimeEnd" type="time"
                                           class="w-full text-sm font-medium text-gray-700 bg-gray-50 border-gray-100 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" />
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Description -->
                    <div>
                         <InputTextArea @bind-Value="_model.Description"
                                       rows="2"
                                       class="w-full text-sm text-gray-600 border-gray-200 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 resize-none placeholder-gray-400"
                                       placeholder="Thêm ghi chú..." />
                    </div>

                    <!-- Row 3: Meta (Category & Priority) -->
                    <div class="flex items-center gap-4 pt-2">
                        <!-- Category -->
                        <div class="flex-1">
                            <InputSelect @bind-Value="_model.CategoryId"
                                         class="w-full text-xs font-medium text-gray-700 bg-white border border-gray-200 rounded-full px-3 py-1.5 focus:ring-indigo-500 focus:border-indigo-500 shadow-sm">
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var category in Categories)
                                {
                                    <option value="@category.Id">@category.Icon @category.Name</option>
                                }
                            </InputSelect>
                        </div>

                         <!-- Priority (Pills) -->
                        <div class="flex bg-gray-100 p-1 rounded-full">
                             @for (int i = 1; i <= 3; i++)
                             {
                                 var p = i;
                                 <button type="button"
                                         @onclick="() => _model.Priority = p"
                                         class="px-3 py-1 text-[10px] font-bold rounded-full transition-all @(_model.Priority == p ? GetPriorityClass(p) : "text-gray-500 hover:text-gray-700")">
                                     @GetPriorityLabel(p)
                                 </button>
                             }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="text-xs text-red-500 font-medium bg-red-50 p-2 rounded">
                            ⚠️ @_errorMessage
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="bg-gray-50 px-6 py-3 flex justify-end gap-3 border-t border-gray-100">
                    <button type="button" @onclick="Close" class="text-sm font-bold text-gray-500 hover:text-gray-700 px-4 py-2">Thoát</button>
                    <button type="submit" disabled="@_isSubmitting"
                            class="text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-full px-6 py-2 shadow-sm hover:shadow-indigo-200/50 transition-all disabled:opacity-50">
                        @if(_isSubmitting) { <span>Đang lưu...</span> } else { <span>Lưu thay đổi</span> }
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

<style>
    .animate-fade-in { animation: fadeIn 0.15s ease-out; }
    .animate-scale-up { animation: scaleUp 0.15s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes scaleUp { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
</style>

@code {
    [Parameter] public Guid TaskId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnTaskUpdated { get; set; }
    [Parameter] public List<CategoryResponse> Categories { get; set; } = new();

    private TaskFormModel _model = new();
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _errorMessage;

    private class TaskFormModel
    {
        [Required(ErrorMessage = "Tiêu đề là bắt buộc")]
        [MaxLength(200)]
        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }
        public string? CategoryId { get; set; }
        public string ScheduledDate { get; set; } = string.Empty;
        public string? TimeStart { get; set; }
        public string? TimeEnd { get; set; }
        public int Priority { get; set; } = 1;
        public bool IsCompleted { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTaskData();
    }

    private async Task LoadTaskData()
    {
        _isLoading = true;
        try
        {
            var task = await TaskService.GetTaskByIdAsync(TaskId);
            if (task != null)
            {
                _model.Title = task.Title;
                _model.Description = task.Description;
                _model.CategoryId = task.CategoryId?.ToString() ?? "";
                _model.ScheduledDate = task.ScheduledDate.ToString("yyyy-MM-dd");
                _model.TimeStart = task.TimeBlockStart?.ToString("HH:mm");
                _model.TimeEnd = task.TimeBlockEnd?.ToString("HH:mm");
                _model.Priority = task.Priority;
                _model.IsCompleted = task.IsCompleted;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Không thể tải thông tin task: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var scheduledDate = DateOnly.Parse(_model.ScheduledDate);
            TimeOnly? timeStart = string.IsNullOrEmpty(_model.TimeStart) ? null : TimeOnly.Parse(_model.TimeStart);
            TimeOnly? timeEnd = string.IsNullOrEmpty(_model.TimeEnd) ? null : TimeOnly.Parse(_model.TimeEnd);
            Guid? categoryId = string.IsNullOrEmpty(_model.CategoryId) ? null : Guid.Parse(_model.CategoryId);

            int? duration = null;
            if (timeStart.HasValue && timeEnd.HasValue)
            {
                duration = (int)(timeEnd.Value.ToTimeSpan() - timeStart.Value.ToTimeSpan()).TotalMinutes;
            }

            var request = new UpdateTaskRequest(
                _model.Title,
                _model.Description,
                categoryId,
                scheduledDate,
                timeStart,
                timeEnd,
                duration,
                _model.Priority,
                _model.IsCompleted
            );

            await TaskService.UpdateTaskAsync(TaskId, request);
            await OnTaskUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Có lỗi xảy ra khi cập nhật: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private string GetPriorityLabel(int priority) => priority switch
    {
        1 => "Thấp",
        2 => "Trung bình",
        3 => "Cao",
        _ => "Thấp"
    };

    private string GetPriorityClass(int priority) => priority switch
    {
        3 => "bg-red-100 text-red-700 shadow-sm",
        2 => "bg-orange-100 text-orange-700 shadow-sm",
        _ => "bg-indigo-100 text-indigo-700 shadow-sm"
    };
}