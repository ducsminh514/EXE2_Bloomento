@using ADHDChecklist.Client.Shared.Models
@using ADHDChecklist.Client.Features.Dashboard.Services
@using ADHDChecklist.Client.Features.Family.Services
@inject ITaskService TaskService
@using System.ComponentModel.DataAnnotations
<!-- Modal Overlay -->
<div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-fade-in" @onclick="Close">
    <!-- Card Content -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden flex flex-col animate-scale-up" @onclick:stopPropagation>
        
        <EditForm Model="@_model" OnValidSubmit="HandleSubmit" class="flex flex-col h-full">
            <DataAnnotationsValidator />

            <!-- Header: Title Input (Document Style) -->
            <div class="px-6 pt-6 pb-2">
                <div class="flex gap-2">
                    <InputText @bind-Value="_model.Title"
                               class="flex-1 text-xl font-bold text-gray-900 placeholder-gray-400 border-none p-0 focus:ring-0"
                               placeholder="Bạn muốn làm gì?" />
                    
                    <button type="button" @onclick="HandleAutoBreakdown" disabled="@_isBreakingDown"
                            class="p-2 rounded-full hover:bg-purple-50 text-purple-600 transition-colors disabled:opacity-50"
                            title="Tự động chia nhỏ task (Magic Breakdown)">
                        @if (_isBreakingDown)
                        {
                            <div class="animate-spin h-5 w-5 border-2 border-purple-600 border-t-transparent rounded-full"></div>
                        }
                        else
                        {
                            <span class="text-xl">🪄</span>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => _model.Title)" class="text-red-500 text-xs mt-1" />
            </div>

            <!-- Body: Compact Settings -->
            <div class="px-6 pb-4 space-y-4">
                
                <!-- Row 1: Time & Date (Compact Grid) -->
                <div class="flex gap-4">
                    <div class="flex-1 space-y-1">
                        <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Ngày</label>
                        <InputText @bind-Value="_model.ScheduledDate" type="date"
                                   class="w-full text-sm font-medium text-gray-700 bg-gray-50 border-gray-100 rounded-lg focus:ring-primary-500 focus:border-primary-500" />
                    </div>
                    <div class="flex-[1.5] flex gap-2">
                        <div class="flex-1 space-y-1">
                            <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Bắt đầu</label>
                            <InputText @bind-Value="_model.TimeStart" type="time"
                                       class="w-full text-sm font-medium text-gray-700 bg-gray-50 border-gray-100 rounded-lg focus:ring-primary-500 focus:border-primary-500" />
                        </div>
                        <div class="flex-1 space-y-1">
                            <label class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">Kết thúc</label>
                            <InputText @bind-Value="_model.TimeEnd" type="time"
                                       class="w-full text-sm font-medium text-gray-700 bg-gray-50 border-gray-100 rounded-lg focus:ring-primary-500 focus:border-primary-500" />
                        </div>
                    </div>
                </div>

                <!-- Row 2: Description -->
                <div>
                     <InputTextArea @bind-Value="_model.Description"
                                   rows="5"
                                   class="w-full text-sm text-gray-600 border-gray-200 rounded-lg focus:ring-primary-500 focus:border-primary-500 resize-y placeholder-gray-400"
                                   placeholder="Thêm mô tả ngắn gọn..." />
                </div>

                <!-- Row 3: Meta (Category & Priority) -->
                <div class="flex items-center gap-4 pt-2">
                    <!-- Category -->
                    <div class="flex-1">
                        <InputSelect @bind-Value="_model.CategoryId"
                                     class="w-full text-xs font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-200 rounded-full px-3 py-1.5 focus:ring-primary-500 focus:border-primary-500 shadow-sm">
                            <option value="">-- Chọn danh mục --</option>
                            @foreach (var category in Categories)
                            {
                                <option value="@category.Id">@category.Icon @category.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <!-- Priority (Pills) -->
                    <div class="flex bg-gray-100 dark:bg-gray-700/50 p-1 rounded-full">
                         @for (int i = 1; i <= 3; i++)
                         {
                             var p = i;
                             <button type="button"
                                     @onclick="() => _model.Priority = p"
                                     class="px-3 py-1 text-[10px] font-bold rounded-full transition-all @(_model.Priority == p ? GetPriorityClass(p) : "text-gray-500 hover:text-gray-700")">
                                 @GetPriorityLabel(p)
                             </button>
                         }
                    </div>
                    
                    <!-- Assign To (Family) -->
                    @if (FamilyMembers.Any())
                    {
                        <div class="flex-1 flex gap-2">
                             <div class="flex-1">
                                <InputSelect @bind-Value="_model.AssignedUserId"
                                             class="w-full text-xs font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-200 rounded-full px-3 py-1.5 focus:ring-primary-500 focus:border-primary-500 shadow-sm">
                                    <option value="">-- Giao việc cho --</option>
                                    <option value="">(Tự làm)</option>
                                    @foreach (var member in FamilyMembers.Where(m => m.UserId.ToString() != CurrentUserId))
                                    {
                                        <option value="@member.UserId">👤 @member.FullName @(member.Nickname != null ? $"({member.Nickname})" : "")</option>
                                    }
                                </InputSelect>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(_model.AssignedUserId))
                            {
                                <label class="flex items-center gap-1.5 cursor-pointer bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300 px-3 py-1.5 rounded-full border border-red-100 dark:border-red-800/50 transition-all hover:bg-red-100 dark:hover:bg-red-900/30 whitespace-nowrap" title="Người được giao sẽ KHÔNG THỂ từ chối công việc này">
                                    <InputCheckbox @bind-Value="_model.IsMandatory" class="rounded text-red-600 focus:ring-red-500 border-red-300 w-3.5 h-3.5" />
                                    <span class="text-[10px] font-bold uppercase tracking-wide">Bắt buộc</span>
                                </label>
                            }
                        </div>
                    }
                </div>

                <!-- Row 4: Dopamine Type (Premium Visualization Data) -->
                <div class="bg-primary-50/50 dark:bg-primary-900/10 p-3 rounded-2xl border border-primary-100 dark:border-primary-800/50">
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-[10px] font-black text-primary-600 uppercase tracking-widest">Loại Dopamine</label>
                        <span class="text-[9px] font-bold text-primary-400">Dùng cho phân tích Premium</span>
                    </div>
                    <div class="flex gap-2">
                        <button type="button" @onclick='() => _model.DopamineType = "Low"'
                                class="flex-1 py-2 px-3 rounded-xl border-2 transition-all text-left @(_model.DopamineType == "Low" ? "border-primary-500 bg-white dark:bg-gray-800 shadow-sm" : "border-transparent bg-gray-100 dark:bg-gray-700/30 opacity-60")">
                            <span class="block text-[11px] font-black text-gray-700 dark:text-gray-200">Kỷ luật / Khó</span>
                            <span class="block text-[9px] text-gray-400 font-bold uppercase">Low Dopamine</span>
                        </button>
                        <button type="button" @onclick='() => _model.DopamineType = "High"'
                                class="flex-1 py-2 px-3 rounded-xl border-2 transition-all text-left @(_model.DopamineType == "High" ? "border-primary-500 bg-white dark:bg-gray-800 shadow-sm" : "border-transparent bg-gray-100 dark:bg-gray-700/30 opacity-60")">
                            <span class="block text-[11px] font-black text-gray-700 dark:text-gray-200">Sáng tạo / Mới</span>
                            <span class="block text-[9px] text-gray-400 font-bold uppercase">High Dopamine</span>
                        </button>
                    </div>
                </div>

                <!-- Row 5: Recurring Task (P2-1) -->
                <div class="flex items-center gap-3 px-1">
                    <label class="flex items-center gap-2 cursor-pointer group flex-1">
                        <div class="relative">
                            <InputCheckbox @bind-Value="_model.IsRecurring"
                                          class="sr-only peer" id="recurringCheck" />
                            <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary-500"></div>
                        </div>
                        <span class="text-xs font-bold text-gray-600 dark:text-gray-300 group-hover:text-primary-600 transition-colors">
                            🔁 Lặp lại
                        </span>
                    </label>

                    @if (_model.IsRecurring)
                    {
                        <div class="flex gap-1.5 animate-fade-in">
                            @foreach (var pattern in new[] { ("daily", "Hàng ngày"), ("weekdays", "Ngày thường"), ("weekly", "Hàng tuần") })
                            {
                                var p = pattern;
                                <button type="button" @onclick="() => _model.RecurrencePattern = p.Item1"
                                        class="text-[10px] font-bold px-2.5 py-1 rounded-full transition-all @(_model.RecurrencePattern == p.Item1 ? "bg-primary-500 text-white shadow-sm" : "bg-gray-100 text-gray-500 hover:bg-gray-200")">
                                    @p.Item2
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="text-xs font-medium bg-red-50 p-3 rounded-lg border border-red-100 flex items-start gap-2 animate-fade-in">
                        <span class="text-lg">⚠️</span>
                        <div class="flex-1">
                            <span class="text-red-600 block">@_errorMessage</span>
                            @if (_errorMessage.Contains("giới hạn") || _errorMessage.Contains("Premium") || _errorMessage.Contains("🔒"))
                            {
                                <button type="button" @onclick="OnUpgradeClicked" class="mt-1 text-[10px] font-bold text-white bg-gradient-to-r from-amber-400 to-orange-500 px-3 py-1 rounded-full shadow hover:scale-105 transition-transform">
                                    Nâng cấp Premium ngay 👑
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="bg-gray-50 px-6 py-3 flex justify-end gap-3 border-t border-gray-100">
                <button type="button" @onclick="Close" class="text-sm font-bold text-gray-500 hover:text-gray-700 px-4 py-2">Hủy</button>
                <button type="submit" disabled="@_isSubmitting"
                        class="text-sm font-bold text-white bg-primary-600 hover:bg-primary-700 rounded-full px-6 py-2 shadow-sm hover:shadow-primary-200/50 transition-all disabled:opacity-50">
                    @if(_isSubmitting) { <span>Đang lưu...</span> } else { <span>Tạo công việc</span> }
                </button>
            </div>
        </EditForm>
    </div>
</div>

<style>
    .animate-fade-in { animation: fadeIn 0.15s ease-out; }
    .animate-scale-up { animation: scaleUp 0.15s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes scaleUp { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
</style>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnTaskCreated { get; set; }
    [Parameter] public List<CategoryResponse> Categories { get; set; } = new();
    [Parameter] public DateOnly SelectedDate { get; set; }

    private TaskFormModel _model = new();
    private bool _isSubmitting;
    private bool _isBreakingDown;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        _model.ScheduledDate = SelectedDate.ToString("yyyy-MM-dd");
    }

    private async Task HandleAutoBreakdown()
    {
        if (string.IsNullOrWhiteSpace(_model.Title)) return;

        if (!IsPremium)
        {
            _errorMessage = "🔒 Tính năng phân tích AI chỉ dành cho gói Premium và Family.";
            return;
        }

        _isBreakingDown = true;
        try
        {
            var steps = await TaskService.BreakdownTaskAsync(_model.Title);
            if (steps.Any())
            {
                var checklist = string.Join("\n", steps.Select(s => $"- [ ] {s}"));
                
                if (!string.IsNullOrWhiteSpace(_model.Description))
                {
                    _model.Description += "\n\n### Các bước nhỏ (AI Suggestion):\n" + checklist;
                }
                else
                {
                    _model.Description = "### Các bước nhỏ (AI Suggestion):\n" + checklist;
                }
            }
            else
            {
                 // AI rejected the prompt (Guardrails triggered)
                 _errorMessage = "AI không thể phân tích task này. Vui lòng nhập task cụ thể hơn (Ví dụ: 'Dọn phòng', 'Học toán').";
                 StateHasChanged(); // Force UI update
            }
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Premium") || ex.Message.Contains("403"))
            {
                 _errorMessage = "🔒 Tính năng phân tích AI chỉ dành cho gói Premium và Family.";
            }
            else
            {
                _errorMessage = "Lỗi khi gọi AI: " + ex.Message;
            }
        }
        finally
        {
            _isBreakingDown = false;
        }
    }

    private class TaskFormModel
    {
        [Required(ErrorMessage = "Tiêu đề là bắt buộc")]
        [MaxLength(200)]
        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }
        public string? CategoryId { get; set; }
        public string ScheduledDate { get; set; } = string.Empty;
        public string? TimeStart { get; set; }
        public string? TimeEnd { get; set; }
        public int Priority { get; set; } = 1;
        public string DopamineType { get; set; } = "Low";
        public string? AssignedUserId { get; set; }
        public bool IsMandatory { get; set; }
        // P2-1: Recurring task fields
        public bool IsRecurring { get; set; } = false;
        public string RecurrencePattern { get; set; } = "daily";
    }

    [Parameter] public List<FamilyMemberResponse> FamilyMembers { get; set; } = new();
    [Parameter] public Guid? FamilyId { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public bool IsPremium { get; set; }
    [Parameter] public EventCallback OnUpgradeClicked { get; set; }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var scheduledDate = DateOnly.Parse(_model.ScheduledDate);
            TimeOnly? timeStart = string.IsNullOrEmpty(_model.TimeStart) ? null : TimeOnly.Parse(_model.TimeStart);
            TimeOnly? timeEnd = string.IsNullOrEmpty(_model.TimeEnd) ? null : TimeOnly.Parse(_model.TimeEnd);
            Guid? categoryId = string.IsNullOrEmpty(_model.CategoryId) ? null : Guid.Parse(_model.CategoryId);

            int? duration = null;
            if (timeStart.HasValue && timeEnd.HasValue)
            {
                duration = (int)(timeEnd.Value.ToTimeSpan() - timeStart.Value.ToTimeSpan()).TotalMinutes;
            }

            var request = new CreateTaskRequest(
                _model.Title,
                _model.Description,
                categoryId,
                scheduledDate,
                timeStart,
                timeEnd,
                duration,
                _model.Priority,
                _model.IsRecurring, // P2-1: Recurring task
                _model.IsRecurring ? _model.RecurrencePattern : null, // Pattern chỉ gửi khi IsRecurring
                _model.DopamineType,
                FamilyId,
                string.IsNullOrEmpty(_model.AssignedUserId) ? null : Guid.Parse(_model.AssignedUserId),
                !string.IsNullOrEmpty(_model.AssignedUserId), // IsShared if assigned
                _model.IsMandatory
            );

            await TaskService.CreateTaskAsync(request);
            await OnTaskCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Unlimited Tasks") || ex.Message.Contains("giới hạn"))
            {
                _errorMessage = "🔒 " + ex.Message.Replace("System.Exception:", "").Trim();
            }
            else
            {
                _errorMessage = "Có lỗi xảy ra: " + ex.Message;
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private string GetPriorityLabel(int priority) => priority switch
    {
        1 => "Thấp",
        2 => "Trung bình",
        3 => "Cao",
        _ => "Thấp"
    };

    private string GetPriorityClass(int priority) => priority switch
    {
        3 => "bg-red-100 text-red-700 shadow-sm",
        2 => "bg-orange-100 text-orange-700 shadow-sm",
        _ => "bg-primary-100 text-primary-700 shadow-sm"
    };
}