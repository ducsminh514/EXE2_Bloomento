@using ADHDChecklist.Client.Features.Preferences.Services
@inject IPreferencesService PreferencesService

<div class="space-y-4">
    <!-- Dark Mode Toggle -->
    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-xl border border-gray-200">
        <div class="flex items-center gap-2">
            <span class="text-xl">@(IsDark ? "🌙" : "☀️")</span>
            <span class="text-sm font-bold text-gray-700">Chế độ tối (Dark Mode)</span>
        </div>
        <button @onclick="ToggleDarkMode" class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors @(IsDark ? "bg-primary-600" : "bg-gray-200")">
            <span class="translate-x-1 inline-block h-4 w-4 transform rounded-full bg-white transition-transform @(IsDark ? "translate-x-6" : "translate-x-1")"></span>
        </button>
    </div>

    <!-- Theme Colors -->
    <div>
        <label class="text-xs font-bold text-gray-500 uppercase mb-2 block">Màu chủ đạo</label>
        <div class="grid grid-cols-6 gap-2">
            @foreach (var theme in _themes)
            {
                <button @onclick="() => SetTheme(theme.Key)"
                        class="aspect-square rounded-full border-2 transition-all hover:scale-110 flex items-center justify-center @(CurrentTheme == theme.Key ? $"border-{theme.ColorClass}-600 scale-110 ring-2 ring-{theme.ColorClass}-200" : "border-transparent bg-gray-100")"
                        title="@theme.DisplayName">
                    <div class="w-6 h-6 rounded-full @(theme.BgClass)"></div>
                </button>
            }
        </div>
    </div>
</div>

@code {
    private string CurrentTheme => PreferencesService.CurrentThemeColor;
    private bool IsDark => PreferencesService.CurrentThemeMode == "dark";

    private record ThemeOption(string Key, string DisplayName, string ColorClass, string BgClass);

    private List<ThemeOption> _themes = new()
    {
        new("indigo", "Mặc định (Indigo)", "indigo", "bg-indigo-500"),
        new("rose", "Hồng (Rose)", "rose", "bg-rose-500"),
        new("amber", "Cam (Amber)", "amber", "bg-amber-500"),
        new("emerald", "Xanh lá (Emerald)", "emerald", "bg-emerald-500"),
        new("sky", "Xanh trời (Sky)", "sky", "bg-sky-500"),
        new("violet", "Tím (Violet)", "violet", "bg-violet-500")
    };

    protected override void OnInitialized()
    {
        PreferencesService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        PreferencesService.OnChange -= StateHasChanged;
    }

    private async Task ToggleDarkMode()
    {
        var newMode = IsDark ? "light" : "dark";
        await PreferencesService.UpdatePreferencesAsync(null, newMode);
    }

    private async Task SetTheme(string theme)
    {
        await PreferencesService.UpdatePreferencesAsync(theme, null);
    }
}
