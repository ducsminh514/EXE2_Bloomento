@page "/admin/knowledge/categories"
@layout ADHDChecklist.Client.Layout.AdminLayout
@using ADHDChecklist.Client.Features.Knowledge.Services
@inject IKnowledgeService KnowledgeService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Category Management</h1>
    <a href="/admin/knowledge/categories/create" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center gap-2">
        <span>➕</span> New Category
    </a>
</div>

@if (_isLoading)
{
    <div class="flex justify-center p-8">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
    </div>
}
else
{
    <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-200">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Icon</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Slug</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @foreach (var category in _categories.OrderBy(c => c.OrderIndex))
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4">
                            <span class="text-2xl">@category.Icon</span>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex items-center">
                                <span class="w-3 h-3 rounded-full mr-2" style="background-color: @category.ColorHex"></span>
                                <span class="text-sm font-medium text-gray-900">@category.Name</span>
                            </div>
                            <div class="text-xs text-gray-500">@category.Description</div>
                        </td>
                         <td class="px-6 py-4 text-sm text-gray-500">
                            @category.Slug
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-500">
                            @category.OrderIndex
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <a href="/admin/knowledge/categories/edit/@category.Id" class="text-blue-600 hover:text-blue-900 mr-4">Edit</a>
                            <button @onclick="() => DeleteCategory(category)" class="text-red-600 hover:text-red-900">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        @if (!_categories.Any())
        {
             <div class="text-center py-10 text-gray-500">
                No categories found.
            </div>
        }
    </div>
}

@code {
    private List<KnowledgeCategoryDto> _categories = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        _isLoading = true;
        _categories = await KnowledgeService.GetCategoriesAsync();
        _isLoading = false;
    }

    private async Task DeleteCategory(KnowledgeCategoryDto category)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{category.Name}'? This fails if articles exist."))
        {
            return;
        }

        var success = await KnowledgeService.DeleteCategoryAsync(category.Id);
        if (success)
        {
            await LoadCategories();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Failed to delete category. Ensure it has no articles.");
        }
    }
}
