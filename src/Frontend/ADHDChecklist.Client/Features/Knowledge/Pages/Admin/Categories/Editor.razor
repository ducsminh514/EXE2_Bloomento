@page "/admin/knowledge/categories/create"
@page "/admin/knowledge/categories/edit/{Id:guid}"
@layout ADHDChecklist.Client.Layout.AdminLayout
@using ADHDChecklist.Client.Features.Knowledge.Services
@inject IKnowledgeService KnowledgeService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="max-w-2xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">@(IsEditMode ? "Edit Category" : "New Category")</h1>
        <a href="/admin/knowledge/categories" class="text-gray-600 hover:text-gray-900">Cancel</a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <EditForm Model="@Model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="space-y-6">
                <!-- Name -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                    <InputText @bind-Value="Model.Name" class="w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500" placeholder="e.g. Nutrition" />
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description (Optional)</label>
                    <InputTextArea @bind-Value="Model.Description" class="w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500" rows="3" />
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <!-- Icon -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Icon (Emoji)</label>
                        <InputText @bind-Value="Model.Icon" class="w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500" placeholder="e.g. 🍎" />
                    </div>

                    <!-- Color -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Color (Hex)</label>
                        <div class="flex gap-2">
                             <InputText @bind-Value="Model.ColorHex" type="color" class="h-10 w-20 rounded border-gray-300 p-1" />
                             <InputText @bind-Value="Model.ColorHex" class="flex-1 rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500" placeholder="#RRGGBB" />
                        </div>
                    </div>
                </div>
                
                 <!-- Order -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Order Index</label>
                    <InputNumber @bind-Value="Model.OrderIndex" class="w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500" />
                </div>

                <div class="flex justify-end pt-4">
                    <button type="submit" disabled="@_isSaving" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-50 flex items-center gap-2">
                        @if (_isSaving)
                        {
                            <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                        }
                        <span>@(IsEditMode ? "Save Changes" : "Create Category")</span>
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private KnowledgeCategoryDto Model { get; set; } = new();
    private bool _isSaving = false;
    private bool IsEditMode => Id.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode)
        {
            var categories = await KnowledgeService.GetCategoriesAsync();
            var category = categories.FirstOrDefault(c => c.Id == Id);
            if (category != null)
            {
                Model = category;
            }
            else
            {
                Navigation.NavigateTo("/admin/knowledge/categories");
            }
        }
        else
        {
            // Defaults
             Model.ColorHex = "#3B82F6";
             Model.OrderIndex = 0;
        }
    }

    private async Task HandleSubmit()
    {
        _isSaving = true;
        bool success;

        if (IsEditMode)
        {
            success = await KnowledgeService.UpdateCategoryAsync(Model);
        }
        else
        {
            // Since DTO doesn't have Id on Create usually, but here we reuse DTO. Id will be ignored or generated by backend
            success = await KnowledgeService.CreateCategoryAsync(Model);
        }

        _isSaving = false;

        if (success)
        {
            Navigation.NavigateTo("/admin/knowledge/categories");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "An error occurred while saving.");
        }
    }
}
