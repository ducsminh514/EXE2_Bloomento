@page "/admin/knowledge/articles/create"
@page "/admin/knowledge/articles/edit/{Id:guid}"
@layout ADHDChecklist.Client.Layout.AdminLayout
@using ADHDChecklist.Client.Features.Knowledge.Services
@using ADHDChecklist.Client.Features.Knowledge.DTOs
@using Markdig
@inject IConfiguration Config
@inject IKnowledgeService KnowledgeService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">
            @(Id.HasValue ? "Edit Article" : "Create New Article")
        </h1>
        <div class="flex gap-2">
             <div class="flex bg-gray-100 p-1 rounded-lg border border-gray-200">
                <button @onclick="() => _viewMode = EditorViewMode.Edit" class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors @(_viewMode == EditorViewMode.Edit ? "bg-white text-blue-600 shadow-sm" : "text-gray-600 hover:text-gray-900")">
                    📝 Edit
                </button>
                <button @onclick="() => _viewMode = EditorViewMode.Split" class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors @(_viewMode == EditorViewMode.Split ? "bg-white text-blue-600 shadow-sm" : "text-gray-600 hover:text-gray-900")">
                    🌗 Split
                </button>
                <button @onclick="() => _viewMode = EditorViewMode.Preview" class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors @(_viewMode == EditorViewMode.Preview ? "bg-white text-blue-600 shadow-sm" : "text-gray-600 hover:text-gray-900")">
                    👁️ Preview
                </button>
             </div>
            <a href="/admin/knowledge/articles" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 flex items-center">Cancel</a>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <EditForm Model="@Model" OnValidSubmit="SaveArticle">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-red-600 mb-4" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <!-- Title -->
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                    <InputText @bind-Value="Model.Title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Enter article title..." />
                </div>

                <!-- Slug -->
                <div class="col-span-2 md:col-span-1">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
                    <InputText @bind-Value="Model.Slug" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="url-friendly-slug" />
                    <p class="text-xs text-gray-500 mt-1">Unique URL identifier (kebab-case)</p>
                </div>

                 <!-- Category -->
                <div class="col-span-2 md:col-span-1">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                    <InputSelect @bind-Value="Model.CategoryId" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                        <option value="@Guid.Empty">-- Select Category --</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </InputSelect>
                </div>

                 <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Cover Image URL</label>
                    <div class="flex gap-2">
                        <InputText @bind-Value="Model.CoverImage" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="https://..." />
                         <InputFile OnChange="UploadCoverImage" id="coverImage" class="hidden" accept="image/*" />
                         <label for="coverImage" class="cursor-pointer px-3 py-2 bg-gray-100 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-200 flex items-center gap-2">
                             <span>📤</span> Upload
                         </label>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CoverImage))
                    {
                        var imgUrl = Model.CoverImage.StartsWith("/uploads/") 
                            ? (Config["ApiBaseUrl"] ?? "http://localhost:7001") + Model.CoverImage 
                            : Model.CoverImage;
                        <div class="mt-2 text-center bg-gray-50 rounded-lg p-2 border border-gray-200">
                             <img src="@imgUrl" alt="Cover Preview" class="h-32 object-cover rounded mx-auto" onerror="this.src='/images/placeholder.png'; this.onerror=null;" />
                             <p class="text-xs text-gray-500 mt-1">Preview</p>
                        </div>
                    }
                </div>

                <!-- Summary -->
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Summary (Short Description)</label>
                    <InputTextArea @bind-Value="Model.Summary" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none h-20" />
                </div>

                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Content (Markdown)</label>
                    
                    <div class="@(_viewMode == EditorViewMode.Split ? "grid grid-cols-1 lg:grid-cols-2 gap-6" : "")">
                        
                        <!-- EDITOR PANE -->
                        @if (_viewMode != EditorViewMode.Preview)
                        {
                            <div class="flex flex-col h-full">
                                <!-- Toolbar -->
                                <div class="flex flex-wrap items-center gap-1 mb-0 p-1 bg-gray-50 border border-gray-200 border-b-0 rounded-t-lg">
                                    <button type="button" @onclick='() => InsertMarkdown("**", "**")' class="p-1 hover:bg-gray-200 rounded text-gray-700 font-bold" title="Bold">B</button>
                                    <button type="button" @onclick='() => InsertMarkdown("*", "*")' class="p-1 hover:bg-gray-200 rounded text-gray-700 italic" title="Italic">I</button>
                                    <span class="border-l border-gray-300 h-4 mx-1"></span>
                                     <button type="button" @onclick='() => InsertMarkdown("# ", "")' class="p-1 hover:bg-gray-200 rounded text-gray-700" title="Heading 1">H1</button>
                                    <button type="button" @onclick='() => InsertMarkdown("## ", "")' class="p-1 hover:bg-gray-200 rounded text-gray-700" title="Heading 2">H2</button>
                                    <button type="button" @onclick='() => InsertMarkdown("### ", "")' class="p-1 hover:bg-gray-200 rounded text-gray-700" title="Heading 3">H3</button>
                                    <span class="border-l border-gray-300 h-4 mx-1"></span>
                                    <button type="button" @onclick='() => InsertMarkdown("- ", "")' class="p-1 hover:bg-gray-200 rounded text-gray-700" title="Bulleted List">List</button>
                                    <button type="button" @onclick='() => InsertMarkdown("> ", "")' class="p-1 hover:bg-gray-200 rounded text-gray-700" title="Quote">❞</button>
                                    <button type="button" @onclick='() => InsertMarkdown("`", "`")' class="p-1 hover:bg-gray-200 rounded text-gray-700 font-mono" title="Code">Code</button>
                                    <button type="button" @onclick='() => InsertMarkdown("[", "](url)")' class="p-1 hover:bg-gray-200 rounded text-gray-700" title="Link">🔗</button>
                                    <div class="grow"></div>
                                     <div class="flex items-center gap-2">
                                         <InputFile OnChange="UploadContentImage" id="contentImage" class="hidden" accept="image/*" />
                                         <label for="contentImage" class="cursor-pointer px-2 py-1 bg-white border border-gray-300 rounded text-xs font-medium text-gray-700 hover:bg-gray-50 flex items-center gap-1">
                                             <span>🖼️</span> Img
                                         </label>
                                    </div>
                                </div>

                                <InputTextArea id="contentEditor" @bind-Value="Model.Content" class="w-full px-4 py-2 border border-gray-300 rounded-b-lg focus:ring-2 focus:ring-blue-500 outline-none font-mono text-sm h-96 resize-y" placeholder="# Write your content here..." />
                            </div>
                        }

                        <!-- PREVIEW PANE -->
                        @if (_viewMode != EditorViewMode.Edit)
                        {
                            <div>
                                <!-- Label for split view clarity -->
                                @if (_viewMode == EditorViewMode.Split) 
                                { 
                                    <div class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-1 px-1">Live Preview</div> 
                                }
                                
                                <div class="prose prose-slate max-w-none border border-gray-200 rounded-lg p-6 bg-gray-50 h-[26.5rem] overflow-y-auto
                                            prose-p:my-1 prose-p:leading-normal
                                            prose-headings:text-gray-800
                                            prose-h1:text-3xl prose-h1:font-bold prose-h1:mt-3 prose-h1:mb-2
                                            prose-h2:text-2xl prose-h2:font-semibold prose-h2:mt-2 prose-h2:mb-1
                                            prose-h3:text-xl prose-h3:font-medium prose-h3:mt-2 prose-h3:mb-1
                                            prose-li:my-0">
                                     @if (string.IsNullOrWhiteSpace(Model.Content))
                                    {
                                        <p class="text-gray-400 italic">Nothing to preview yet...</p>
                                    }
                                    else 
                                    {
                                        <div>@((MarkupString)GetPreviewContent())</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Meta -->
                <div class="col-span-2 md:col-span-1">
                     <label class="block text-sm font-medium text-gray-700 mb-1">Read Time (Min)</label>
                     <InputNumber @bind-Value="Model.EstimatedReadTimeMinutes" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" />
                </div>
                 <div class="col-span-2 md:col-span-1">
                     <label class="block text-sm font-medium text-gray-700 mb-1">Difficulty</label>
                     <InputSelect @bind-Value="Model.Difficulty" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                        <option value="Easy">Easy</option>
                        <option value="Medium">Medium</option>
                        <option value="Hard">Hard</option>
                     </InputSelect>
                </div>

                <!-- Toggles -->
                <div class="col-span-2 flex gap-6 mt-4">
                    <div class="flex items-center">
                        <InputCheckbox @bind-Value="Model.IsPublished" id="isPublished" class="h-4 w-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" />
                        <label for="isPublished" class="ml-2 block text-sm font-medium text-gray-900">Publish Immediately</label>
                    </div>
                    <div class="flex items-center">
                        <InputCheckbox @bind-Value="Model.IsPremium" id="isPremium" class="h-4 w-4 text-yellow-600 rounded border-gray-300 focus:ring-yellow-500" />
                        <label for="isPremium" class="ml-2 block text-sm font-medium text-gray-900">Premium Content</label>
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-6 border-t border-gray-100">
                <a href="/admin/knowledge/articles" class="px-6 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">Cancel</a>
                <button type="submit" disabled="@_isSaving" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center gap-2">
                    @if (_isSaving)
                    {
                        <span class="animate-spin h-4 w-4 border-2 border-white rounded-full border-t-transparent"></span>
                    }
                    Save Article
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private ArticleEditorDto Model { get; set; } = new();
    private List<KnowledgeCategoryDto> _categories = new();
    private bool _isSaving = false;
    private EditorViewMode _viewMode = EditorViewMode.Split; // Default to Split for immediate feedback

    private enum EditorViewMode
    {
        Edit,
        Split,
        Preview
    }

    protected override async Task OnInitializedAsync()
    {
        _categories = await KnowledgeService.GetCategoriesAsync();

        if (Id.HasValue)
        {
            var articles = await KnowledgeService.GetAdminArticlesAsync();
            var article = articles.FirstOrDefault(a => a.Id == Id.Value);
            
            if (article != null)
            {
                var detail = await KnowledgeService.GetArticleDetailAsync(article.Slug);
                if (detail != null)
                {
                     Model = new ArticleEditorDto
                     {
                         Id = detail.Id,
                         Title = detail.Title,
                         Slug = detail.Slug,
                         Summary = detail.Summary,
                         Content = detail.Content,
                         CoverImage = detail.CoverImage,
                         CategoryId = _categories.FirstOrDefault(c => c.Name == detail.CategoryName)?.Id ?? Guid.Empty,
                         EstimatedReadTimeMinutes = detail.EstimatedReadTimeMinutes,
                         Difficulty = detail.Difficulty,
                         IsPublished = article.IsPublished,
                         IsPremium = article.IsPremium
                     };
                }
            }
        }
    }

    private async Task InsertMarkdown(string prefix, string suffix)
    {
        await JS.InvokeVoidAsync("editorHelpers.insertTextAtCursor", "contentEditor", prefix + suffix);
    }

    private async Task SaveArticle()
    {
        Console.WriteLine($"[Editor] Save triggered. Model.Content Length: {Model.Content?.Length ?? 0}");
        Console.WriteLine($"[Editor] Content snippet: {(Model.Content?.Length > 100 ? Model.Content?[..100] : Model.Content)}");
        
        _isSaving = true;
        try
        {
            if (Id.HasValue)
            {
                Model.Id = Id.Value;
                await KnowledgeService.UpdateArticleAsync(Id.Value, Model);
            }
            else
            {
                await KnowledgeService.CreateArticleAsync(Model);
            }
            Navigation.NavigateTo("/admin/knowledge/articles");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task UploadCoverImage(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(50 * 1024 * 1024));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var url = await KnowledgeService.UploadImageAsync(content);
            if (!string.IsNullOrEmpty(url))
            {
                Model.CoverImage = url;
            }
        }
    }

    private async Task UploadContentImage(InputFileChangeEventArgs e)
    {
        try
        {
            Console.WriteLine("[Editor] UploadContentImage triggered.");
            var file = e.File;
            if (file != null)
            {
                Console.WriteLine($"[Editor] File selected: {file.Name}, Size: {file.Size}, Type: {file.ContentType}");
                
                var content = new MultipartFormDataContent();
                var fileContent = new StreamContent(file.OpenReadStream(50 * 1024 * 1024));
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                content.Add(fileContent, "file", file.Name);

                Console.WriteLine("[Editor] Sending upload request...");
                var url = await KnowledgeService.UploadImageAsync(content);
                Console.WriteLine($"[Editor] Upload result URL: {url}");

                if (!string.IsNullOrEmpty(url))
                {
                     Console.WriteLine($"[Editor] Inserting markdown for {url}");
                    await InsertMarkdown($"![Image]({url})", "");
                    Console.WriteLine("[Editor] Markdown insertion completed.");
                }
                else
                {
                    Console.WriteLine("[Editor] Upload failed: Service returned null/empty URL.");
                    await JS.InvokeVoidAsync("alert", "Upload failed! The server returned no URL. Please check the backend logs.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Editor] CRITICAL ERROR in UploadContentImage: {ex}");
            await JS.InvokeVoidAsync("alert", $"Client-side Error: {ex.Message}");
        }
    }

    private string GetPreviewContent()
    {
        var content = Model.Content ?? "";
        var baseUrl = Config["ApiBaseUrl"] ?? "http://localhost:7001";

        // 1. Explicit replacement for standard Editor format
        content = content.Replace("](/uploads/", $"]({baseUrl}/uploads/");
        content = content.Replace("src=\"/uploads/", $"src=\"{baseUrl}/uploads/");
        
        // 2. Regex for edge cases
        var pattern = @"(\]|src=[""'])\s*(/uploads/[^""')\s]+)";
        var processed = System.Text.RegularExpressions.Regex.Replace(content, pattern, m => 
        {
            var prefix = m.Groups[1].Value;
            var path = m.Groups[2].Value;
             if (path.StartsWith("http")) return m.Value;
            return $"{prefix}{baseUrl}{path}";
        });

        return Markdown.ToHtml(processed);
    }
}
