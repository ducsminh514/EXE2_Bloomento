@page "/knowledge"
@using ADHDChecklist.Client.Features.Knowledge.Services
@inject IKnowledgeService KnowledgeService
@inject NavigationManager Navigation

<div class="max-w-5xl mx-auto p-6 animate-fade-in">
    <!-- Header -->
    <div class="mb-8 text-center relative">
        <button @onclick='() => Navigation.NavigateTo("/")' class="absolute left-0 top-0 p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-xl transition-all" title="Về trang chủ">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </button>
        <h1 class="text-3xl font-black text-gray-800 mb-2 flex items-center justify-center gap-2">
            <span>📚</span> Bloomento Learn
        </h1>
        <p class="text-gray-500 max-w-xl mx-auto mb-6">
            Kiến thức, chiến lược và kỹ năng sinh tồn cho não bộ ADHD.
            <br/>Được biên soạn ngắn gọn, dễ hiểu.
        </p>
        
        <div class="flex justify-center gap-4">
             <button @onclick='() => Navigation.NavigateTo("/knowledge/bookmarks")' class="flex items-center gap-2 px-4 py-2 bg-white rounded-lg border border-gray-200 hover:border-primary-500 hover:text-primary-600 transition-all shadow-sm font-bold text-gray-600">
                <span>🔖</span> Đã lưu
            </button>
        </div>
    </div>

    @if (_categories == null)
    {
        <div class="flex justify-center py-12">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-primary-600"></div>
        </div>
    }
    else
    {
        <!-- Categories Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
            @foreach (var cat in _categories)
            {
                <div @onclick="() => NavigateToCategory(cat.Slug)" 
                     class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-lg hover:border-primary-100 transition-all cursor-pointer group relative overflow-hidden"
                     style="--hover-color: @cat.ColorHex">
                    
                    <!-- Decor -->
                    <div class="absolute -right-4 -top-4 w-24 h-24 rounded-full opacity-10 group-hover:scale-110 transition-transform"
                         style="background-color: @cat.ColorHex"></div>

                    <div class="relative z-10 flex gap-4 items-start">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl shadow-inner text-white"
                             style="background-color: @cat.ColorHex">
                             @cat.Icon
                        </div>
                        <div class="flex-1">
                            <h3 class="text-lg font-bold text-gray-800 group-hover:text-primary-600 transition-colors">
                                @cat.Name
                            </h3>
                            <p class="text-sm text-gray-500 mt-1 line-clamp-2">
                                @cat.Description
                            </p>
                            
                            <div class="mt-4 flex items-center gap-2 text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity transform translate-y-2 group-hover:translate-y-0"
                                 style="color: @cat.ColorHex">
                                <span>Xem bài viết</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .animate-fade-in { animation: fadeIn 0.3s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    private List<KnowledgeCategoryDto>? _categories;

    protected override async Task OnInitializedAsync()
    {
        _categories = await KnowledgeService.GetCategoriesAsync();
    }

    private void NavigateToCategory(string slug)
    {
        // TODO: Implement category detail / article list page
        Navigation.NavigateTo($"/knowledge/category/{slug}");
    }


}
