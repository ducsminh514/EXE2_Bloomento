@page "/knowledge/bookmarks"
@using ADHDChecklist.Client.Features.Knowledge.Services
@inject IKnowledgeService KnowledgeService
@inject NavigationManager Navigation

<div class="max-w-4xl mx-auto p-6 animate-fade-in">
    <!-- Breadcrumb & Header -->
    <div class="mb-8">
        <button @onclick='() => Navigation.NavigateTo("/knowledge")' class="mb-4 text-sm text-gray-500 hover:text-primary-600 flex items-center gap-1 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            Quay lại Thư viện
        </button>
        
        <div class="flex items-center gap-3 mb-2">
             <span class="text-3xl">🔖</span>
             <h1 class="text-3xl font-black text-gray-900">Bài viết đã lưu</h1>
        </div>
        <p class="text-gray-500">Danh sách các bài viết bạn đã bookmark.</p>
    </div>

    @if (_isLoading)
    {
         <div class="space-y-4">
            @for(int i=0; i<3; i++) {
                <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm animate-pulse">
                    <div class="h-6 w-3/4 bg-gray-200 rounded mb-3"></div>
                    <div class="h-4 w-full bg-gray-100 rounded mb-2"></div>
                    <div class="h-4 w-1/2 bg-gray-100 rounded"></div>
                </div>
            }
         </div>
    }
    else if (_articles == null || !_articles.Any())
    {
         <div class="text-center py-12 bg-gray-50 rounded-2xl border border-gray-100 border-dashed">
            <span class="text-4xl block mb-2">🗂️</span>
            <p class="text-gray-500 font-medium">Bạn chưa lưu bài viết nào.</p>
            <p class="text-xs text-gray-400 mt-1">Hãy bấm icon Bookmark 🔖 trên bài viết để lưu lại nhé!</p>
            <button @onclick='() => Navigation.NavigateTo("/knowledge")' class="mt-4 px-4 py-2 bg-primary-100 text-primary-700 rounded-lg text-sm font-bold hover:bg-primary-200 transition-colors">
                Khám phá ngay
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-4">
            @foreach (var article in _articles)
            {
                <div @onclick="() => NavigateToArticle(article.Slug)" 
                     class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary-100 transition-all cursor-pointer group">
                     
                     <div class="flex flex-col md:flex-row gap-6">
                         <div class="flex-1">
                             <div class="flex items-center gap-2 mb-2 text-xs font-bold uppercase tracking-wider text-gray-400">
                                 <span class="@GetDifficultyColor(article.Difficulty)">@article.Difficulty</span>
                                 <span>•</span>
                                 <span>@article.EstimatedReadTimeMinutes phút đọc</span>
                             </div>
                             
                             <h2 class="text-xl font-bold text-gray-800 mb-2 group-hover:text-primary-600 transition-colors">
                                 @article.Title
                             </h2>
                             
                             <p class="text-gray-600 text-sm line-clamp-2 mb-4">
                                 @article.Summary
                             </p>
                             
                             <div class="flex items-center justify-between mt-auto">
                                 <div class="text-xs text-gray-400 flex items-center gap-1">
                                     <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                     @article.ViewCount lượt xem
                                 </div>
                                 
                                 <span class="text-primary-600 text-sm font-bold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                                     Đọc lại <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                                 </span>
                             </div>
                         </div>
                     </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ArticleSummaryDto>? _articles;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _articles = await KnowledgeService.GetBookmarkedArticlesAsync();
        _isLoading = false;
    }

    private void NavigateToArticle(string slug)
    {
        Navigation.NavigateTo($"/knowledge/article/{slug}");
    }

    private string GetDifficultyColor(string difficulty)
    {
        return difficulty.ToLower() switch
        {
            "easy" => "text-green-500",
            "medium" => "text-yellow-500",
            "hard" => "text-red-500",
            _ => "text-gray-400"
        };
    }
}
