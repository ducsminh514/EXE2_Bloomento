@page "/admin/dashboard"
@layout ADHDChecklist.Client.Layout.AdminLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject ADHDChecklist.Client.Features.Admin.Services.IAdminService AdminService
@attribute [Authorize(Roles = "Admin")]
@using ApexCharts

<PageTitle>Admin Dashboard - Bloomento</PageTitle>

<div class="space-y-6">
    <!-- Welcome Section -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>
            <p class="text-gray-600">Welcome back! Overview of your platform's performance.</p>
        </div>
        <div class="text-right">
             <div class="text-sm font-medium text-gray-500">Today</div>
             <div class="text-lg font-bold text-gray-900">@DateTime.Now.ToString("dd MMM yyyy")</div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center p-12">
            <div class="animate-spin h-8 w-8 border-4 border-blue-500 rounded-full border-t-transparent"></div>
        </div>
    }
    else if (_stats != null)
    {
        <!-- Quick Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <!-- Users Stat -->
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
                <div class="flex items-center gap-4 mb-4">
                    <div class="p-3 bg-blue-50 text-blue-600 rounded-lg">
                        <span class="text-xl">👥</span>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-gray-500">Total Users</p>
                        <h3 class="text-2xl font-bold text-gray-900">@_stats.TotalUsers</h3>
                    </div>
                </div>
                @if(_stats.NewUsersToday > 0)
                {
                    <p class="text-xs text-green-600 font-medium flex items-center gap-1">
                        <span>↑</span> @_stats.NewUsersToday New Today
                    </p>
                }
                else
                {
                     <p class="text-xs text-gray-400">No new users today</p>
                }
            </div>

            <!-- Articles Stat -->
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
                <div class="flex items-center gap-4 mb-4">
                    <div class="p-3 bg-indigo-50 text-indigo-600 rounded-lg">
                        <span class="text-xl">📚</span>
                    </div>
                    <div>
                         <p class="text-sm font-medium text-gray-500">Articles</p>
                        <h3 class="text-2xl font-bold text-gray-900">@_stats.TotalArticles</h3>
                    </div>
                </div>
                 <a href="/admin/knowledge/articles" class="text-xs text-indigo-600 font-medium hover:underline">Manage Content →</a>
            </div>

            <!-- Comments Stat -->
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
                <div class="flex items-center gap-4 mb-4">
                    <div class="p-3 bg-amber-50 text-amber-600 rounded-lg">
                        <span class="text-xl">💬</span>
                    </div>
                    <div>
                         <p class="text-sm font-medium text-gray-500">Comments</p>
                        <h3 class="text-2xl font-bold text-gray-900">@_stats.TotalComments</h3>
                    </div>
                </div>
                @if(_stats.HiddenComments > 0)
                {
                    <a href="/admin/knowledge/comments" class="text-xs text-red-500 font-medium hover:underline flex items-center gap-1">
                        <span>⚠️</span> @_stats.HiddenComments Hidden/Flagged
                    </a>
                }
                else
                {
                    <p class="text-xs text-green-600">All clean!</p>
                }
            </div>

             <!-- Categories Stat -->
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
                <div class="flex items-center gap-4 mb-4">
                    <div class="p-3 bg-emerald-50 text-emerald-600 rounded-lg">
                        <span class="text-xl">🏷️</span>
                    </div>
                    <div>
                         <p class="text-sm font-medium text-gray-500">Categories</p>
                        <h3 class="text-2xl font-bold text-gray-900">@_stats.TotalCategories</h3>
                    </div>
                </div>
                 <a href="/admin/knowledge/categories" class="text-xs text-emerald-600 font-medium hover:underline">Manage Taxonomy →</a>
            </div>
        </div>
            <!-- Charts Section -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
                <!-- User Growth Chart -->
                <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
                    <h3 class="text-lg font-bold text-gray-900 mb-4">User Growth (Last 7 Days)</h3>
                    @if (_charts?.UserGrowth != null && _charts.UserGrowth.Any())
                    {
                        <ApexChart TItem="ADHDChecklist.Client.Features.Admin.Services.UserGrowthData"
                                   Title=""
                                   Options="_userGrowthOptions">
                            <ApexPointSeries TItem="ADHDChecklist.Client.Features.Admin.Services.UserGrowthData"
                                             Items="_charts.UserGrowth"
                                             Name="New Users"
                                             SeriesType="SeriesType.Area"
                                             XValue="@(e => e.Date.ToString("dd/MM"))"
                                             YValue="@(e => e.Count)"
                                             Color="#3B82F6"/>
                        </ApexChart>
                    }
                    else
                    {
                         <div class="h-64 flex items-center justify-center text-gray-400">No data available</div>
                    }
                </div>

                <!-- Category Distribution Chart -->
                <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
                     <h3 class="text-lg font-bold text-gray-900 mb-4">Articles by Category</h3>
                     @if (_charts?.CategoryDistribution != null && _charts.CategoryDistribution.Any())
                    {
                        <ApexChart TItem="ADHDChecklist.Client.Features.Admin.Services.CategoryDistributionData"
                                   Title=""
                                   Options="_categoryOptions">
                            <ApexPointSeries TItem="ADHDChecklist.Client.Features.Admin.Services.CategoryDistributionData"
                                             Items="_charts.CategoryDistribution"
                                             Name="Articles"
                                             SeriesType="SeriesType.Donut"
                                             XValue="@(e => e.CategoryName)"
                                             YValue="@(e => e.ArticleCount)"/>
                        </ApexChart>
                    }
                     else
                    {
                         <div class="h-64 flex items-center justify-center text-gray-400">No data available</div>
                    }
                </div>
            </div>
    }
    else
    {
         <div class="text-center text-red-500 p-6">Failed to load statistics.</div>
    }
</div>

@code {
    private ADHDChecklist.Client.Features.Admin.Services.AdminDashboardStats? _stats;
    private ADHDChecklist.Client.Features.Admin.Services.AdminDashboardChartsResponse? _charts;
    private bool _isLoading = true;

    private ApexCharts.ApexChartOptions<ADHDChecklist.Client.Features.Admin.Services.UserGrowthData> _userGrowthOptions = new();
    private ApexCharts.ApexChartOptions<ADHDChecklist.Client.Features.Admin.Services.CategoryDistributionData> _categoryOptions = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var statsTask = AdminService.GetDashboardStatsAsync();
            var chartsTask = AdminService.GetDashboardChartsAsync();

            await Task.WhenAll(statsTask, chartsTask);

            _stats = await statsTask;
            _charts = await chartsTask;

            ConfigureCharts();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ConfigureCharts()
    {
        _userGrowthOptions.Chart = new() { Toolbar = new() { Show = false } };
        _userGrowthOptions.Xaxis = new() { Labels = new() { Show = true } };
        
        _categoryOptions.Chart = new() { Toolbar = new() { Show = false } };
        _categoryOptions.PlotOptions = new() 
        { 
            Pie = new() 
            { 
                Donut = new() 
                { 
                    Labels = new() 
                    { 
                        Show = true 
                    } 
                } 
            } 
        };
    }
}
