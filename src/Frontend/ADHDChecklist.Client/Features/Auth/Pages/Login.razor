@page "/login"
@using ADHDChecklist.Client.Features.Auth.Services
@using ADHDChecklist.Client.Shared.Models
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<Login> Logger
@using System.ComponentModel.DataAnnotations
@using ADHDChecklist
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary-50 to-purple-50 px-4">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8">

        <!-- Header -->
        <div class="text-center mb-8 flex flex-col items-center">
            <img src="logo.png" class="h-16 w-16 mb-4 object-contain" alt="Bloomento Logo" />
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Bloomento</h1>
            <p class="text-gray-600">Đăng nhập để quản lý công việc hiệu quả</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
                <p class="text-sm text-red-600">@_errorMessage</p>
                @if (_requireEmailVerification)
                {
                    <a href="/resend-verification" class="text-sm text-primary-600 hover:text-primary-500 font-medium mt-2 inline-block">
                        Gửi lại email xác nhận →
                    </a>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
                <p class="text-sm text-green-600">@_successMessage</p>
            </div>
        }

        <!-- Login Form -->
        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="space-y-4">
                <!-- Email -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                    <InputText @bind-Value="_loginModel.Email"
                               type="email"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                               placeholder="your-email@example.com" />
                    <ValidationMessage For="@(() => _loginModel.Email)" class="text-red-500 text-sm mt-1" />
                </div>

                <!-- Password -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Mật khẩu</label>
                    <InputText @bind-Value="_loginModel.Password"
                               type="password"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                               placeholder="••••••••" />
                    <ValidationMessage For="@(() => _loginModel.Password)" class="text-red-500 text-sm mt-1" />
                </div>

                <!-- Remember Me -->
                <div class="flex items-center justify-between">
                    <label class="flex items-center">
                        <InputCheckbox @bind-Value="_loginModel.RememberMe" class="w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500" />
                        <span class="ml-2 text-sm text-gray-700">Ghi nhớ đăng nhập</span>
                    </label>
                    <a href="/forgot-password" class="text-sm text-primary-600 hover:text-primary-500">Quên mật khẩu?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit"
                        disabled="@_isLoading"
                        class="w-full bg-primary-600 text-white py-3 px-4 rounded-lg font-medium hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                    @if (_isLoading)
                    {
                        <span>Đang đăng nhập...</span>
                    }
                    else
                    {
                        <span>Đăng nhập</span>
                    }
                </button>
            </div>
        </EditForm>

        <!-- Divider -->
        <div class="relative my-6">
            <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-300"></div>
            </div>
            <div class="relative flex justify-center text-sm">
                <span class="px-2 bg-white text-gray-500">Hoặc tiếp tục với</span>
            </div>
        </div>

        <!-- Google Login -->
        <div id="google-button-container" class="w-full flex justify-center mt-2 min-h-[50px]"></div>

        <!-- Register Link -->
        <p class="mt-6 text-center text-sm text-gray-600">
            Chưa có tài khoản?
            <a href="/register" class="font-medium text-primary-600 hover:text-primary-500">Đăng ký ngay</a>
        </p>
    </div>
</div>

@code {
    private LoginModel _loginModel = new();
    private bool _isLoading;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _requireEmailVerification;
    private DotNetObjectReference<Login>? _dotNetHelper;

    private class LoginModel
    {
        [Required(ErrorMessage = "Email là bắt buộc")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Mật khẩu là bắt buộc")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }

    protected override void OnInitialized()
    {
        // Check if redirected from registration
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        if (query["registered"] == "true")
        {
            _successMessage = "Đăng ký thành công! Vui lòng kiểm tra email để xác nhận tài khoản.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            var clientId = Configuration["Authentication:Google:ClientId"];
            if (!string.IsNullOrEmpty(clientId))
            {
                await JSRuntime.InvokeVoidAsync("initGoogleSignIn", _dotNetHelper, clientId);
            }
        }
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var request = new LoginRequest(
                _loginModel.Email,
                _loginModel.Password,
                _loginModel.RememberMe
            );

            var response = await AuthService.LoginAsync(request);

            if (response.Success)
            {
                await RedirectUser();
            }
            else
            {
                _errorMessage = response.Message;
                _requireEmailVerification = response.RequireEmailVerification;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Login error");
            _errorMessage = "Có lỗi xảy ra. Vui lòng thử lại.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleGoogleLogin()
    {
        if (_isLoading) return;
        await JSRuntime.InvokeVoidAsync("triggerGoogleSignIn");
    }

    [JSInvokable]
    public async Task HandleGoogleCredential(string idToken)
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var response = await AuthService.GoogleLoginAsync(new GoogleLoginRequest(idToken));

            if (response.Success)
            {
                await RedirectUser();
            }
            else
            {
                _errorMessage = response.Message;
                _isLoading = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Google login callback error");
            _errorMessage = "Đăng nhập Google thất bại.";
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RedirectUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.IsInRole("Admin"))
        {
            Navigation.NavigateTo("/admin/dashboard", forceLoad: true);
        }
        else
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }

    public void Dispose()
    {
        _dotNetHelper?.Dispose();
    }
}
