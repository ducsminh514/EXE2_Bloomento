@page "/resend-verification"
@using ADHDChecklist.Client.Features.Auth.Services
@inject IAuthService AuthService
@using System.ComponentModel.DataAnnotations
<PageTitle>Gửi lại email xác nhận - ADHD Checklist</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-50 to-purple-50 px-4">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8">

        <div class="text-center mb-8">
            <div class="mx-auto w-16 h-16 mb-4 bg-indigo-100 rounded-full flex items-center justify-center">
                <svg class="w-10 h-10 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 mb-2">Gửi lại email xác nhận</h1>
            <p class="text-gray-600">Nhập email của bạn để nhận link xác nhận mới</p>
        </div>

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
                <p class="text-sm text-green-600">@_successMessage</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
                <p class="text-sm text-red-600">@_errorMessage</p>
            </div>
        }

        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                    <InputText @bind-Value="_model.Email"
                               type="email"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                               placeholder="your-email@example.com" />
                    <ValidationMessage For="@(() => _model.Email)" class="text-red-500 text-sm mt-1" />
                </div>

                <button type="submit"
                        disabled="@_isSubmitting"
                        class="w-full bg-indigo-600 text-white py-3 px-4 rounded-lg font-medium hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                    @if (_isSubmitting)
                    {
                        <span>Đang gửi...</span>
                    }
                    else
                    {
                        <span>Gửi email xác nhận</span>
                    }
                </button>
            </div>
        </EditForm>

        <p class="mt-6 text-center text-sm text-gray-600">
            Đã có tài khoản đã xác nhận?
            <a href="/login" class="font-medium text-indigo-600 hover:text-indigo-500">Đăng nhập ngay</a>
        </p>
    </div>
</div>

@code {
    private ResendModel _model = new();
    private bool _isSubmitting;
    private string? _successMessage;
    private string? _errorMessage;

    private class ResendModel
    {
        [Required(ErrorMessage = "Email là bắt buộc")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ")]
        public string Email { get; set; } = string.Empty;
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _successMessage = null;
        _errorMessage = null;

        try
        {
            var result = await AuthService.ResendVerificationEmailAsync(_model.Email);

            if (result)
            {
                _successMessage = "Email xác nhận đã được gửi! Vui lòng kiểm tra hộp thư (và thư mục spam).";
                _model.Email = string.Empty;
            }
            else
            {
                _errorMessage = "Có lỗi xảy ra. Vui lòng thử lại sau.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Có lỗi xảy ra. Vui lòng thử lại sau.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}