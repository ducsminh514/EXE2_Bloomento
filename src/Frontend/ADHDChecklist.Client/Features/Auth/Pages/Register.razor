@page "/register"
@using ADHDChecklist.Client.Features.Auth.Services
@using ADHDChecklist.Client.Shared.Models
@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<Register> Logger

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-50 to-purple-50 px-4">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8">

        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Tạo tài khoản</h1>
            <p class="text-gray-600">Bắt đầu quản lý công việc hiệu quả hơn</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
                <p class="text-sm text-red-600">@_errorMessage</p>
            </div>
        }

        <!-- Register Form -->
        <EditForm Model="@_registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <div class="space-y-4">
                <!-- Full Name -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Họ và tên</label>
                    <InputText @bind-Value="_registerModel.FullName"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                               placeholder="Nguyễn Văn A" />
                    <ValidationMessage For="@(() => _registerModel.FullName)" class="text-red-500 text-sm mt-1" />
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                    <InputText @bind-Value="_registerModel.Email"
                               type="email"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                               placeholder="email@example.com" />
                    <ValidationMessage For="@(() => _registerModel.Email)" class="text-red-500 text-sm mt-1" />
                </div>

                <!-- Password -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Mật khẩu</label>
                    <InputText @bind-Value="_registerModel.Password"
                               type="password"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                               placeholder="••••••••" />
                    <ValidationMessage For="@(() => _registerModel.Password)" class="text-red-500 text-sm mt-1" />
                    <p class="text-xs text-gray-500 mt-1">
                        Mật khẩu phải có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt
                    </p>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Xác nhận mật khẩu</label>
                    <InputText @bind-Value="_registerModel.ConfirmPassword"
                               type="password"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                               placeholder="••••••••" />
                    <ValidationMessage For="@(() => _registerModel.ConfirmPassword)" class="text-red-500 text-sm mt-1" />
                </div>

                <!-- Terms -->
                <div class="flex items-start">
                    <InputCheckbox @bind-Value="_registerModel.AcceptTerms"
                                   class="w-4 h-4 mt-1 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" />
                    <label class="ml-2 text-sm text-gray-700">
                        Tôi đồng ý với <a href="/terms" class="text-indigo-600 hover:text-indigo-500">Điều khoản sử dụng</a> và
                        <a href="/privacy" class="text-indigo-600 hover:text-indigo-500">Chính sách bảo mật</a>
                    </label>
                </div>
                <ValidationMessage For="@(() => _registerModel.AcceptTerms)" class="text-red-500 text-sm" />

                <!-- Submit Button -->
                <button type="submit"
                        disabled="@_isLoading"
                        class="w-full bg-indigo-600 text-white py-3 px-4 rounded-lg font-medium hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                    @if (_isLoading)
                    {
                        <span>Đang đăng ký...</span>
                    }
                    else
                    {
                        <span>Đăng ký</span>
                    }
                </button>
            </div>
        </EditForm>

        <!-- Login Link -->
        <p class="mt-6 text-center text-sm text-gray-600">
            Đã có tài khoản?
            <a href="/login" class="font-medium text-indigo-600 hover:text-indigo-500">Đăng nhập ngay</a>
        </p>
    </div>
</div>

@code {
    private RegisterModel _registerModel = new();
    private bool _isLoading;
    private string? _errorMessage;

    private class RegisterModel
    {
        [Required(ErrorMessage = "Họ tên là bắt buộc")]
        [MaxLength(100, ErrorMessage = "Họ tên không được quá 100 ký tự")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email là bắt buộc")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Mật khẩu là bắt buộc")]
        [MinLength(8, ErrorMessage = "Mật khẩu phải có ít nhất 8 ký tự")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).+$",
            ErrorMessage = "Mật khẩu phải có chữ hoa, chữ thường, số và ký tự đặc biệt")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Xác nhận mật khẩu là bắt buộc")]
        [Compare(nameof(Password), ErrorMessage = "Mật khẩu không khớp")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [Range(typeof(bool), "true", "true", ErrorMessage = "Bạn phải đồng ý với điều khoản sử dụng")]
        public bool AcceptTerms { get; set; }
    }

    private async Task HandleRegister()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var request = new RegisterRequest(
                _registerModel.Email,
                _registerModel.Password,
                _registerModel.FullName
            );

            var response = await AuthService.RegisterAsync(request);

            if (response.Success)
            {
                Logger.LogInformation("Registration successful");
                Navigation.NavigateTo("/login?registered=true");
            }
            else
            {
                _errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registration error");
            _errorMessage = "Có lỗi xảy ra. Vui lòng thử lại.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}