@page "/settings/family"
@using ADHDChecklist.Client.Features.Family.Services
@inject IFamilyService FamilyService
@using ADHDChecklist.Client.Features.Auth.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Family Settings - Bloomento</PageTitle>

<div class="max-w-3xl mx-auto p-4 sm:p-6 lg:p-8">
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Family Settings</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage your family group, members, and subscription.</p>
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600"></div>
        </div>
    }
    else if (_family == null)
    {
        <!-- No Family State -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="p-8 text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-purple-100 dark:bg-purple-900/30 mb-6">
                    <svg class="h-8 w-8 text-purple-600 dark:text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100">Create or Join a Family</h3>
                <p class="mt-2 text-gray-500 dark:text-gray-400 max-w-md mx-auto">
                    Upgrade to Family Plan to share tasks, habits, and progress with your loved ones. Support each other and achieve goals together.
                </p>
                <div class="mt-8 flex justify-center gap-4">
                    <button @onclick="() => _showCreateModal = true" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-lg transition-colors">
                        Create Family
                    </button>
                    <button @onclick="() => _showJoinModal = true" class="px-4 py-2 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 font-medium rounded-lg transition-colors">
                        Join with Code
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Existing Family State -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden mb-6">
            <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">@_family.Name</h2>
                    <p class="text-sm text-gray-500">Plan: Family Premium</p>
                </div>
                @if (_family.IsOwner)
                {
                    <button @onclick="InviteMember" class="flex items-center gap-2 px-3 py-1.5 text-sm bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300 rounded-lg hover:bg-purple-200 dark:hover:bg-purple-900/50 transition-colors">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Invite Member
                    </button>
                }
            </div>
            
            <div class="p-6">
                <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-4">Members (@_family.Members.Count/5)</h3>
                <div class="space-y-4">
                    @foreach (var member in _family.Members)
                    {
                        <div class="flex items-center justify-between p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors border border-transparent hover:border-gray-200 dark:hover:border-gray-700">
                            <div class="flex items-center gap-3">
                                <div class="h-10 w-10 rounded-full bg-gradient-to-br from-purple-400 to-pink-500 flex items-center justify-center text-white font-bold text-sm">
                                    @(string.IsNullOrEmpty(member.AvatarUrl) ? member.FullName.Substring(0, 1).ToUpper() : "")
                                </div>
                                <div>
                                    <p class="font-medium text-gray-900 dark:text-gray-100">@member.FullName</p>
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs text-gray-500">@member.Role</span>
                                        @if (!string.IsNullOrEmpty(member.Nickname))
                                        {
                                            <span class="text-xs px-1.5 py-0.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">@member.Nickname</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            @if (_family.IsOwner && member.UserId != _family.OwnerId)
                            {
                                <div class="flex items-center gap-1">
                                    @if (member.Role == "Member" || member.Role == "Child")
                                    {
                                        <button @onclick='() => ChangeMemberRole(member, "Admin")' 
                                                class="px-2 py-1 text-[10px] font-bold bg-blue-50 text-blue-600 hover:bg-blue-100 rounded transition-colors"
                                                title="Cấp quyền Quản trị viên">
                                            Làm Admin
                                        </button>
                                    }
                                    @if (member.Role == "Admin")
                                    {
                                         <button @onclick='() => ChangeMemberRole(member, "Member")' 
                                                class="px-2 py-1 text-[10px] font-bold bg-gray-100 text-gray-600 hover:bg-gray-200 rounded transition-colors"
                                                title="Gỡ quyền Quản trị viên">
                                            Gỡ Admin
                                        </button>
                                    }
                                    <button @onclick="() => ConfirmRemoveMember(member)" class="text-gray-400 hover:text-red-600 p-2 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" title="Xóa thành viên">
                                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (_family.IsOwner && _family.PendingInvitations?.Any() == true)
            {
                <div class="p-6 border-t border-gray-100 dark:border-gray-700 bg-gray-50/30 dark:bg-gray-800/20">
                    <h3 class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-4">Pending Invitations</h3>
                    <div class="space-y-3">
                        @foreach (var invite in _family.PendingInvitations)
                        {
                            <div class="flex items-center justify-between p-3 bg-white dark:bg-gray-800 rounded-lg border border-dashed border-gray-200 dark:border-gray-700">
                                <div class="flex flex-col">
                                    <span class="text-sm font-medium text-gray-900 dark:text-gray-100">@invite.Email</span>
                                    <span class="text-[10px] text-gray-500">Sent on @invite.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="text-[10px] font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full uppercase tracking-tighter">Pending</span>
                                    <span class="text-[10px] text-gray-400">Expires @((int)(invite.ExpiresAt - DateTime.UtcNow).TotalDays)d</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Create Family Modal -->
@if (_showCreateModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl w-full max-w-md p-6">
            <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4">Create Family</h3>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Family Name</label>
                <input @bind="_newFamilyName" type="text" placeholder="e.g. Smith Family" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white focus:ring-2 focus:ring-purple-500 outline-none" />
            </div>
            <div class="flex justify-end gap-3">
                <button @onclick="() => _showCreateModal = false" class="px-4 py-2 text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200">Cancel</button>
                <button @onclick="CreateFamily" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 disabled:opacity-50" disabled="@string.IsNullOrWhiteSpace(_newFamilyName)">Create</button>
            </div>
        </div>
    </div>
}

<!-- Join Family Modal -->
@if (_showJoinModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl w-full max-w-md p-6">
            <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4">Join Family</h3>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Invitation Code</label>
                <input @bind="_joinCode" type="text" placeholder="e.g. 123456" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white focus:ring-2 focus:ring-purple-500 outline-none text-center text-lg tracking-widest uppercase" />
            </div>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <p class="text-red-500 text-sm mb-4">@_errorMessage</p>
            }
            <div class="flex justify-end gap-3">
                <button @onclick="() => _showJoinModal = false" class="px-4 py-2 text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-200">Cancel</button>
                <button @onclick="JoinFamily" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 disabled:opacity-50" disabled="@string.IsNullOrWhiteSpace(_joinCode)">Join</button>
            </div>
        </div>
    </div>
}

<!-- Invite Modal -->
@if (_showInviteModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl w-full max-w-md p-6">
            <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4">Invite Member</h3>
            
            @if (_generatedCode != null)
            {
                <div class="text-center py-4">
                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-green-100 mb-4">
                        <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <p class="text-sm font-bold text-gray-900 mb-1">Email Invitations Sent!</p>
                    <p class="text-xs text-gray-500 mb-4">We've sent an invitation to <strong>@_inviteEmail</strong>.</p>
                    
                    <div class="bg-gray-50 p-3 rounded-lg border border-gray-100">
                        <p class="text-[10px] text-gray-400 uppercase font-black tracking-widest mb-1">Manual Backup Code</p>
                        <div class="text-2xl font-mono font-bold text-purple-600 tracking-wider">@_generatedCode</div>
                        <p class="text-[9px] text-gray-400 mt-1">Share this if they don't see the email (check Spam).</p>
                    </div>
                </div>
                <div class="flex justify-end gap-3 mt-6">
                     <button @onclick="CloseInviteModal" class="px-6 py-2 bg-purple-600 text-white font-bold rounded-lg hover:bg-purple-700 shadow-md">Done</button>
                </div>
            }
            else
            {
                <div class="mb-4">
                    <label class="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-2">Member Email</label>
                    <input @bind="_inviteEmail" type="email" placeholder="example@email.com" class="w-full px-4 py-2 border border-blue-100 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white focus:ring-4 focus:ring-purple-500/10 focus:border-purple-500 outline-none transition-all" />
                    <p class="text-[11px] text-gray-500 mt-2 bg-blue-50/50 p-2 rounded-lg">🌸 Lời mời kèm mã số tham gia sẽ được gửi tự động đến địa chỉ này.</p>
                </div>
                 <div class="flex justify-end gap-3 pt-2">
                    <button @onclick="() => _showInviteModal = false" class="px-4 py-2 text-gray-500 font-bold hover:text-gray-700">Cancel</button>
                    <button @onclick="GenerateInvite" class="px-6 py-2 bg-purple-600 text-white font-bold rounded-lg hover:bg-purple-700 shadow-lg disabled:opacity-50" disabled="@string.IsNullOrWhiteSpace(_inviteEmail)">Send Invite</button>
                </div>
            }
        </div>
    </div>
}

@code {
    private FamilyResponse? _family;
    private bool _isLoading = true;
    private bool _showCreateModal = false;
    private bool _showJoinModal = false;
    private bool _showInviteModal = false;
    private string _errorMessage = "";

    // Form inputs
    private string _newFamilyName = "";
    private string _joinCode = "";
    private string _inviteEmail = "";
    private string? _generatedCode = null;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user == null || user.SubscriptionTier != "Family")
        {
            Navigation.NavigateTo("/home");
            return;
        }
        await LoadFamily();
    }

    private async Task LoadFamily()
    {
        _isLoading = true;
        try
        {
            _family = await FamilyService.GetFamilyAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateFamily()
    {
        try
        {
            await FamilyService.CreateFamilyAsync(_newFamilyName);
            _showCreateModal = false;
            await LoadFamily();
        }
        catch (Exception ex)
        {
            // Show error toast ideally
            Console.WriteLine(ex.Message);
        }
    }
    
    private async Task JoinFamily()
    {
        _errorMessage = "";
        try
        {
            await FamilyService.JoinFamilyAsync(_joinCode);
            _showJoinModal = false;
            await LoadFamily();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void InviteMember()
    {
        _generatedCode = null;
        _inviteEmail = "";
        _showInviteModal = true;
    }

    private async Task GenerateInvite()
    {
        try
        {
            // We pass "placeholder" email if empty, as backend expects email but code is what matters for now
            var email = string.IsNullOrWhiteSpace(_inviteEmail) ? "manual-share@placeholder.com" : _inviteEmail;
            _generatedCode = await FamilyService.InviteMemberAsync(email);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    
    private void CloseInviteModal()
    {
        _showInviteModal = false;
        _generatedCode = null;
    }

    private async Task ConfirmRemoveMember(FamilyMemberResponse member)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc muốn xóa {member.FullName} khỏi gia đình?\n\nTài khoản của họ sẽ bị hạ cấp về gói Free (hoặc gói cũ của họ).");
        if (confirmed)
        {
            try 
            {
                 if (_family == null) return;
                 await FamilyService.RemoveMemberAsync(_family.Id, member.UserId);
                 await LoadFamily();
                 await JS.InvokeVoidAsync("alert", "Đã xóa thành viên thành công.");
            }
            catch (Exception ex)
            {
                 await JS.InvokeVoidAsync("alert", "Lỗi: " + ex.Message);
            }
        }
    }

    private async Task ChangeMemberRole(FamilyMemberResponse member, string newRole)
    {
        try
        {
            if (_family == null) return;
            await FamilyService.UpdateMemberRoleAsync(_family.Id, member.UserId, newRole);
            await LoadFamily();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Lỗi khi cập nhật vai trò: " + ex.Message);
        }
    }
}
