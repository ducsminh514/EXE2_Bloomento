@using ADHDChecklist.Client.Features.Family.Services
@inject IRewardService RewardService

@if (IsVisible)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden animate-in zoom-in-95 duration-200">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center">
                <h3 class="text-xl font-black text-gray-900 uppercase tracking-tight">🎁 Tạo phần thưởng</h3>
                <button @onclick="Close" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1.5 px-1">Tên phần thưởng</label>
                    <input @bind="_reward.Title" type="text" class="w-full bg-gray-50 border-none rounded-2xl p-3.5 text-sm font-bold focus:ring-2 focus:ring-yellow-400 transition-all" placeholder="Ví dụ: 1 tiếng chơi game" />
                </div>

                <div>
                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1.5 px-1">Mô tả (tùy chọn)</label>
                    <textarea @bind="_reward.Description" class="w-full bg-gray-50 border-none rounded-2xl p-3.5 text-sm font-bold focus:ring-2 focus:ring-yellow-400 transition-all" rows="3" placeholder="Chi tiết phần thưởng..."></textarea>
                </div>

                <div>
                    <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1.5 px-1">Giá trị (Điểm 🪙)</label>
                    <input @bind="_reward.CostPoints" type="number" class="w-full bg-gray-50 border-none rounded-2xl p-3.5 text-sm font-black text-yellow-600 focus:ring-2 focus:ring-yellow-400 transition-all" />
                </div>
            </div>

            <div class="p-6 bg-gray-50 flex gap-3">
                <button @onclick="Close" class="flex-1 px-6 py-3 rounded-2xl text-sm font-bold text-gray-500 hover:bg-gray-100 transition-all">Hủy</button>
                <button @onclick="Save" 
                        disabled="@(string.IsNullOrWhiteSpace(_reward.Title) || _reward.CostPoints <= 0 || _isSaving)"
                        class="flex-1 px-6 py-3 rounded-2xl text-sm font-bold bg-yellow-500 text-white hover:bg-yellow-600 shadow-lg shadow-yellow-200 disabled:opacity-50 transition-all">
                    @(_isSaving ? "Đang lưu..." : "Lưu lại")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private ADHDChecklist.Client.Features.Family.Services.CreateRewardRequest _reward = new();
    private bool _isSaving = false;

    private async Task Save()
    {
        _isSaving = true;
        try
        {
            var result = await RewardService.CreateRewardAsync(_reward);
            if (result != null)
            {
                await OnSaved.InvokeAsync();
                await Close();
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task Close()
    {
        _reward = new ADHDChecklist.Client.Features.Family.Services.CreateRewardRequest();
        await OnClose.InvokeAsync();
    }
}
