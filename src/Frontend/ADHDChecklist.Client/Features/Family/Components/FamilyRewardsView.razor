@using ADHDChecklist.Client.Features.Family.Services
@inject IRewardService RewardService
@inject IJSRuntime JS

<div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden min-h-[100px]">
    <div class="p-6 border-b border-gray-50 flex justify-between items-center bg-gradient-to-r from-yellow-50/50 to-transparent">
        <div>
            <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                <span class="text-2xl">🎁</span> Cửa hàng phần thưởng
            </h3>
            <p class="text-sm text-gray-500 mt-1">Sử dụng điểm 🪙 để đổi lấy những phần quà hấp dẫn!</p>
        </div>
        <div class="text-right">
            <span class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Điểm của bạn</span>
            <div class="text-2xl font-black text-yellow-600">@_userPoints.ToString("N0") <span class="text-sm font-normal">pts</span></div>
        </div>
    </div>

    <div class="p-6">
        @if (_isLoading)
        {
            <div class="flex justify-center py-12">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-yellow-500"></div>
            </div>
        }
        else if (_rewards.Count == 0)
        {
            <div class="text-center py-12 bg-gray-50 rounded-xl border border-dashed border-gray-200">
                <div class="text-4xl mb-3">📭</div>
                <p class="text-gray-500">Chưa có phần thưởng nào được thiết lập.</p>
                @if (IsAdmin)
                {
                    <button @onclick="ShowCreateModal" class="mt-4 text-sm font-bold text-yellow-600 hover:text-yellow-700">
                        + Tạo phần thưởng đầu tiên
                    </button>
                }
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var reward in _rewards)
                {
                    <div class="group relative bg-white border @_getBorderClass(reward) rounded-xl p-4 transition-all hover:shadow-md hover:-translate-y-0.5">
                        <div class="flex justify-between items-start gap-3">
                            <div>
                                <h4 class="font-bold text-gray-900 group-hover:text-yellow-700 transition-colors">@reward.Title</h4>
                                <p class="text-xs text-gray-500 mt-1 line-clamp-2">@reward.Description</p>
                            </div>
                            <div class="bg-yellow-100 text-yellow-700 px-2 py-1 rounded-lg text-xs font-bold whitespace-nowrap">
                                @reward.CostPoints pts
                            </div>
                        </div>

                        <div class="mt-4 flex items-center justify-between">
                            <span class="text-[10px] uppercase font-bold tracking-widest @_getStatusClass(reward)">
                                @(reward.IsAvailable ? "Sẵn sàng" : "Hết hàng")
                            </span>
                            
                            <button @onclick="() => RedeemReward(reward)" 
                                    disabled="@(!reward.IsAvailable || _userPoints < reward.CostPoints || _isProcessing)"
                                    class="px-4 py-1.5 rounded-lg text-xs font-bold transition-all
                                           @(reward.IsAvailable && _userPoints >= reward.CostPoints 
                                             ? "bg-yellow-500 text-white hover:bg-yellow-600 shadow-sm" 
                                             : "bg-gray-100 text-gray-400 cursor-not-allowed")">
                                @_getRedeemButtonText(reward)
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @if (IsAdmin)
    {
        <div class="p-4 bg-gray-50 border-t border-gray-100 flex justify-center">
            <button @onclick="ShowCreateModal" class="flex items-center gap-2 text-sm font-bold text-gray-600 hover:text-primary-600 transition-colors">
                <span class="bg-white w-6 h-6 rounded-full flex items-center justify-center border border-gray-200 shadow-sm">+</span>
                Quản lý phần thưởng
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public EventCallback OnPointsChanged { get; set; }

    private List<RewardResponse> _rewards = new();
    private int _userPoints = 0;
    private bool _isLoading = true;
    private bool _isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _userPoints = await RewardService.GetPointsAsync();
            _rewards = await RewardService.GetRewardsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RedeemReward(RewardResponse reward)
    {
        if (_isProcessing) return;
        
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc muốn đổi {reward.CostPoints} điểm lấy '{reward.Title}' không?");
        if (!confirmed) return;

        _isProcessing = true;
        try
        {
            var success = await RewardService.RedeemRewardAsync(reward.Id);
            if (success)
            {
                await JS.InvokeVoidAsync("alert", "Đổi thưởng thành công! Hãy báo với người thân để nhận quà nhé 🥳");
                await LoadData();
                await OnPointsChanged.InvokeAsync();
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private bool _showCreateModal = false;
    private void ShowCreateModal() => _showCreateModal = true;
    private void CloseCreateModal() => _showCreateModal = false;
    private async Task OnRewardSaved()
    {
        await LoadData();
    }

    private string _getBorderClass(RewardResponse r) => 
        r.IsAvailable && _userPoints >= r.CostPoints ? "border-yellow-200" : "border-gray-100";
        
    private string _getStatusClass(RewardResponse r) => 
        r.IsAvailable ? "text-green-500" : "text-red-400";

    private string _getRedeemButtonText(RewardResponse r)
    {
        if (_isProcessing) return "Đang xử lý...";
        if (!r.IsAvailable) return "Không khả dụng";
        if (_userPoints < r.CostPoints) return "Thiếu điểm";
        return "Đổi quà";
    }
}

<CreateRewardModal IsVisible="_showCreateModal" 
                   OnClose="CloseCreateModal" 
                   OnSaved="OnRewardSaved" />
