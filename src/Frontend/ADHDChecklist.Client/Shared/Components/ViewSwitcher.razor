@using ADHDChecklist.Client.Shared.Models

<div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[50] flex items-center justify-center pointer-events-none">
    <div class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-xl border border-white/20 dark:border-gray-700/50 rounded-2xl shadow-2xl p-1.5 flex items-center gap-1 shadow-primary-500/10 pointer-events-auto">
        <!-- Dashboard Tab -->
        <button @onclick="() => OnViewChanged.InvokeAsync(AppView.Dashboard)"
                class="relative px-4 py-2 flex items-center gap-2 rounded-xl transition-all duration-300 group @(CurrentView == AppView.Dashboard ? "bg-primary-600 text-white shadow-lg shadow-primary-500/30" : "text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700/50 hover:text-gray-900 dark:hover:text-white")">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="text-xs font-black uppercase tracking-wider @(CurrentView == AppView.Dashboard ? "" : "hidden group-hover:block")">Dashboard</span>
            
            @if (CurrentView == AppView.Dashboard)
            {
                <div class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full animate-pulse"></div>
            }
        </button>

        <!-- Divider -->
        <div class="w-px h-6 bg-gray-200 dark:bg-gray-700 mx-1"></div>

        <!-- Analytics Tab -->
        <button @onclick="() => OnViewChanged.InvokeAsync(AppView.Analytics)"
                class="relative px-4 py-2 flex items-center gap-2 rounded-xl transition-all duration-300 group @(CurrentView == AppView.Analytics ? "bg-primary-600 text-white shadow-lg shadow-primary-500/30" : "text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700/50 hover:text-gray-900 dark:hover:text-white")">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span class="text-xs font-black uppercase tracking-wider @(CurrentView == AppView.Analytics ? "" : "hidden group-hover:block")">Bảng thông tin</span>
            
            @if (CurrentView == AppView.Analytics)
            {
                <div class="absolute -top-1 -right-1 w-2 h-2 bg-white rounded-full animate-pulse"></div>
            }
            
            @if (!IsPremium)
            {
                <span class="absolute -top-2 -right-2 bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 text-[8px] font-bold text-gray-400 px-1 rounded uppercase">PRO</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public AppView CurrentView { get; set; }
    [Parameter] public EventCallback<AppView> OnViewChanged { get; set; }
    [Parameter] public bool IsPremium { get; set; }
}
