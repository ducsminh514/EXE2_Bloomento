@inherits LayoutComponentBase
@using ADHDChecklist.Client.Features.Preferences.Services
@implements IDisposable
@inject IPreferencesService PreferencesService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-200">
    @Body
</div>

@code {
    private bool _drawerOpen = false;
    private const string MeasurementId = "G-JWJ68QKLTR"; // Bạn hãy thay bằng ID thật của bạn

    protected override async Task OnInitializedAsync()
    {
        
        // Theo dõi lần load trang đầu tiên
        await TrackPageView();
        await PreferencesService.GetPreferencesAsync();
        // Đăng ký sự kiện chuyển trang
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await TrackPageView();
    }

    private async Task TrackPageView()
    {
        try
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            await JS.InvokeVoidAsync("trackPageLevel", MeasurementId, path);
        }
        catch
        {
            // Tránh làm sập app nếu JS thất bại
        }
    }

    public void Dispose()
    {
        // Hủy đăng ký để tránh rò rỉ bộ nhớ
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}